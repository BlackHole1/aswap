+class TestMenubarExtraHints:
+    """Every hint that tells the user how to get the menu bar names the
+    distribution this install came from: following one that says
+    ``claude-swap[menubar]`` from an aswap install would install upstream."""
+
+    def _installed_as(self, monkeypatch, name):
+        monkeypatch.setattr(
+            distribution, "packages_distributions", lambda: {"claude_swap": [name]}
+        )
+
+    def test_requirement_names_the_distribution(self, monkeypatch):
+        self._installed_as(monkeypatch, "aswap")
+        assert distribution.menubar_requirement() == "aswap[menubar]"
+        self._installed_as(monkeypatch, "claude-swap")
+        assert distribution.menubar_requirement() == "claude-swap[menubar]"
+
+    def test_missing_extra_hint(self, monkeypatch):
+        import importlib.util
+
+        from claude_swap import cli
+
+        monkeypatch.setattr(importlib.util, "find_spec", lambda name: None)
+        for method, command in (
+            ("uv", "uv tool install --force"),
+            ("pipx", "pipx install --force"),
+            (None, "pip install"),
+        ):
+            monkeypatch.setattr(update_check, "_detect_install_method", lambda m=method: m)
+            self._installed_as(monkeypatch, "aswap")
+            hint = cli._menubar_extra_missing()
+            assert f"{command} 'aswap[menubar]'" in hint
+            assert "claude-swap" not in hint
+            self._installed_as(monkeypatch, "claude-swap")
+            assert f"{command} 'claude-swap[menubar]'" in cli._menubar_extra_missing()
+
+    def test_framework_build_remedy(self, monkeypatch):
+        from claude_swap import menubar
+
+        self._installed_as(monkeypatch, "aswap")
+        for method in ("uv", "pipx"):
+            remedy = menubar.framework_build_warning("Python", method, "26.6.2")
+            assert "'aswap[menubar]'" in remedy
+            assert "claude-swap" not in remedy
+        self._installed_as(monkeypatch, "claude-swap")
+        remedy = menubar.framework_build_warning("Python", "uv", "26.6.2")
+        assert "'claude-swap[menubar]'" in remedy
