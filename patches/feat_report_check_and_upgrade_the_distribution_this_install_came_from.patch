diff --git a/tests/test_distribution.py b/tests/test_distribution.py
new file mode 100644
index 0000000000000000000000000000000000000000..41ab0c68c5c2c850bf748c787988ffd37823b2d0
--- /dev/null
+++ b/tests/test_distribution.py
@@ -0,0 +1,117 @@
+"""The code reports, checks, and upgrades the distribution it was installed
+from: upstream ``claude-swap`` or a repackaging such as ``aswap``."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+from claude_swap import distribution, update_check
+
+
+class TestDistributionName:
+    def test_upstream_is_the_default(self, monkeypatch):
+        monkeypatch.setattr(
+            distribution, "packages_distributions", lambda: {"claude_swap": ["claude-swap"]}
+        )
+        assert distribution.distribution_name() == "claude-swap"
+        assert distribution.command_name() == "cswap"
+
+    def test_a_repackaging_owns_the_install(self, monkeypatch):
+        monkeypatch.setattr(
+            distribution, "packages_distributions", lambda: {"claude_swap": ["aswap"]}
+        )
+        assert distribution.distribution_name() == "aswap"
+        assert distribution.command_name() == "aswap"
+
+    def test_repackaging_wins_when_both_metadata_are_present(self, monkeypatch):
+        monkeypatch.setattr(
+            distribution,
+            "packages_distributions",
+            lambda: {"claude_swap": ["claude-swap", "aswap"]},
+        )
+        assert distribution.distribution_name() == "aswap"
+
+    def test_no_metadata_falls_back_to_upstream(self, monkeypatch):
+        monkeypatch.setattr(distribution, "packages_distributions", lambda: {})
+        assert distribution.distribution_name() == "claude-swap"
+        monkeypatch.setattr(
+            distribution, "version", MagicMock(side_effect=distribution.PackageNotFoundError)
+        )
+        assert distribution.distribution_version() == "0.0.0"
+
+
+class TestUpdateCheckFollowsTheDistribution:
+    def _as_aswap(self, monkeypatch, tmp_path):
+        monkeypatch.setattr(update_check, "distribution_name", lambda: "aswap")
+        monkeypatch.setattr(update_check, "command_name", lambda: "aswap")
+        monkeypatch.setattr(update_check, "CACHE_PATH", tmp_path / "update_check.json")
+
+    def test_pypi_url_and_message_name_the_distribution(self, monkeypatch, tmp_path):
+        self._as_aswap(monkeypatch, tmp_path)
+        resp = MagicMock()
+        resp.read.return_value = b'{"info": {"version": "9.9.9"}}'
+        resp.__enter__ = lambda s: s
+        resp.__exit__ = MagicMock(return_value=False)
+        with patch("claude_swap.update_check.urllib.request.urlopen", return_value=resp) as u, \
+             patch("claude_swap.update_check._detect_install_method", return_value="pipx"), \
+             patch("claude_swap.update_check.sys.platform", "linux"):
+            msg = update_check.check_for_update("0.1.0")
+        assert u.call_args[0][0].full_url == "https://pypi.org/pypi/aswap/json"
+        assert msg is not None
+        assert "A newer version of aswap is available (9.9.9)" in msg
+        assert "`aswap upgrade`" in msg
+        assert "claude-swap" not in msg and "cswap" not in msg
+
+    def test_uv_lookup_reads_the_distributions_row(self, monkeypatch, tmp_path):
+        """`uv pip list --outdated` lists every outdated package in the tool's
+        environment; only the row named after this distribution counts, or an
+        aswap install would never see its own release."""
+        self._as_aswap(monkeypatch, tmp_path)
+        rows = [
+            {"name": "claude-swap", "version": "0.29.0", "latest_version": "0.30.0"},
+            {"name": "aswap", "version": "0.1.0", "latest_version": "0.2.0"},
+        ]
+        result = MagicMock(stdout=json.dumps(rows))
+        with patch("claude_swap.update_check.subprocess.run", return_value=result):
+            assert update_check._uv_latest_version("0.1.0", None) == "0.2.0"
+            assert update_check._uv_latest_version("0.1.0", None) != "0.30.0"
+
+    def test_held_back_notice_names_the_distribution(self, monkeypatch, tmp_path):
+        self._as_aswap(monkeypatch, tmp_path)
+        cooldown = update_check._Cooldown("P14D", "uv-receipt.toml", from_env=False)
+        monkeypatch.setattr(update_check, "_uv_cooldown", lambda receipt: cooldown)
+        monkeypatch.setattr(update_check, "_uv_latest_version", lambda cur, cd: "0.2.0")
+        notice = update_check.held_back_release_notice("0.1.0")
+        assert notice is not None
+        assert "aswap 0.2.0 is on PyPI" in notice
+        assert 'uv tool upgrade aswap --exclude-newer "0 days"' in notice
+        assert "uv tool upgrade aswap --exclude-newer P14D" in notice
+        assert "claude-swap" not in notice
+
+    def test_a_repackaging_never_reads_upstreams_cached_version(self, monkeypatch, tmp_path):
+        """Both installs share the cache directory; upstream's cached latest
+        (0.26.0) must not be served to aswap (0.1.0) as an available update."""
+        from claude_swap.cache import write_cache
+
+        self._as_aswap(monkeypatch, tmp_path)
+        write_cache(tmp_path / "update_check.json", "0.26.0")  # upstream's file
+        with patch("claude_swap.update_check.urllib.request.urlopen",
+                   side_effect=OSError("offline")):
+            assert update_check.check_for_update("0.1.0") is None
+        assert (tmp_path / "update_check-aswap.json").exists()
+        assert update_check._cache_path().name == "update_check-aswap.json"
+
+    def test_self_upgrade_targets_the_distribution(self, monkeypatch, tmp_path):
+        self._as_aswap(monkeypatch, tmp_path)
+        with patch("claude_swap.update_check._detect_install_method", return_value="uv"), \
+             patch("claude_swap.update_check.sys.platform", "linux"), \
+             patch("claude_swap.update_check._uv_cooldown", return_value=None), \
+             patch("claude_swap.update_check.subprocess.run") as run, \
+             patch("builtins.print") as printed:
+            run.return_value.returncode = 0
+            run.return_value.stdout = "0.2.0\n"
+            assert update_check.run_self_upgrade("0.1.0") == 0
+        assert run.call_args_list[0][0][0] == ["uv", "tool", "upgrade", "aswap"]
+        # The after-version is read for this distribution, not claude-swap.
+        probe = run.call_args_list[1][0][0]
+        assert "m.version('aswap')" in probe[-1]
+        assert any("aswap upgraded: 0.1.0 -> 0.2.0" in str(c) for c in printed.call_args_list)
