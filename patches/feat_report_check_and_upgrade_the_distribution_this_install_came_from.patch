--- /dev/null
+++ b/src/claude_swap/distribution.py
@@ -0,0 +1,50 @@
+"""Which distribution this code was installed from.
+
+Upstream ships as ``claude-swap`` (commands ``cswap`` and ``claude-swap``).
+A repackaging that carries the same ``claude_swap`` module under another
+distribution name (``aswap``: upstream plus a patch series, command ``aswap``)
+must report ITS version, check PyPI for ITS releases, and upgrade ITSELF, or
+every run nags about the other project's version and ``upgrade`` reinstalls
+the wrong package. The installed metadata answers which one this is.
+"""
+
+from __future__ import annotations
+
+from importlib.metadata import PackageNotFoundError, packages_distributions, version
+
+UPSTREAM_DISTRIBUTION = "claude-swap"
+UPSTREAM_COMMAND = "cswap"
+
+
+def distribution_name() -> str:
+    """The distribution that provides the ``claude_swap`` package."""
+    try:
+        names = list(packages_distributions().get("claude_swap") or [])
+    except Exception:
+        names = []
+    for name in names:
+        if name != UPSTREAM_DISTRIBUTION:
+            return name  # a repackaging owns this install
+    return names[0] if names else UPSTREAM_DISTRIBUTION
+
+
+def distribution_version() -> str:
+    try:
+        return version(distribution_name())
+    except PackageNotFoundError:
+        return "0.0.0"
+
+
+def command_name() -> str:
+    """The command a user types to reach this install: ``cswap`` for upstream,
+    the distribution name for a repackaging (``aswap``)."""
+    name = distribution_name()
+    return UPSTREAM_COMMAND if name == UPSTREAM_DISTRIBUTION else name
+
+
+def menubar_requirement() -> str:
+    """What to hand an installer to get the menu bar: the distribution this
+    install came from, with its ``menubar`` extra. A repackaging built from
+    upstream's metadata carries the same extra, and telling its user to
+    install ``claude-swap[menubar]`` would put the other project in place."""
+    return f"{distribution_name()}[menubar]"
