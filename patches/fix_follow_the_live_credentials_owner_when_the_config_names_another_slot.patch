+class TestStruckBackupHeals:
+    def _strike_slot_1(self, sw):
+        sw._usage_store.record(
+            {"1": FetchRecord(
+                error="invalid_grant",
+                struck_fp=oauth.credential_fingerprint(STALE_BACKUP_1),
+            )},
+            {"1": ("account1@example.com", "")},
+        )
+
+    def test_attributed_live_lineage_resyncs_the_struck_backup(self, switcher):
+        """The struck backup is the consumed predecessor; the oracle proved
+        the live bytes are slot 1's, so they replace it — the strike is
+        bound to the old generation and clears on the next pass."""
+        self._strike_slot_1(switcher)
+        _, _, write = _build(
+            switcher, LIVE_1, {"1": STALE_BACKUP_1, "2": BACKUP_2}, probe=PROFILE_1
+        )
+        assert write.call_args_list == [call("1", "account1@example.com", LIVE_1)]
+
+    def test_unattributed_lineage_is_never_written(self, switcher):
+        self._strike_slot_1(switcher)
+        _, _, write = _build(
+            switcher, LIVE_1, {"1": STALE_BACKUP_1, "2": BACKUP_2}, probe=None
+        )
+        write.assert_not_called()
+
+    def test_sibling_keeps_refreshing_from_its_own_backup(self, switcher):
+        """End to end: slot 1 struck under a stale config. Slot 2 must be
+        fetched as an IDLE account with its own backup (refreshable), not
+        served slot 1's live bytes; slot 1 is fetched with the live bytes as
+        the active account and, once the backup is resynced, is no longer
+        quarantined."""
+        self._strike_slot_1(switcher)
+        healed: dict[str, str] = {"1": STALE_BACKUP_1, "2": BACKUP_2}
+
+        def write_backup(num, email, creds):
+            healed[str(num)] = creds
+
+        fetches = []
+
+        def fetch(num, email, creds, is_active, **kw):
+            fetches.append((num, is_active, creds))
+            return oauth.UsageOutcome({"five_hour": {"pct": 1}})
+
+        with patch.object(switcher, "_read_active_credentials",
+                          return_value=ActiveCredentials(LIVE_1, False, False)), \
+             patch.object(switcher, "_read_credentials", return_value=LIVE_1), \
+             patch.object(switcher, "_read_account_credentials",
+                          side_effect=lambda num, email: healed.get(str(num), "")), \
+             patch.object(switcher, "_write_account_credentials",
+                          side_effect=write_backup), \
+             patch.object(switcher, "_live_session_pids", return_value=[]), \
+             patch("claude_swap.oauth.fetch_oauth_profile", return_value=PROFILE_1), \
+             patch("claude_swap.oauth.try_fetch_usage_for_account", side_effect=fetch):
+            info = switcher._build_accounts_info()
+            entries = switcher._collect_usage_entries(info)
+
+        assert healed["1"] == LIVE_1  # resynced before the collect pass
+        by_num = {n: (a, c) for n, a, c in fetches}
+        assert by_num["2"] == (False, BACKUP_2)
+        assert by_num["1"] == (True, LIVE_1)
+        assert entries["1"].sentinel != USAGE_RELOGIN_REQUIRED
+        assert entries["2"].sentinel is None
+        assert entries["2"].last_good == {"five_hour": {"pct": 1}}
