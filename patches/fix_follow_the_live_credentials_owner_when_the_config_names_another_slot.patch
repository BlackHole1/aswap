index 0000000000000000000000000000000000000000..67696ea41431d99f94e0afa396fdc21b870c18df
--- /dev/null
+++ b/tests/test_live_owner_slot.py
@@ -0,0 +1,317 @@
+"""The active slot follows the live credential's OWNER, not only the config.
+
+``~/.claude.json``'s ``oauthAccount`` is written by every Claude Code that
+shares the config, including a long-lived process that still holds the
+previous account in memory (measured: the Chrome extension's native host,
+started before a ``cswap switch``, rewrote the block 16 seconds after the
+switch). It can therefore name managed slot B while the credential store
+still holds slot A's token. The
+shape measured in the field: A's backup grant (consumed by A's own rotation)
+gets POSTed as an "idle" account -> ``invalid_grant`` -> a false "re-login
+needed"; B is served A's foreign credential and never fetches its own
+backup. Neither account refreshes, and the display blames A.
+"""
+
+import json
+import logging
+import time
+from pathlib import Path
+from unittest.mock import call, patch
+
+import pytest
+
+from claude_swap import oauth
+from claude_swap.credentials import ActiveCredentials
+from claude_swap.json_output import USAGE_RELOGIN_REQUIRED
+from claude_swap.switcher import ClaudeAccountSwitcher
+from claude_swap.usage_store import FetchRecord
+
+
+def _creds(access: str, refresh: str, expires_in_s: float = 3600) -> str:
+    return json.dumps({"claudeAiOauth": {
+        "accessToken": access,
+        "refreshToken": refresh,
+        "expiresAt": int((time.time() + expires_in_s) * 1000),
+    }})
+
+
+# Slot 1's credential as Claude Code rotated it (live store) ...
+LIVE_1 = _creds("at-1-new", "rt-1-new")
+# ... and the consumed predecessor its cswap backup still holds.
+STALE_BACKUP_1 = _creds("at-1-old", "rt-1-old")
+BACKUP_2 = _creds("at-2", "rt-2")
+
+PROFILE_1 = {"uuid": "uuid-1", "email": "account1@example.com", "organizationUuid": None}
+PROFILE_ALIEN = {"uuid": "uuid-alien", "email": "alien@example.com", "organizationUuid": "org-x"}
+
+
+@pytest.fixture
+def stale_config(temp_home: Path) -> Path:
+    """``~/.claude.json`` naming slot 2 while the live store holds slot 1's token."""
+    path = temp_home / ".claude.json"
+    path.write_text(json.dumps({"oauthAccount": {
+        "emailAddress": "account2@example.com", "accountUuid": "uuid-2",
+    }}))
+    return path
+
+
+@pytest.fixture
+def switcher(temp_home: Path, stale_config: Path, sample_sequence_data: dict):
+    sw = ClaudeAccountSwitcher()
+    sw._setup_directories()
+    sw._write_json(sw.sequence_file, sample_sequence_data)
+    return sw
+
+
+def _backups(by_slot: dict[str, str]):
+    return lambda num, email: by_slot.get(str(num), "")
+
+
+def _build(sw, live: str, backups: dict[str, str], probe=None):
+    """Run ``_build_accounts_info`` with the given live/backup stores and
+    oracle answer; returns ``(accounts_info, probe_mock, write_mock)``."""
+    with patch.object(sw, "_read_active_credentials",
+                      return_value=ActiveCredentials(live, False, False)), \
+         patch.object(sw, "_read_credentials", return_value=live), \
+         patch.object(sw, "_read_account_credentials",
+                      side_effect=_backups(backups)), \
+         patch.object(sw, "_write_account_credentials") as write, \
+         patch("claude_swap.oauth.fetch_oauth_profile",
+               return_value=probe) as probe_mock:
+        info = sw._build_accounts_info()
+    return info, probe_mock, write
+
+
+def _active(info):
+    return {str(i[0]): i[4] for i in info}
+
+
+class TestOwnerResolution:
+    def test_config_and_live_agree_is_untouched(self, switcher):
+        """Backup lineage of the config slot matches the live store: no
+        probe, no override, no resync — the pre-existing steady state."""
+        info, probe, write = _build(
+            switcher, BACKUP_2, {"1": STALE_BACKUP_1, "2": BACKUP_2}
+        )
+        assert _active(info) == {"1": False, "2": True}
+        assert switcher._active_slot_override is None
+        probe.assert_not_called()
+        write.assert_not_called()
+
+    def test_stale_config_follows_owner_by_backup_lineage(self, switcher, caplog):
+        """The live lineage is slot 1's backup lineage: slot 1 is active
+        (served the live bytes), slot 2 idle (served its own backup). Found
+        offline — the oracle is never asked."""
+        live = STALE_BACKUP_1  # not yet rotated: same lineage as the backup
+        with caplog.at_level(logging.WARNING, logger="claude-swap"):
+            info, probe, _ = _build(
+                switcher, live, {"1": STALE_BACKUP_1, "2": BACKUP_2}
+            )
+            _build(switcher, live, {"1": STALE_BACKUP_1, "2": BACKUP_2})
+
+        assert _active(info) == {"1": True, "2": False}
+        by_slot = {str(i[0]): i[5] for i in info}
+        assert by_slot["1"] == live
+        assert by_slot["2"] == BACKUP_2
+        assert switcher._active_slot_override == ("1", ("account2@example.com", ""))
+        probe.assert_not_called()
+        warnings = [r for r in caplog.records if "stale config" in r.getMessage()]
+        assert len(warnings) == 1  # once per process, not per pass
+
+    def test_stale_config_follows_owner_by_oracle_and_memoizes(self, switcher):
+        """Rotated past every backup: the oracle attributes the lineage to
+        slot 1, once — the second pass answers from the memo, and the
+        fresh-path resync verdict is pre-seeded for slot 1."""
+        backups = {"1": STALE_BACKUP_1, "2": BACKUP_2}
+        info, probe, _ = _build(switcher, LIVE_1, backups, probe=PROFILE_1)
+        info2, probe2, _ = _build(switcher, LIVE_1, backups, probe=PROFILE_1)
+
+        assert _active(info) == {"1": True, "2": False}
+        assert _active(info2) == {"1": True, "2": False}
+        probe.assert_called_once()
+        probe2.assert_not_called()
+        fp = oauth.credential_fingerprint(LIVE_1)
+        key = switcher._lineage_key("1", "account1@example.com", fp)
+        assert switcher._probe_verdicts.get(key) is True
+
+    def test_oracle_failure_keeps_the_config_slot(self, switcher):
+        """No evidence, no change: an unreachable oracle leaves slot 2
+        active exactly as before, and nothing is cached."""
+        backups = {"1": STALE_BACKUP_1, "2": BACKUP_2}
+        info, probe, _ = _build(switcher, LIVE_1, backups, probe=None)
+        assert _active(info) == {"1": False, "2": True}
+        assert switcher._active_slot_override is None
+        assert switcher._live_owner_cache == {}
+        info2, probe2, _ = _build(switcher, LIVE_1, backups, probe=PROFILE_1)
+        probe2.assert_called_once()  # retried, not poisoned by the failure
+        assert _active(info2) == {"1": True, "2": False}
+
+    def test_alien_lineage_keeps_the_config_slot(self, switcher):
+        """A lineage no managed slot owns is not ours to re-point."""
+        info, probe, _ = _build(
+            switcher, LIVE_1, {"1": STALE_BACKUP_1, "2": BACKUP_2},
+            probe=PROFILE_ALIEN,
+        )
+        assert _active(info) == {"1": False, "2": True}
+        probe.assert_called_once()
+
+    def test_expired_live_token_skips_the_oracle(self, switcher):
+        """An expired access token would only 401 the oracle; fall back."""
+        expired = _creds("at-1-new", "rt-1-new", expires_in_s=-60)
+        info, probe, _ = _build(
+            switcher, expired, {"1": STALE_BACKUP_1, "2": BACKUP_2},
+            probe=PROFILE_1,
+        )
+        assert _active(info) == {"1": False, "2": True}
+        probe.assert_not_called()
+
+
+class TestPersistedVerdicts:
+    """Oracle verdicts outlive the process: ``cswap ls`` is a new process
+    each time and the live token is expired most of the day when the day's
+    work runs through a Claude Code that never touches the credential store
+    (the desktop app passes its own token), so the one fresh pass that could ask
+    the oracle must leave its answer behind for the expired ones."""
+
+    EXPIRED_LIVE_1 = _creds("at-1-new", "rt-1-new", expires_in_s=-60)  # same lineage as LIVE_1
+
+    def test_fresh_pass_persists_and_an_expired_later_process_reuses_it(
+        self, temp_home, stale_config, sample_sequence_data
+    ):
