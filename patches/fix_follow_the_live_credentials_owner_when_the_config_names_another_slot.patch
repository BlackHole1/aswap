+    def _resolve_live_owner_slot(
+        self, data: dict, config_slot: str, live: str
+    ) -> str:
+        """The managed slot that OWNS the live credential.
+
+        ``~/.claude.json``'s ``oauthAccount`` is what names the active slot,
+        but every Claude Code sharing that config writes it — including a
+        long-lived process that still holds the PREVIOUS account in memory
+        (measured: the Chrome extension's native host, started before a
+        ``cswap switch``, rewrote the block 16 seconds after the switch) or
+        an install that authenticates on its own — so it can name slot B
+        while the credential store still holds slot A's token. Trusting it then costs BOTH slots:
+        A is treated as idle and its backup grant (a generation A's own
+        rotation already consumed) is POSTed → ``invalid_grant`` → a false
+        "re-login needed"; B is served A's foreign credential (429s, the
+        foreign sentinel) and never fetches from its own backup. Neither
+        account refreshes, and the display blames A.
+
+        So attribute the live bytes instead of trusting the label: by
+        refresh-lineage fingerprint against every slot backup first (offline,
+        the common case), then by the profile oracle, memoized per lineage.
+        Any doubt — no access token, an expired token the oracle would only
+        401, an unreachable oracle, a lineage no managed slot owns — falls
+        back to the config slot, i.e. exactly the pre-existing behavior.
+        """
+        live_oauth = oauth.extract_oauth_data(live) if live else None
+        if not live_oauth or not live_oauth.get("accessToken"):
+            return config_slot
+        accounts = data.get("accounts", {})
+        fp = oauth.credential_fingerprint(live) or ""
+
+        def _backup_matches(num: str) -> bool:
+            email = accounts.get(num, {}).get("email", "")
+            backup = self._read_account_credentials(num, email)
+            return bool(backup) and (
+                backup == live or oauth.credential_fingerprint(backup) == fp
+            )
+
+        if _backup_matches(config_slot):
+            return config_slot
+        owner: str | None = None
+        for num in data.get("sequence", []):
+            if str(num) != config_slot and _backup_matches(str(num)):
+                owner = str(num)
+                break
+        if owner is None:
+            owner = self._probe_live_owner(
+                data, live, fp,
+                expired=oauth.is_oauth_token_expired(live_oauth.get("expiresAt")),
+            )
+        if owner is None or owner == config_slot:
+            return config_slot
+        config_email = accounts.get(config_slot, {}).get("email", "")
+        key = (config_slot, config_email, "stale-config")
+        if key not in self._provenance_warned:
+            self._provenance_warned.add(key)
+            self._logger.warning(
+                "~/.claude.json names Account-%s but the live credential "
+                "belongs to Account-%s; treating Account-%s as active "
+                "(stale config, e.g. rewritten by a long-running Claude "
+                "Code that still holds the previous account).",
+                config_slot, owner, owner,
+            )
+        return owner
+
+    def _probe_live_owner(
+        self, data: dict, live: str, fp: str, *, expired: bool
+    ) -> str | None:
+        """Which managed slot owns the live lineage ``fp``, or None.
+
+        Answered from this process's memo, then from the verdicts earlier
+        passes persisted (``cache/lineage_owners.json``), and only then by
+        the profile oracle — which needs a fresh access token, so an
+        ``expired`` one is never sent (it would only 401). Persisting is
+        what makes the answer survive the process: ``cswap ls`` is a new
+        process every time, and Claude Code refreshes the live token only
+        when it is used, so the token spends most of its life expired on a
+        machine where the day's work runs through a Claude Code that does
+        not touch the credential store (the desktop app passes its own
+        token in the environment). A verdict
+        recorded while the token was fresh keeps attributing the lineage
+        until it rotates (the refresh-token hash IS the lineage), and then
+        the next fresh pass records the successor.
+
+        Affirmative answers are also fed into ``_probe_verdicts`` for the
+        owner slot, which licenses the locked refresh path to POST the live
+        grant and the fresh-path resync to adopt it without a second probe.
+        Failures and unverifiable results are never cached. Must not be
+        called under any lock (network).
+        """
+        cached = self._live_owner_cache.get(fp)
+        if cached is not None:
+            return cached
+        owner = self._persisted_lineage_owner(data, fp)
+        if owner is None:
+            if expired:
+                return None
+            resolved = oauth.fetch_oauth_profile(
+                oauth.extract_access_token(live) or ""
+            )
+            if resolved is None:
+                return None
+            for num in data.get("sequence", []):
+                if self._resolved_matches_slot_identity(str(num), resolved) is True:
+                    owner = str(num)
+                    break
+            if owner is None:
+                return None
+            self._remember_lineage_owner(fp, self.account_identity(owner))
+        email = data.get("accounts", {}).get(owner, {}).get("email", "")
+        self._probe_verdicts[self._lineage_key(owner, email, fp)] = True
+        self._live_owner_cache[fp] = owner
+        return owner
+
+    _LINEAGE_OWNERS_MAX = 32
+
+    def _lineage_owners_path(self) -> Path:
+        return self.backup_dir / "cache" / "lineage_owners.json"
+
+    def _persisted_lineage_owner(self, data: dict, fp: str) -> str | None:
+        """Slot an earlier pass attributed lineage ``fp`` to, re-resolved
+        against the CURRENT slot table: the record stores the account
+        identity, never a slot number, so a slot re-created for another
+        account (uuid conflict) or a removed account yields None."""
+        if not fp:
+            return None
+        try:
+            stored = self._read_json(self._lineage_owners_path()) or {}
+        except Exception:
+            return None
+        lineages = stored.get("lineages")
+        record = lineages.get(fp) if isinstance(lineages, dict) else None
+        if not isinstance(record, dict):
+            return None
+        email = record.get("email") or ""
+        org_uuid = record.get("organizationUuid") or ""
+        slot = self._find_account_slot(data, email, org_uuid)
+        if slot is None:
+            return None
+        recorded_uuid = (record.get("uuid") or "").strip()
+        own_uuid = (data.get("accounts", {}).get(slot, {}).get("uuid") or "").strip()
+        if recorded_uuid and own_uuid and recorded_uuid != own_uuid:
+            return None
+        return slot
+
+    def _remember_lineage_owner(self, fp: str, identity: dict) -> None:
+        """Persist an affirmative oracle verdict (best effort, never raises).
+        Bounded to the newest ``_LINEAGE_OWNERS_MAX`` lineages."""
+        if not fp:
+            return
+        try:
+            path = self._lineage_owners_path()
+            stored = self._read_json(path) or {}
+            lineages = stored.get("lineages")
+            if not isinstance(lineages, dict):
+                lineages = {}
+            lineages[fp] = {
+                "email": identity.get("email", ""),
+                "organizationUuid": identity.get("organizationUuid", ""),
+                "uuid": identity.get("uuid", ""),
+                "resolvedAt": time.time(),
+            }
+            if len(lineages) > self._LINEAGE_OWNERS_MAX:
+                newest = sorted(
+                    lineages.items(),
+                    key=lambda kv: float((kv[1] or {}).get("resolvedAt") or 0),
+                    reverse=True,
+                )[: self._LINEAGE_OWNERS_MAX]
+                lineages = dict(newest)
+            path.parent.mkdir(parents=True, exist_ok=True)
+            self._write_json(path, {"schemaVersion": 1, "lineages": lineages})
+        except Exception:
+            self._logger.debug(
+                "Could not persist the lineage owner verdict", exc_info=True
+            )
+
+    def _heal_owner_backup(self, data: dict, owner: str, live: str) -> None:
+        """Resync the owner slot's backup to a live lineage the oracle (or
+        one of our own refresh POSTs) already attributed to it.
+
+        Normally the fresh-token fast path does this after a successful
+        usage fetch. A slot whose backup is STRUCK (its consumed generation
+        earned ``invalid_grant`` while the config mislabeled the slot idle)
+        never reaches that path: the strike quarantines it from fetching,
+        so nothing would ever replace the dead backup — "re-login needed"
+        forever, on an account whose live credential is healthy. Healing
+        here, on an attributed lineage only, lets the strike clear on the
+        next pass (``token_dead`` binds to the struck generation). Best
+        effort, never raises; without an attribution it does nothing.
+        """
+        live_oauth = oauth.extract_oauth_data(live) if live else None
+        if not (
+            live_oauth
+            and live_oauth.get("accessToken")
+            and live_oauth.get("refreshToken")
+        ):
+            return
+        account = data.get("accounts", {}).get(owner, {})
+        email = account.get("email", "")
+        org_uuid = account.get("organizationUuid", "") or ""
+        fp = oauth.credential_fingerprint(live) or ""
+        if self._probe_verdicts.get(self._lineage_key(owner, email, fp)) is not True:
+            return
+        self._resync_rotated_backup(owner, email, org_uuid, live)
+
     def _fetch_active_usage(
         self, account_num: str, email: str, creds: str, org_uuid: str = ""
     ) -> FetchRecord:
