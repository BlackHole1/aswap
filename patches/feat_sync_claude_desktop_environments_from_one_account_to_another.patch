index 0000000000000000000000000000000000000000..73a1091a3202d391b31a60f5d713af4839a72fe8
--- /dev/null
+++ b/tests/test_desktop_envs.py
@@ -0,0 +1,748 @@
+"""``cswap desktop --sync-envs``: one account's Code tab environments
+replace another's.
+
+Claude Desktop keeps an account's environments in the profile's
+``localStorage`` (a LevelDB database) under the account's UUID, mirrors
+them in ``ccd-session-presets.json``, keeps SSH connections in
+``ssh_configs.json`` and environment variables, encrypted, in
+``ccd-environment-config.json``. The profiles here are built with the
+LevelDB fixtures of ``test_leveldb.py``.
+"""
+
+from __future__ import annotations
+
+import base64
+import calendar
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+from contextlib import contextmanager
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from claude_swap import cli, desktop, desktop_envs, leveldb
+from claude_swap.desktop import DesktopManager
+from claude_swap.desktop_envs import (
+    ENV_FILE,
+    MIRROR_FILE,
+    SSH_FILE,
+    SafeStorage,
+    leveldb_dir,
+    store_key,
+)
+from claude_swap.exceptions import ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.settings import load_desktop_settings, set_setting, settings_path
+from claude_swap.switcher import ClaudeAccountSwitcher
+from tests.test_leveldb import _batch, build_db
+
+ONE, TWO = "1. account1@example.com", "2. account2@example.com"
+macos_only = pytest.mark.skipif(sys.platform != "darwin", reason="CommonCrypto")
+
+
+def _plain(text: str) -> str:
+    return re.sub(r"\x1b\[[0-9;]*m", "", text)
+
+
+def _store(*names: str, extra: dict | None = None) -> bytes:
+    """A store value the way the renderer writes it: Latin-1 JSON behind
+    the one-byte encoding prefix."""
+    state = {
+        "presets": [{"id": f"id-{n}", "name": n} for n in names],
+        "placeDefaults": {"local::/tmp": {"effort": "high"}},
+        **(extra or {}),
+    }
+    return b"\x01" + json.dumps({"state": state, "version": 4}).encode("latin-1")
+
+
+def _profile(data_dir: Path, stores: dict[str, bytes]) -> Path:
+    """A profile the app has run in, holding ``stores`` by account UUID and
+    one unrelated ``localStorage`` entry."""
+    writes = [(b"_https://claude.ai\x00\x01unrelated", b"\x01kept")]
+    writes += [(store_key(account), value) for account, value in stores.items()]
+    build_db(leveldb_dir(data_dir), batches=[_batch(1, writes)])
+    return data_dir
+
+
+def _entries(data_dir: Path) -> dict[bytes, bytes | None]:
+    return leveldb.read_db(leveldb_dir(data_dir)).entries
+
+
+@pytest.fixture
+def switcher(temp_home, sample_sequence_data):
+    sw = ClaudeAccountSwitcher()
+    sw._setup_directories()
+    sample_sequence_data["sequence"].append(3)
+    sample_sequence_data["accounts"]["3"] = {
+        "email": "account3@example.com", "uuid": "uuid-3",
+        "added": "2024-01-03T00:00:00Z",
+    }
+    sw._write_json(sw.sequence_file, sample_sequence_data)
+    return sw
+
+
+@pytest.fixture
+def stock(tmp_path):
+    """The stock profile's location, signed in as nobody until a test
+    writes its ``config.json``."""
+    path = tmp_path / "Application Support" / "Claude"
+    with patch.object(desktop, "default_user_data_dir", return_value=path):
+        yield path
+
+
+@pytest.fixture
+def manager(switcher, stock, tmp_path):
+    """A manager on macOS with every window closed unless a test says so."""
+    m = DesktopManager(switcher)
+    m.platform = Platform.MACOS
+    m._app = tmp_path / "Claude.app"
+    with patch.object(desktop, "running_pids", return_value=[]), \
+         patch.object(desktop, "stock_instance_running", return_value=False):
+        yield m
+
+
+def _own(manager, number: str) -> Path:
+    return manager.data_dir(number, f"account{number}@example.com")
+
+
+def _sign_stock_in(stock: Path, account_uuid: str) -> None:
+    stock.mkdir(parents=True, exist_ok=True)
+    (stock / "config.json").write_text(json.dumps({"lastKnownAccountUuid": account_uuid}))
+
+
+class TestStore:
+    def test_key_is_chromiums_local_storage_key(self):
+        assert store_key("uuid-1") == (
+            b"_https://claude.ai\x00\x01persisted.ccd-session-presets.uuid-1"
+        )
+
+    def test_the_target_gets_the_sources_value_byte_for_byte(self, manager, capsys):
+        source = _store("OPS", "Leina", extra={"startedPlaces": [{"id": "p"}]})
+        _profile(_own(manager, "1"), {"uuid-1": source})
+        target = _profile(_own(manager, "2"), {"uuid-2": _store("old"), "uuid-9": b"\x01x"})
+
+        assert manager.sync_envs(["2"], source="1") == 0
+
+        assert _entries(target) == {
+            b"_https://claude.ai\x00\x01unrelated": b"\x01kept",
+            store_key("uuid-2"): source,
+            store_key("uuid-9"): b"\x01x",
+        }
+        assert _entries(_own(manager, "1"))[store_key("uuid-1")] == source
+        out = _plain(capsys.readouterr().out)
+        assert f"copying from {ONE} (2 environment(s))" in out
+        assert f"{TWO} synced" in out and "previous state kept under" in out
+
+    def test_a_value_in_another_shape_is_still_copied(self, manager, capsys):
+        _profile(_own(manager, "1"), {"uuid-1": b"\x01not json at all"})
+        target = _profile(_own(manager, "2"), {})
+        assert manager.sync_envs(["2"], source="1") == 0
+        assert _entries(target)[store_key("uuid-2")] == b"\x01not json at all"
+        assert f"copying from {ONE}\n" in _plain(capsys.readouterr().out)
+
+    def test_the_stock_profile_is_the_source_when_signed_in_as_it(self, manager, stock):
+        _sign_stock_in(stock, "uuid-1")
+        _profile(stock, {"uuid-1": _store("from stock")})
+        _profile(_own(manager, "1"), {"uuid-1": _store("stale copy")})
+        target = _profile(_own(manager, "2"), {})
+        assert manager.sync_envs(["2"], source="1") == 0
+        assert _entries(target)[store_key("uuid-2")] == _store("from stock")
+
+    def test_a_stock_profile_signed_in_as_someone_else_is_not_a_source(
