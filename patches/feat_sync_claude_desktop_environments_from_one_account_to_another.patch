+    def test_the_database_lock_is_held_while_the_profile_is_written(self, manager):
+        """A POSIX lock goes when the process closes any descriptor of the
+        file, so nothing between taking it and the write may open ``LOCK``."""
+        _profile(_own(manager, "2"), {"uuid-2": _store("mine")})
+        real_put = leveldb.put
+        seen = []
+
+        def put_while_probed(directory, key, value):
+            probe = subprocess.run(
+                [
+                    sys.executable, "-c",
+                    "import sys\n"
+                    "from pathlib import Path\n"
+                    "from claude_swap import leveldb\n"
+                    "try:\n"
+                    "    with leveldb.locked(Path(sys.argv[1])):\n"
+                    "        print('free')\n"
+                    "except leveldb.LevelDBError:\n"
+                    "    print('held')\n",
+                    str(directory),
+                ],
+                capture_output=True, text=True,
+                env={**os.environ, "PYTHONPATH": os.pathsep.join(sys.path)},
+            )
+            seen.append(probe.stdout.strip())
+            real_put(directory, key, value)
+
+        with patch.object(leveldb, "put", side_effect=put_while_probed):
+            assert manager.sync_envs(["2"], source="1") == 0
+        assert seen == ["held"]
