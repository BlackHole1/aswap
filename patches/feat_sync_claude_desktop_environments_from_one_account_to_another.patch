diff --git a/src/claude_swap/desktop_envs.py b/src/claude_swap/desktop_envs.py
new file mode 100644
index 0000000000000000000000000000000000000000..f7a1f456288fcc19be53b15ec97e28eceb379a0b
--- /dev/null
+++ b/src/claude_swap/desktop_envs.py
@@ -0,0 +1,740 @@
+"""Give one account's Claude Desktop the Code tab environments of another.
+
+An environment (a named folder or SSH target with its model, effort and
+worktree choices) belongs to the account that created it, so a second
+account opens the Code tab with none of them. ``cswap desktop --sync-envs``
+replaces an account's environments with a copy of another account's.
+
+Where Claude Desktop keeps them (read from Claude Desktop 6.6395.0, the
+``app.asar`` main bundle and the ``ion-dist.asar`` renderer bundle):
+
+- The environments themselves are a store the renderer persists in
+  ``localStorage`` for ``https://claude.ai``, under
+  ``persisted.ccd-session-presets.<account uuid>``. Chromium keeps that in
+  the LevelDB database ``<profile>/Local Storage/leveldb``. The value also
+  holds the settings remembered per folder, the built-in "this computer"
+  entry's settings and the recently started places. It names no account, so
+  it is copied whole and never parsed: nothing here depends on its shape.
+- ``<profile>/ccd-session-presets.json`` mirrors the environments for the
+  main process, one bucket per account UUID. The app reads it only for a
+  profile whose ``localStorage`` has no store yet and overwrites it from the
+  store after that, so writing the file alone changes nothing. The account's
+  bucket is copied along so the two agree until the app next writes it.
+- ``<profile>/ssh_configs.json`` holds the SSH connections an SSH
+  environment refers to by id. The source's connections are added to the
+  target's by id (the source wins); a connection only the target has stays,
+  because its existing SSH sessions still point at it.
+- ``<profile>/ccd-environment-config.json`` holds environment variables,
+  encrypted with Electron's ``safeStorage``: ``envVars`` for every local
+  session of the profile, and ``scopedEnvVars`` per environment, keyed by
+  account UUID inside the encrypted value. The first is copied as it is. The
+  second has to be decrypted, moved to the target's account UUID and
+  encrypted again, which needs the key ``safeStorage`` keeps in the login
+  Keychain; macOS asks before handing it over. Only macOS is handled:
+  elsewhere the key is per profile or per desktop keyring.
+
+The database is written with the app closed: a running app holds the
+database lock, keeps its own copy of the store in memory and writes it back.
+Every profile is copied aside before it is touched and put back if a step
+fails.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import shutil
+import time
+import uuid
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from claude_swap import desktop, leveldb, macos_keychain
+from claude_swap.exceptions import AccountNotFoundError, ConfigError, SessionError
+from claude_swap.fsutil import atomic_write_bytes
+from claude_swap.models import Platform
+from claude_swap.printer import accent, dimmed, error, warning
+from claude_swap.session import QUARANTINE_DIRNAME
+
+if TYPE_CHECKING:
+    from claude_swap.desktop import DesktopManager
+
+LEVELDB_PARTS = ("Local Storage", "leveldb")
+STORE_ORIGIN = "https://claude.ai"
+STORE_NAME = "persisted.ccd-session-presets."
+MIRROR_FILE = "ccd-session-presets.json"
+SSH_FILE = "ssh_configs.json"
+ENV_FILE = "ccd-environment-config.json"
+PROFILE_FILES = (MIRROR_FILE, SSH_FILE, ENV_FILE)
+
+# Electron names the Keychain item after the app: "<name> Safe Storage",
+# account "<name>".
+SAFE_STORAGE_SERVICE = "Claude Safe Storage"
+SAFE_STORAGE_ACCOUNT = "Claude"
+# The first read of another app's Keychain item waits on a dialog.
+KEYCHAIN_PROMPT_TIMEOUT_S = 120.0
+
+BACKUPS_KEPT = 3
+SOURCE_READ_ATTEMPTS = 5
+
+
+class EnvVarsUnavailable(Exception):
+    """Environment variables could not be read or re-encrypted; the reason
+    is the message. Never fatal: the environments are still copied."""
+
+
+def leveldb_dir(data_dir: Path) -> Path:
+    return data_dir.joinpath(*LEVELDB_PARTS)
+
+
+def store_key(account_uuid: str) -> bytes:
+    """The LevelDB key of an account's environment store.
+
+    Chromium's ``localStorage`` key is ``_<origin>\\0<key>``, the key
+    prefixed by one byte for its encoding: 1 for Latin-1, which every key
+    made of an ASCII name and a UUID is.
+    """
+    return (
+        b"_" + STORE_ORIGIN.encode("ascii") + b"\x00\x01"
+        + (STORE_NAME + account_uuid).encode("latin-1")
+    )
+
+
+def count_environments(store: bytes) -> int | None:
+    """How many environments a store value holds, for the report only;
+    None when the value does not look the way this release writes it."""
+    try:
+        text = store[1:].decode("utf-16-le" if store[:1] == b"\x00" else "latin-1")
+        presets = json.loads(text)["state"]["presets"]
+    except (ValueError, KeyError, TypeError):
+        return None
+    return len(presets) if isinstance(presets, list) else None
+
+
+def _read_json(path: Path) -> dict | None:
+    """The JSON object in ``path``; None when it is missing or not one."""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return data if isinstance(data, dict) else None
+
+
+def _write_json(path: Path, data: dict) -> None:
+    atomic_write_bytes(path, json.dumps(data, indent="\t").encode("utf-8"))
+
+
+# -- safeStorage ---------------------------------------------------------------
+
+
+def _aes_128_cbc(key: bytes, data: bytes, *, encrypt: bool) -> bytes:
+    """AES-128-CBC with PKCS#7 padding through CommonCrypto, which every
+    macOS ships; the standard library has no AES."""
+    import ctypes
+
+    lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
+    lib.CCCrypt.restype = ctypes.c_int32
+    out = ctypes.create_string_buffer(len(data) + 16)
+    moved = ctypes.c_size_t(0)
+    status = lib.CCCrypt(
+        ctypes.c_uint32(0 if encrypt else 1),  # kCCEncrypt / kCCDecrypt
+        ctypes.c_uint32(0),                    # kCCAlgorithmAES
+        ctypes.c_uint32(1),                    # kCCOptionPKCS7Padding
+        ctypes.c_char_p(key), ctypes.c_size_t(len(key)),
+        ctypes.c_char_p(b" " * 16),
+        ctypes.c_char_p(data), ctypes.c_size_t(len(data)),
+        out, ctypes.c_size_t(len(out)),
+        ctypes.byref(moved),
+    )
+    if status != 0:
+        raise EnvVarsUnavailable(
+            "the stored value does not decrypt with the Keychain's key"
+            if not encrypt else f"encryption failed (CommonCrypto status {status})"
+        )
+    return out.raw[:moved.value]
+
+
+@dataclass
+class SafeStorage:
+    """Electron's ``safeStorage`` for Claude Desktop on macOS.
+
+    Chromium's ``OSCrypt`` there: the Keychain holds a password, the AES-128
+    key is PBKDF2-HMAC-SHA1 of it (salt ``saltysalt``, 1003 rounds), the IV
+    is sixteen spaces and the ciphertext carries a ``v10`` prefix. The
+    Keychain item belongs to the app, not to a profile, so every profile on
+    the machine encrypts with the same key.
+    """
+
+    platform: Platform
+    _key: bytes | None = field(default=None, repr=False)
+
+    def key(self) -> bytes:
+        if self._key is not None:
+            return self._key
+        if self.platform != Platform.MACOS:
+            raise EnvVarsUnavailable(
+                "they are encrypted with a key this platform keeps per profile"
+            )
+        print(dimmed(
+            "  reading Claude's Safe Storage key from the Keychain to copy "
+            "environment variables; macOS may ask for your password"
+        ))
+        try:
+            password = macos_keychain.get_password(
+                SAFE_STORAGE_SERVICE, SAFE_STORAGE_ACCOUNT,
+                timeout=KEYCHAIN_PROMPT_TIMEOUT_S,
+            )
+        except macos_keychain.KeychainError as exc:
+            raise EnvVarsUnavailable(f"the Keychain refused the key ({exc})") from exc
+        if not password:
+            raise EnvVarsUnavailable(
+                f"the Keychain has no '{SAFE_STORAGE_SERVICE}' item"
+            )
+        self._key = hashlib.pbkdf2_hmac(
+            "sha1", password.encode("utf-8"), b"saltysalt", 1003, 16
+        )
+        return self._key
+
+    def decrypt(self, blob: object) -> str:
+        try:
+            raw = base64.b64decode(blob, validate=True) if isinstance(blob, str) else b""
+        except ValueError:
+            raw = b""
+        if not raw.startswith(b"v10"):
+            raise EnvVarsUnavailable("the stored value is not in a known format")
+        try:
+            return _aes_128_cbc(self.key(), raw[3:], encrypt=False).decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise EnvVarsUnavailable(
+                "the stored value does not decrypt with the Keychain's key"
+            ) from exc
+
+    def encrypt(self, text: str) -> str:
+        sealed = _aes_128_cbc(self.key(), text.encode("utf-8"), encrypt=True)
+        return base64.b64encode(b"v10" + sealed).decode("ascii")
+
+    def decrypt_scopes(self, blob: object) -> dict:
+        """The decrypted ``scopedEnvVars``: account UUID to its scopes."""
+        try:
+            scopes = json.loads(self.decrypt(blob))
+        except ValueError as exc:
+            raise EnvVarsUnavailable("the stored value is not JSON") from exc
+        if not isinstance(scopes, dict):
+            raise EnvVarsUnavailable("the stored value is not a JSON object")
+        return scopes
+
+
+# -- reading the source --------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Environments:
+    """One account's environments as read from a profile.
+
+    ``store`` is the ``localStorage`` value, verbatim. ``global_env`` is the
+    profile-wide part of the environment-variable file, still encrypted.
+    ``scoped_env`` is the account's own entry of the per-environment
+    variables, decrypted, or None when it has none or they were not read.
+    """
+
+    store: bytes
+    mirror: dict | None
+    ssh: dict | None
+    global_env: dict
+    scoped_env: dict | None
+    count: int | None
+
+
+def read_environments(
+    data_dir: Path, account_uuid: str, safe_storage: SafeStorage
+) -> tuple[Environments | None, str | None]:
+    """Read an account's environments from the profile at ``data_dir``.
+
+    Returns ``(environments, why)``: the environments, or None when the
+    profile holds no store for the account, and the reason environment
+    variables were left out, or None when they were read (or there are
+    none). The database may belong to a running app, which rewrites its
+    files as it works, so a failed read is tried again.
+
+    Raises:
+        SessionError: the database stayed unreadable, or the profile's SSH
+            connections exist but do not read: copying SSH environments
+            without the connections they name would leave them pointing
+            nowhere.
+    """
+    directory = leveldb_dir(data_dir)
+    for attempt in range(SOURCE_READ_ATTEMPTS):
+        try:
+            store = leveldb.read_db(directory).get(store_key(account_uuid))
+            break
+        except leveldb.LevelDBError as exc:
+            if attempt == SOURCE_READ_ATTEMPTS - 1:
+                raise SessionError(str(exc)) from exc
+            time.sleep(0.3)
+    if store is None:
+        return None, None
+
+    ssh = _read_json(data_dir / SSH_FILE)
+    if ssh is None and (data_dir / SSH_FILE).exists():
+        raise SessionError(
+            f"{data_dir / SSH_FILE} is not readable JSON, so the SSH connections "
+            "its environments use cannot be copied; fix or remove it, then retry"
+        )
+
+    mirror_file = _read_json(data_dir / MIRROR_FILE) or {}
+    buckets = mirror_file.get("byAccount")
+    mirror = buckets.get(account_uuid) if isinstance(buckets, dict) else None
+
+    env_file = _read_json(data_dir / ENV_FILE)
+    global_env: dict = {}
+    scoped_env = None
+    why = None
+    if env_file is None:
+        if (data_dir / ENV_FILE).exists():
+            why = f"{data_dir / ENV_FILE} is not readable JSON"
+    elif "envVars" in env_file or "scopedEnvVars" in env_file:
+        if safe_storage.platform != Platform.MACOS:
+            why = "they are encrypted with a key this platform keeps per profile"
+        else:
+            global_env = {
+                key: env_file[key] for key in ("envVars", "tmpDirOverride")
+                if key in env_file
+            }
+            if "scopedEnvVars" in env_file:
+                try:
+                    entry = safe_storage.decrypt_scopes(
+                        env_file["scopedEnvVars"]
+                    ).get(account_uuid)
+                    scoped_env = entry if isinstance(entry, dict) else None
+                except EnvVarsUnavailable as exc:
+                    why = str(exc)
+    return Environments(
+        store=store,
+        mirror=mirror if isinstance(mirror, dict) else None,
+        ssh=ssh,
+        global_env=global_env,
+        scoped_env=scoped_env,
+        count=count_environments(store),
+    ), why
+
+
+# -- writing a target ----------------------------------------------------------
+
+
+@dataclass
+class _Backup:
+    """A profile's environment state, copied aside before it is replaced."""
+
+    data_dir: Path
+    dest: Path
+    had: dict[str, bool] = field(default_factory=dict)
+
+    def take(self) -> None:
+        """Copy the profile's state aside. ``LOCK`` is left out: the caller
+        holds its lock, and reading the file would open and close a second
+        descriptor of it, which drops a POSIX lock (see
+        ``leveldb.locked``)."""
+        desktop.DesktopManager._mkdir_private(self.dest)
+        shutil.copytree(
+            leveldb_dir(self.data_dir), self.dest / "leveldb",
+            ignore=shutil.ignore_patterns("LOCK"),
+        )
+        for name in PROFILE_FILES:
+            src = self.data_dir / name
+            self.had[name] = src.is_file()
+            if self.had[name]:
+                shutil.copy2(src, self.dest / name)
+
+    def restore(self) -> None:
+        """Put the copied files back, in place. The caller still holds the
+        database's ``LOCK`` file, which is not in the copy and is left as it
+        is: it has no content, Windows will not let an open file be deleted
+        or replaced, and touching it would drop a POSIX lock."""
+        live = leveldb_dir(self.data_dir)
+        saved = {path.name: path for path in (self.dest / "leveldb").iterdir()}
+        for path in live.iterdir():
+            if path.name != "LOCK" and path.name not in saved and path.is_file():
+                path.unlink()
+        for name, path in saved.items():
+            if name != "LOCK" and path.is_file():
+                shutil.copy2(path, live / name)
+        for name, existed in self.had.items():
+            target = self.data_dir / name
+            if existed:
+                shutil.copy2(self.dest / name, target)
+            else:
+                target.unlink(missing_ok=True)
+
+
+def _run_name() -> str:
+    """A backup run's directory name: its time in UTC to the nanosecond, so
+    names sort by age within one second and across a clock change for
+    daylight saving, then a random part so two runs can never share one."""
+    now = time.time_ns()
+    stamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime(now // 10**9))
+    return f"{stamp}.{now % 10**9:09d}Z-{uuid.uuid4().hex[:8]}"
+
+
+def _prune_backups(parent: Path, current: Path) -> None:
+    """Keep ``current`` and the newest runs beside it under ``parent``,
+    ``BACKUPS_KEPT`` in all; the names sort by age (see ``_run_name``)."""
+    try:
+        others = sorted(p for p in parent.iterdir() if p.is_dir() and p != current)
+    except OSError:
+        return
+    for stale in others[:max(0, len(others) - (BACKUPS_KEPT - 1))]:
+        shutil.rmtree(stale, ignore_errors=True)
+
+
+def merge_ssh(target: dict | None, source: dict) -> dict:
+    """``target``'s SSH connections with ``source``'s laid over them by id,
+    and the trusted hosts of both."""
+    target = target or {}
+
+    def entries(data: dict, key: str) -> list:
+        value = data.get(key)
+        return value if isinstance(value, list) else []
+
+    def ident(config: object) -> str | None:
+        """The connection's id; None for anything that is not a string,
+        which is then kept as a connection of its own."""
+        value = config.get("id") if isinstance(config, dict) else None
+        return value if isinstance(value, str) else None
+
+    configs = list(entries(source, "configs"))
+    taken = {ident(c) for c in configs} - {None}
+    configs += [c for c in entries(target, "configs") if ident(c) not in taken]
+    hosts = list(entries(source, "trustedHosts"))
+    hosts += [h for h in entries(target, "trustedHosts") if h not in hosts]
+    return {**target, **source, "configs": configs, "trustedHosts": hosts}
+
+
+def _planned_env_vars(
+    data_dir: Path, account_uuid: str, envs: Environments, safe_storage: SafeStorage
+) -> dict | None:
+    """The profile's environment-variable file with the source's variables
+    in it, or None when it already holds them.
+
+    The profile-wide part replaces the profile's, or is removed when the
+    source has none. The per-environment part replaces this account's entry
+    only; other accounts' entries in the same file stay. The Keychain is
+    only needed when either side has per-environment variables.
+
+    Raises:
+        EnvVarsUnavailable: the profile's own file or stored variables do
+            not read, so rewriting them would drop what is there.
+    """
+    path = data_dir / ENV_FILE
+    current = _read_json(path)
+    if current is None:
+        if path.exists():
+            raise EnvVarsUnavailable(f"{path} is not readable JSON")
+        current = {}
+    updated = {
+        key: value for key, value in current.items()
+        if key not in ("envVars", "tmpDirOverride")
+    }
+    updated.update(envs.global_env)
+    if envs.scoped_env or "scopedEnvVars" in current:
+        scopes = (
+            safe_storage.decrypt_scopes(current["scopedEnvVars"])
+            if "scopedEnvVars" in current else {}
+        )
+        before = scopes.get(account_uuid)
+        if envs.scoped_env:
+            scopes[account_uuid] = envs.scoped_env
+        else:
+            scopes.pop(account_uuid, None)
+        if scopes.get(account_uuid) != before:
+            updated["scopedEnvVars"] = safe_storage.encrypt(
+                json.dumps(scopes, separators=(",", ":"))
+            )
+    return updated if updated != current else None
+
+
+def _planned_files(
+    data_dir: Path, account_uuid: str, envs: Environments,
+    safe_storage: SafeStorage, copy_env_vars: bool,
+) -> tuple[list[tuple[Path, dict]], str | None]:
+    """Every file to write beside the database, with its new content, and
+    the reason environment variables are left alone, if they are.
+
+    Worked out in full before anything is written: this is where a file
+    that does not read is found, and where macOS asks for the Keychain key,
+    so neither can happen with the profile half changed.
+
+    Raises:
+        SessionError: the profile's SSH connections exist but do not read;
+            replacing the file would drop the ones only it has.
+    """
+    files: list[tuple[Path, dict]] = []
+    if envs.mirror is not None:
+        mirror = _read_json(data_dir / MIRROR_FILE) or {}
+        buckets = mirror.get("byAccount")
+        mirror["byAccount"] = {
+            **(buckets if isinstance(buckets, dict) else {}),
+            account_uuid: envs.mirror,
+        }
+        files.append((data_dir / MIRROR_FILE, mirror))
+    if envs.ssh is not None:
+        path = data_dir / SSH_FILE
+        current = _read_json(path)
+        if current is None and path.exists():
+            raise SessionError(
+                f"{path} is not readable JSON; fix or remove it, then retry. "
+                "Nothing was changed"
+            )
+        files.append((path, merge_ssh(current, envs.ssh)))
+    why = None
+    if copy_env_vars:
+        try:
+            planned = _planned_env_vars(data_dir, account_uuid, envs, safe_storage)
+        except EnvVarsUnavailable as exc:
+            why = str(exc)
+        else:
+            if planned is not None:
+                files.append((data_dir / ENV_FILE, planned))
+    return files, why
+
+
+def replace_environments(
+    data_dir: Path, account_uuid: str, envs: Environments,
+    backup_root: Path, safe_storage: SafeStorage, *,
+    copy_env_vars: bool, stock: bool = False,
+) -> tuple[Path, str | None]:
+    """Replace the account's environments in the profile at ``data_dir``.
+
+    The caller has checked that no app uses the profile; the database lock
+    is taken as well, so one that is missed still refuses the write.
+    ``stock`` says the profile is the stock one, which belongs to whoever
+    signed in to it last: that is checked again under the lock, since the
+    app may have run as another account since the caller looked. Returns
+    where the profile's previous state was copied, and the reason its
+    environment variables were left alone, if they were.
+
+    Raises:
+        SessionError: a step failed. The profile is put back as it was, or
+            the message says where its previous state is.
+    """
+    backup = _Backup(data_dir, backup_root / _run_name())
+    directory = leveldb_dir(data_dir)
+    try:
+        with leveldb.locked(directory):
+            if stock and desktop.stock_account_uuid(data_dir) != account_uuid:
+                raise SessionError(
+                    "the stock profile is no longer signed in as this account; "
+                    "nothing was changed"
+                )
+            files, why = _planned_files(
+                data_dir, account_uuid, envs, safe_storage, copy_env_vars
+            )
+            backup.take()
+            try:
+                leveldb.put(directory, store_key(account_uuid), envs.store)
+                for path, content in files:
+                    _write_json(path, content)
+            except BaseException as exc:
+                # Ctrl+C included: a profile is never left half written.
+                expected = isinstance(exc, (leveldb.LevelDBError, OSError))
+                try:
+                    backup.restore()
+                except OSError as undo:
+                    stranded = (
+                        f"putting the profile back failed ({undo}). Its "
+                        f"previous state is under {backup.dest}"
+                    )
+                    if expected:
+                        raise SessionError(f"{exc}; {stranded}") from exc
+                    error(f"  {data_dir}: {stranded}")
+                    raise exc
+                shutil.rmtree(backup.dest, ignore_errors=True)
+                if expected:
+                    raise SessionError(
+                        f"{exc}; the profile was put back as it was"
+                    ) from exc
+                raise
+    except (leveldb.LevelDBError, OSError) as exc:
+        shutil.rmtree(backup.dest, ignore_errors=True)
+        raise SessionError(f"{exc}; nothing was changed") from exc
+    _prune_backups(backup_root, backup.dest)
+    return backup.dest, why
+
+
+# -- the command ---------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Home:
+    """A profile an account is signed in to: the stock one or its own."""
+
+    data_dir: Path
+    stock: bool
+
+
+def account_homes(manager: DesktopManager, number: str, email: str) -> list[Home]:
+    """The profiles that hold the account's environments, the stock profile
+    first: the one Claude Desktop uses when opened normally, when it is
+    signed in as this account, then the account's own ``cswap desktop``
+    profile. Only profiles the app has run in (they have the database)."""
+    homes = []
+    account_uuid = manager._account_uuid(number)
+    stock = desktop.default_user_data_dir(manager.platform)
+    if (
+        account_uuid
+        and desktop.stock_account_uuid(stock) == account_uuid
+        and (leveldb_dir(stock) / "CURRENT").is_file()
+    ):
+        homes.append(Home(stock, True))
+    own = manager.data_dir(number, email)
+    if (leveldb_dir(own) / "CURRENT").is_file():
+        homes.append(Home(own, False))
+    return homes
+
+
+def _open_reason(manager: DesktopManager, home: Home, number: str) -> str | None:
+    """Why the profile cannot be written right now, or None."""
+    if home.stock:
+        try:
+            running = desktop.stock_instance_running(manager.app(), manager.platform)
+        except ConfigError:
+            running = False  # no app found: the database lock still decides
+        if running:
+            return (
+                "Claude Desktop is open on the stock profile, which is signed "
+                "in as this account; quit it first"
+            )
+        return None
+    pids = desktop.running_pids(home.data_dir, manager.platform)
+    if pids:
+        return (
+            f"Claude Desktop open (PID {', '.join(map(str, pids))}); close it "
+            f"first ('cswap desktop --quit {number}')"
+        )
+    return None
+
+
+def _resolve_source(manager: DesktopManager, source: str | None) -> tuple[str, str]:
+    from claude_swap.settings import load_desktop_settings
+
+    if source is not None and not source.strip():
+        raise ConfigError("--from needs an account: a number, alias or email")
+    configured = load_desktop_settings(manager.switcher.backup_dir).env_source
+    ident = source if source is not None else configured
+    if not ident:
+        raise ConfigError(
+            "no account to copy environments from; pass --from <num|email>, or "
+            "set one with 'cswap config set desktop.envSource <num|email>'"
+        )
+    try:
+        number, email, _ = manager.switcher.resolve_account(ident)
+    except AccountNotFoundError as exc:
+        where = "--from" if source is not None else "desktop.envSource"
+        raise ConfigError(f"{where} {ident}: account not found") from exc
+    return number, email
+
+
+def sync(
+    manager: DesktopManager,
+    identifiers: list[str],
+    all_accounts: bool,
+    source: str | None,
+) -> int:
+    """Replace the given accounts' environments with the source account's.
+
+    The source is ``source`` or the ``desktop.envSource`` setting. Each
+    target must have every window of its account closed; an account that
+    never opened Claude Desktop is skipped with a note. Returns 1 when any
+    requested account, or any account's environment variables, could not be
+    synced.
+
+    Raises:
+        ConfigError: no usable source account.
+        SessionError: the source account has no environments to copy.
+    """
+    src_number, src_email = _resolve_source(manager, source)
+    src_label = f"{src_number}. {src_email}"
+    src_uuid = manager._account_uuid(src_number)
+    safe_storage = SafeStorage(manager.platform)
+    envs = env_why = None
+    for home in account_homes(manager, src_number, src_email):
+        envs, env_why = read_environments(home.data_dir, src_uuid, safe_storage)
+        if envs is not None:
+            break
+    if envs is None:
+        raise SessionError(
+            f"account {src_label} has no environments on this machine yet; "
+            "open its Claude Desktop window once, then retry"
+        )
+    count = "" if envs.count is None else f" ({envs.count} environment(s))"
+    print(f"  copying from {src_label}{count}")
+    failed = False
+    if env_why:
+        warning(f"  environment variables are not copied: {env_why}")
+        failed = True
+
+    backup_base = manager.switcher.backup_dir / QUARANTINE_DIRNAME
+    for target in manager._targets(identifiers, all_accounts):
+        if target is None:
+            failed = True
+            continue
+        number, email = target
+        label = f"{number}. {email}"
+        if number == src_number:
+            if not all_accounts:
+                error(f"  {label}: is the account being copied from")
+                failed = True
+            continue
+        account_uuid = manager._account_uuid(number)
+        if not account_uuid:
+            error(f"  {label}: no account UUID stored; run 'cswap add' for it again")
+            failed = True
+            continue
+        homes = account_homes(manager, number, email)
+        if not homes:
+            print(f"  {label} {dimmed('never opened, nothing to sync')}")
+            continue
+        blocked = next(
+            (why for home in homes if (why := _open_reason(manager, home, number))),
+            None,
+        )
+        if blocked:
+            error(f"  {label}: {blocked}")
+            failed = True
+            continue
+        kept, notes, broke = [], [], None
+        for home in homes:
+            name = "stock" if home.stock else home.data_dir.name
+            where = "the stock profile" if home.stock else f"profile {name}"
+            try:
+                dest, why = replace_environments(
+                    home.data_dir, account_uuid, envs,
+                    backup_base / f"desktop-envs-{name}", safe_storage,
+                    copy_env_vars=(
+                        env_why is None and manager.platform == Platform.MACOS
+                    ),
+                    stock=home.stock,
+                )
+            except SessionError as exc:
+                broke = f"{where}: {exc}"
+                break
+            kept.append((where, dest))
+            if why:
+                notes.append(why)
+        if broke:
+            error(f"  {label}: {broke}")
+            failed = True
+            for where, dest in kept:
+                warning(
+                    f"     {where} was already synced; its previous state is "
+                    f"kept under {dest}"
+                )
+        else:
+            print(f"  {label} {accent('synced')}")
+            for _, dest in kept:
+                print(dimmed(f"     previous state kept under {dest}"))
+        for why in notes:
+            warning(f"     its environment variables were left as they were: {why}")
+            failed = True
+    return 1 if failed else 0
