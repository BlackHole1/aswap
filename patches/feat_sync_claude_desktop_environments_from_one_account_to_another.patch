+            tmp_path / "db",
+            tables={5: _table([(1, b"k", b"compacted away")]), 9: _table([(2, b"k", b"kept")])},
+            batches=[], extra_edits=[dropped],
+        )
+        (db / "000005.ldb").unlink()
+        assert leveldb.read_db(db).entries == {b"k": b"kept"}
+
+    def test_a_log_older_than_the_manifests_is_ignored(self, tmp_path):
