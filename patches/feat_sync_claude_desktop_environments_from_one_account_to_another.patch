@@ -0,0 +1,565 @@
+"""Read a LevelDB database and add one entry to it, without a dependency.
+
+Chromium keeps a profile's ``localStorage`` in a LevelDB database, and
+Claude Desktop keeps the Code tab's environments there (see
+``desktop_envs.py``). Python has no LevelDB in its standard library and the
+bindings need a native build, so this module implements the two things that
+feature needs and nothing more:
+
+- :func:`read_db` returns the newest value of every key. It reads the
+  ``MANIFEST`` for the live table files, every table (``.ldb``, blocks
+  optionally Snappy-compressed) and the write-ahead log, and keeps the entry
+  with the highest sequence number per key, the rule LevelDB itself applies.
+- :func:`put` appends one write to the live write-ahead log. LevelDB replays
+  that log the next time it opens the database, so the entry is as durable as
+  one LevelDB wrote itself. No table and no ``MANIFEST`` is ever rewritten.
+
+Neither may run while another process has the database open for writing:
+that process keeps its own copy of recent writes in memory and its own idea
+of the next sequence number. :func:`locked` takes the same advisory lock
+LevelDB takes on its ``LOCK`` file, so an open database refuses the write.
+
+The formats are the ones in LevelDB's ``doc/log_format.md``,
+``doc/table_format.md`` and ``db/version_edit.cc``; they have not changed
+since LevelDB 1.0.
+"""
+
+from __future__ import annotations
+
+import os
+import struct
+import sys
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterator
+
+BLOCK_SIZE = 32768
+_HEADER_SIZE = 7  # checksum (4), length (2), type (1)
+_FULL, _FIRST, _MIDDLE, _LAST = 1, 2, 3, 4
+_TABLE_MAGIC = 0xDB4775248B80FB57
+_FOOTER_SIZE = 48
+_PUT, _DELETE = 1, 0
+
+
+class LevelDBError(Exception):
+    """The database could not be read or written as LevelDB."""
+
+
+def _crc_table() -> tuple[int, ...]:
+    table = []
+    for n in range(256):
+        c = n
+        for _ in range(8):
+            c = (c >> 1) ^ 0x82F63B78 if c & 1 else c >> 1
+        table.append(c)
+    return tuple(table)
+
+
+_CRC_TABLE = _crc_table()
+
+
+def crc32c(data: bytes) -> int:
+    """CRC-32C (Castagnoli), the checksum LevelDB uses throughout."""
+    crc = 0xFFFFFFFF
+    for byte in data:
+        crc = _CRC_TABLE[(crc ^ byte) & 0xFF] ^ (crc >> 8)
+    return crc ^ 0xFFFFFFFF
+
+
+def _masked(crc: int) -> int:
+    """LevelDB stores checksums rotated and offset, so a checksum of data
+    that itself embeds checksums stays well distributed."""
+    return (((crc >> 15) | (crc << 17)) + 0xA282EAD8) & 0xFFFFFFFF
+
+
+def _varint(buf: bytes, pos: int) -> tuple[int, int]:
+    shift = result = 0
+    while True:
+        byte = buf[pos]
+        pos += 1
+        result |= (byte & 0x7F) << shift
+        if not byte & 0x80:
+            return result, pos
+        shift += 7
+        if shift > 63:
+            raise ValueError("varint too long")
+
+
+def encode_varint(value: int) -> bytes:
+    out = bytearray()
+    while value >= 0x80:
+        out.append((value & 0x7F) | 0x80)
+        value >>= 7
+    out.append(value)
+    return bytes(out)
+
+
+# -- log format (write-ahead log and MANIFEST) --------------------------------
+
+
+def _scan_log(data: bytes) -> tuple[list[bytes], int, bool]:
+    """The logical records of a log-format file, the offset where the last
+    intact physical record ends, and whether anything in it was damaged.
+
+    A record that fails its checksum or runs past its block drops the rest
+    of that block, as LevelDB's reader does: a write torn by a crash costs
+    its own block and nothing after it. Zero bytes are padding, not damage.
+    A record whose first pieces never reach a last one is, whatever cuts it
+    short, and so is a middle or last piece with nothing before it.
+    """
+    records: list[bytes] = []
+    pending: bytearray | None = None
+    pos = clean_end = 0
+    size = len(data)
+    damaged = False
+    while pos < size:
+        left = BLOCK_SIZE - pos % BLOCK_SIZE
+        if left < _HEADER_SIZE or pos + _HEADER_SIZE > size:
+            damaged = damaged or any(data[pos:pos + left])
+            pos += left
+            continue
+        checksum, length, kind = struct.unpack_from("<IHB", data, pos)
+        start = pos + _HEADER_SIZE
+        end = start + length
+        intact = (
+            kind in (_FULL, _FIRST, _MIDDLE, _LAST)
+            and length <= left - _HEADER_SIZE
+            and end <= size
+            and _masked(crc32c(data[pos + 6:end])) == checksum
+        )
+        if not intact:
+            damaged = damaged or pending is not None or any(data[pos:pos + _HEADER_SIZE])
+            pos += left
+            pending = None
+            continue
+        payload = data[start:end]
+        pos = clean_end = end
+        if kind in (_FULL, _FIRST):
+            damaged = damaged or pending is not None  # the one before never ended
+            pending = None
+            if kind == _FULL:
+                records.append(payload)
+            else:
+                pending = bytearray(payload)
+        elif pending is not None:
+            pending += payload
+            if kind == _LAST:
+                records.append(bytes(pending))
+                pending = None
+        else:
+            damaged = True  # a middle or last piece with nothing before it
+    return records, clean_end, damaged or pending is not None
+
+
+def log_records(data: bytes, *, strict: bool = False) -> list[bytes]:
+    """The logical records of a log-format file, in order.
+
+    A write-ahead log is read leniently: its tail may be a write a crash
+    cut short. ``strict`` is for the MANIFEST, where a dropped record would
+    silently bring back an older set of tables; LevelDB refuses to open a
+    database whose MANIFEST is damaged, and so does this.
+
+    Raises:
+        ValueError: ``strict``, and a record is damaged.
+    """
+    records, _, damaged = _scan_log(data)
+    if strict and damaged:
+        raise ValueError("a record fails its checksum or is cut short")
+    return records
+
+
+def encode_log_records(payload: bytes, offset: int) -> bytes:
+    """``payload`` as physical records for a log whose next byte is
+    ``offset``: split at block boundaries, each piece with its own header."""
+    out = bytearray()
+    pos = offset
+    first = True
+    while True:
+        left = BLOCK_SIZE - pos % BLOCK_SIZE
+        if left < _HEADER_SIZE:
+            out += b"\x00" * left
+            pos += left
+            continue
+        piece, payload = payload[:left - _HEADER_SIZE], payload[left - _HEADER_SIZE:]
+        last = not payload
+        if first:
+            kind = _FULL if last else _FIRST
+        else:
+            kind = _LAST if last else _MIDDLE
+        checksum = _masked(crc32c(bytes([kind]) + piece))
+        out += struct.pack("<IHB", checksum, len(piece), kind) + piece
+        pos += _HEADER_SIZE + len(piece)
+        first = False
+        if last:
+            return bytes(out)
+
+
+def encode_put(sequence: int, key: bytes, value: bytes) -> bytes:
+    """A write batch holding one put, as the write-ahead log stores it."""
+    return (
+        struct.pack("<QI", sequence, 1)
+        + bytes([_PUT])
+        + encode_varint(len(key)) + key
+        + encode_varint(len(value)) + value
+    )
+
+
+def _batch_entries(record: bytes) -> Iterator[tuple[int, bytes, bytes | None]]:
+    sequence, count = struct.unpack_from("<QI", record, 0)
+    pos = 12
+    for i in range(count):
+        tag = record[pos]
+        pos += 1
+        length, pos = _varint(record, pos)
+        key = record[pos:pos + length]
+        pos += length
+        if tag == _PUT:
+            length, pos = _varint(record, pos)
+            yield sequence + i, key, record[pos:pos + length]
+            pos += length
+        elif tag == _DELETE:
+            yield sequence + i, key, None
+        else:
+            raise ValueError(f"unknown write batch tag {tag}")
+
+
+# -- table format --------------------------------------------------------------
+
+
+def snappy_decompress(data: bytes) -> bytes:
+    """Decode one Snappy block (the raw format, no framing)."""
+    size, pos = _varint(data, 0)
+    out = bytearray()
+    end = len(data)
+    while pos < end:
+        tag = data[pos]
+        pos += 1
+        kind = tag & 3
+        if kind == 0:  # literal
+            length = tag >> 2
+            if length >= 60:
+                width = length - 59
+                length = int.from_bytes(data[pos:pos + width], "little")
+                pos += width
+            length += 1
+            if pos + length > end:
+                raise ValueError("snappy literal runs past the input")
+            out += data[pos:pos + length]
+            pos += length
+            continue
+        if kind == 1:
+            length = ((tag >> 2) & 7) + 4
+            offset = ((tag >> 5) << 8) | data[pos]
+            pos += 1
+        else:
+            width = 2 if kind == 2 else 4
+            length = (tag >> 2) + 1
+            offset = int.from_bytes(data[pos:pos + width], "little")
+            pos += width
+        if offset == 0 or offset > len(out):
+            raise ValueError("snappy copy points outside the output")
+        start = len(out) - offset
+        if offset >= length:
+            out += out[start:start + length]
+        else:  # the copy overlaps what it writes: a run
+            for i in range(length):
+                out.append(out[start + i])
+    if len(out) != size:
+        raise ValueError("snappy output has the wrong length")
+    return bytes(out)
+
+
+def _read_block(data: bytes, offset: int, size: int) -> bytes:
+    if offset + size + 5 > len(data):
+        raise ValueError("table block runs past the file")
+    raw = data[offset:offset + size]
+    compression = data[offset + size]
+    (checksum,) = struct.unpack_from("<I", data, offset + size + 1)
+    if _masked(crc32c(data[offset:offset + size + 1])) != checksum:
+        raise ValueError("table block fails its checksum")
+    if compression == 0:
+        return raw
+    if compression == 1:
+        return snappy_decompress(raw)
+    raise ValueError(f"table block uses unsupported compression {compression}")
+
+
+def _block_entries(block: bytes) -> Iterator[tuple[bytes, bytes]]:
+    (restarts,) = struct.unpack_from("<I", block, len(block) - 4)
+    limit = len(block) - 4 - 4 * restarts
+    if limit < 0:
+        raise ValueError("table block has a bad restart array")
+    pos = 0
+    key = b""
+    while pos < limit:
+        shared, pos = _varint(block, pos)
+        unshared, pos = _varint(block, pos)
+        length, pos = _varint(block, pos)
+        key = key[:shared] + block[pos:pos + unshared]
+        pos += unshared
+        yield key, block[pos:pos + length]
+        pos += length
+
+
+def _table_entries(data: bytes) -> Iterator[tuple[int, bytes, bytes | None]]:
+    if len(data) < _FOOTER_SIZE:
+        raise ValueError("table file is shorter than its footer")
+    footer = data[-_FOOTER_SIZE:]
+    if struct.unpack_from("<Q", footer, 40)[0] != _TABLE_MAGIC:
+        raise ValueError("table file has no LevelDB footer")
+    pos = 0
+    _, pos = _varint(footer, pos)  # metaindex block offset
+    _, pos = _varint(footer, pos)  # metaindex block size
+    index_offset, pos = _varint(footer, pos)
+    index_size, pos = _varint(footer, pos)
+    for _, handle in _block_entries(_read_block(data, index_offset, index_size)):
+        offset, at = _varint(handle, 0)
+        size, _ = _varint(handle, at)
+        for internal_key, value in _block_entries(_read_block(data, offset, size)):
+            if len(internal_key) < 8:
+                raise ValueError("table key is shorter than its trailer")
+            (trailer,) = struct.unpack_from("<Q", internal_key, len(internal_key) - 8)
+            yield (
+                trailer >> 8,
+                internal_key[:-8],
+                value if trailer & 0xFF == _PUT else None,
+            )
+
+
+# -- MANIFEST -------------------------------------------------------------------
+
+
+@dataclass
+class _Version:
+    log_number: int = 0
+    prev_log_number: int = 0
+    last_sequence: int = 0
+    tables: frozenset[int] = frozenset()
+
+
+def _read_manifest(data: bytes) -> _Version:
+    version = _Version()
+    tables: set[int] = set()
+    try:
+        records = log_records(data, strict=True)
+    except ValueError as exc:
+        raise ValueError(f"the MANIFEST is damaged: {exc}") from exc
+    for record in records:
+        pos = 0
+        while pos < len(record):
+            tag, pos = _varint(record, pos)
+            if tag == 1:  # comparator name
+                length, pos = _varint(record, pos)
+                name = record[pos:pos + length]
+                pos += length
+                if name != b"leveldb.BytewiseComparator":
+                    raise ValueError(f"unsupported key order {name!r}")
+            elif tag == 2:
+                version.log_number, pos = _varint(record, pos)
+            elif tag == 9:
+                version.prev_log_number, pos = _varint(record, pos)
+            elif tag == 3:  # next file number
+                _, pos = _varint(record, pos)
+            elif tag == 4:
+                version.last_sequence, pos = _varint(record, pos)
+            elif tag == 5:  # compaction pointer: level, key
+                _, pos = _varint(record, pos)
+                length, pos = _varint(record, pos)
+                pos += length
+            elif tag == 6:  # deleted file: level, number
+                _, pos = _varint(record, pos)
+                number, pos = _varint(record, pos)
+                tables.discard(number)
+            elif tag == 7:  # new file: level, number, size, smallest, largest
+                _, pos = _varint(record, pos)
+                number, pos = _varint(record, pos)
+                _, pos = _varint(record, pos)
+                for _ in range(2):
+                    length, pos = _varint(record, pos)
+                    pos += length
+                tables.add(number)
+            else:
+                raise ValueError(f"unknown MANIFEST tag {tag}")
+    version.tables = frozenset(tables)
+    return version
+
+
+# -- database -------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Snapshot:
+    """What a database held when it was read.
+
+    ``entries`` maps every key ever seen to its newest value, None for a key
+    whose newest entry is a deletion. ``live_log`` is the write-ahead log
+    the next write belongs in, None when the database has none.
+    """
+
+    entries: dict[bytes, bytes | None]
+    last_sequence: int
+    live_log: Path | None
+
+    def get(self, key: bytes) -> bytes | None:
+        return self.entries.get(key)
+
+
+def _table_path(directory: Path, number: int) -> Path:
+    for suffix in (".ldb", ".sst"):  # .sst is the name before LevelDB 1.14
+        path = directory / f"{number:06d}{suffix}"
+        if path.exists():
+            return path
+    raise FileNotFoundError(f"table {number:06d} is missing from {directory}")
+
+
+def _layout(directory: Path) -> tuple:
+    """What tells one version of the database from the next: which
+    MANIFEST is current, how long it is, and which tables and logs exist.
+    Appending to the live log changes none of these; moving a log into a
+    table changes all three."""
+    current = (directory / "CURRENT").read_text(encoding="ascii").strip()
+    return (
+        current,
+        (directory / current).stat().st_size,
+        frozenset(
+            path.name for path in directory.iterdir()
+            if path.suffix in (".log", ".ldb", ".sst")
+        ),
+    )
+
+
+def read_db(directory: Path) -> Snapshot:
+    """Read every key's newest value from the database in ``directory``.
+
+    Raises:
+        LevelDBError: the directory holds no database, a file in it does
+            not parse, or its files changed during the read. A database
+            another process is writing can fail in each of these ways
+            between two of that process's own file operations (it moves a
+            log into a new table and extends the MANIFEST as it goes);
+            reading again succeeds.
+    """
+    try:
+        before = _layout(directory)
+        current = (directory / "CURRENT").read_text(encoding="ascii").strip()
+        version = _read_manifest((directory / current).read_bytes())
+        newest: dict[bytes, tuple[int, bytes | None]] = {}
+        last_sequence = version.last_sequence
+
+        def see(sequence: int, key: bytes, value: bytes | None) -> None:
+            held = newest.get(key)
+            if held is None or sequence >= held[0]:
+                newest[key] = (sequence, value)
+
+        for number in sorted(version.tables):
+            for entry in _table_entries(_table_path(directory, number).read_bytes()):
+                see(*entry)
+        logs = sorted(
+            (int(path.stem), path)
+            for path in directory.glob("*.log")
+            if path.stem.isdigit()
+            and (
+                int(path.stem) >= version.log_number
+                or int(path.stem) == version.prev_log_number
+            )
+        )
+        for _, path in logs:
+            for record in log_records(path.read_bytes()):
+                for sequence, key, value in _batch_entries(record):
+                    see(sequence, key, value)
+                    last_sequence = max(last_sequence, sequence)
+        if _layout(directory) != before:
+            raise ValueError("its files changed while they were being read")
+    except (OSError, ValueError, IndexError, struct.error) as exc:
+        raise LevelDBError(f"could not read the LevelDB database in {directory}: {exc}") from exc
+    return Snapshot(
+        entries={key: value for key, (_, value) in newest.items()},
+        last_sequence=last_sequence,
+        live_log=logs[-1][1] if logs else None,
+    )
+
+
+def put(directory: Path, key: bytes, value: bytes) -> None:
+    """Set ``key`` to ``value`` by appending one write to the live log.
+
+    The caller holds :func:`locked` for ``directory``. The write takes the
+    next sequence number after everything already in the database, so it
+    wins over every earlier entry for the key. A log whose tail is torn (the
+    last writer died mid-record) is padded to its next block first: a reader
+    drops the rest of a block at the first bad record, and the new record
+    must not sit in that part.
+
+    Raises:
+        LevelDBError: the database could not be read, has no write-ahead
+            log to append to, or the write did not read back.
+    """
+    snapshot = read_db(directory)
+    log = snapshot.live_log
+    if log is None:
+        raise LevelDBError(f"the LevelDB database in {directory} has no write-ahead log")
+    try:
+        data = log.read_bytes()
+        _, clean_end, _ = _scan_log(data)
+        padding = b""
+        if clean_end != len(data) and len(data) % BLOCK_SIZE:
+            padding = b"\x00" * (BLOCK_SIZE - len(data) % BLOCK_SIZE)
+        record = encode_log_records(
+            encode_put(snapshot.last_sequence + 1, key, value),
+            len(data) + len(padding),
+        )
+        with open(log, "ab") as handle:
+            handle.write(padding + record)
+            handle.flush()
+            os.fsync(handle.fileno())
+    except OSError as exc:
+        raise LevelDBError(f"could not write to {log}: {exc}") from exc
+    if read_db(directory).get(key) != value:
+        raise LevelDBError(f"the write to {log} did not read back")
+
+
+@contextmanager
+def locked(directory: Path) -> Iterator[None]:
+    """Hold the database's ``LOCK`` file the way LevelDB does.
+
+    LevelDB takes an exclusive lock on ``LOCK`` for as long as it has the
+    database open, so failing to take it here means a process is using the
+    database, and holding it keeps a second writer out. On POSIX that is an
+    ``fcntl`` record lock; on Windows a byte-range lock (``LockFile`` in
+    LevelDB's own environment, ``LockFileEx`` in Chromium's), which the
+    one-byte lock ``msvcrt.locking`` takes at the start of the file
+    conflicts with.
+
+    The POSIX lock belongs to the process, not to the descriptor: it is
+    gone as soon as this process closes any other descriptor of ``LOCK``.
+    Code running under the lock must not open that file, which includes
+    copying the directory with it in.
+
+    Raises:
+        LevelDBError: another process has the database open.
+    """
+    path = directory / "LOCK"
+    try:
+        handle = open(path, "r+b" if path.exists() else "w+b")
+    except OSError as exc:
+        raise LevelDBError(
+            f"the LevelDB database in {directory} is in use by another process ({exc})"
+        ) from exc
+    try:
+        try:
+            if sys.platform == "win32":
+                import msvcrt
+
+                handle.seek(0)
+                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+
+                fcntl.lockf(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            raise LevelDBError(
+                f"the LevelDB database in {directory} is in use by another process"
+            ) from exc
+        yield
+    finally:
+        handle.close()
