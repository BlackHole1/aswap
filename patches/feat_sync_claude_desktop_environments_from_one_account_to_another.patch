+    @pytest.mark.skipif(not hasattr(time, "tzset"), reason="needs a settable time zone")
+    def test_the_newest_runs_survive_the_end_of_daylight_saving(self, manager, capsys, monkeypatch):
+        """01:59 on the local clock, then 01:00 again an hour of names
+        later: the runs after the change are still the newest."""
+        monkeypatch.setenv("TZ", "EST5EDT,M3.2.0,M11.1.0")
+        time.tzset()
+        try:
+            change = calendar.timegm((2026, 11, 1, 6, 0, 0))
+            assert time.localtime(change - 1)[3:6] == (1, 59, 59)
+            assert time.localtime(change)[3:6] == (1, 0, 0)
+            clock = iter((change - 2 + i) * 10**9 for i in range(5))
+            taken = []
+            with patch.object(desktop_envs.time, "time_ns", side_effect=lambda: next(clock)):
+                for _ in range(5):
+                    capsys.readouterr()
+                    assert manager.sync_envs(["2"], source="1") == 0
+                    kept = re.search(r"kept under (\S+)", _plain(capsys.readouterr().out)).group(1)
+                    taken.append(Path(kept))
+        finally:
+            monkeypatch.undo()
+            time.tzset()
+        assert self._runs(manager) == taken[-desktop_envs.BACKUPS_KEPT:]
