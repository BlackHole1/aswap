+    def test_the_newest_runs_survive_within_one_second(self, manager, capsys):
+        """Runs in one second, their directories stamped alike: only the
+        nanoseconds in the name tell their order, never the random part."""
+        clock = iter(1_800_000_000 * 10**9 + i * 1000 for i in range(5))
+        suffixes = iter(MagicMock(hex=f"{9 - i}0000000") for i in range(5))
+        taken = []
+        with patch.object(desktop_envs.time, "time_ns", side_effect=lambda: next(clock)), \
+             patch.object(desktop_envs.uuid, "uuid4", side_effect=lambda: next(suffixes)):
+            for _ in range(5):
+                capsys.readouterr()
+                assert manager.sync_envs(["2"], source="1") == 0
+                kept = re.search(r"kept under (\S+)", _plain(capsys.readouterr().out)).group(1)
+                assert Path(kept).is_dir()
+                taken.append(Path(kept))
+                for run in self._runs(manager):
+                    os.utime(run, ns=(10**18, 10**18))
+        assert self._runs(manager) == taken[-desktop_envs.BACKUPS_KEPT:]
