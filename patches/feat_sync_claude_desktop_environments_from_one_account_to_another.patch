+        db = build_db(tmp_path / "db", batches=[], extra_edits=[added])
+        manifest = bytearray((db / "MANIFEST-000001").read_bytes())
+        manifest[-1] ^= 0xFF
+        (db / "MANIFEST-000001").write_bytes(bytes(manifest))
+        with pytest.raises(LevelDBError, match="the MANIFEST is damaged"):
+            leveldb.read_db(db)
+
+    @pytest.mark.parametrize("keep", [
+        "first piece only",
+        "first piece, then zeros",
+        "first piece, then a whole edit",
+        "first piece, then another split edit",
+        "last piece only",
+    ])
+    def test_a_manifest_edit_missing_a_piece_is_damage(self, tmp_path, keep):
+        """An edit split over two blocks, with one of its two physical
+        records gone, whatever takes its place: every checksum left in the
+        file is still good."""
+        db = build_db(tmp_path / "db", batches=[])
+        base = (db / "MANIFEST-000001").read_bytes()
+        edits = leveldb.log_records(base, strict=True)
+        whole = _log(edits + [b"x" * (32768 - len(base) - 7 + 40)])
+        assert whole.startswith(base) and len(whole) == 32768 + 7 + 40
+        assert len(leveldb.log_records(whole, strict=True)) == len(edits) + 1
+        if keep == "first piece only":
+            torn = whole[:32768]
+        elif keep == "first piece, then zeros":
+            torn = whole[:32768] + b"\x00" * 64
+        elif keep == "first piece, then a whole edit":
+            torn = whole[:32768] + _log(edits)
+        elif keep == "first piece, then another split edit":
+            torn = whole[:32768] + _log([b"y" * 32768])
+        else:
+            torn = base + b"\x00" * (32768 - len(base)) + whole[32768:]
+        (db / "MANIFEST-000001").write_bytes(torn)
+        with pytest.raises(LevelDBError, match="the MANIFEST is damaged"):
+            leveldb.read_db(db)
