+"""``leveldb.py``: reading a LevelDB database and appending one write.
+
+The fixtures are built here byte by byte from LevelDB's documented formats
+(``doc/log_format.md``, ``doc/table_format.md``, ``db/version_edit.cc``), not
+by the module under test, so a mistake in the module's reading of a format
+does not cancel out against the same mistake in a writer.
+"""
+
+from __future__ import annotations
+
+import os
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+from unittest.mock import patch
+
+import pytest
+
+from claude_swap import leveldb
+from claude_swap.leveldb import LevelDBError, crc32c, encode_varint, snappy_decompress
+
+Entry = tuple[int, bytes, "bytes | None"]
+
+
+def _mask(crc: int) -> int:
+    return (((crc >> 15) | (crc << 17)) + 0xA282EAD8) & 0xFFFFFFFF
+
+
+def _log(records: list[bytes]) -> bytes:
+    """A log-format file holding ``records``, split at 32 KiB blocks."""
+    out = bytearray()
+    for payload in records:
+        first = True
+        while True:
+            left = 32768 - len(out) % 32768
+            if left < 7:
+                out += b"\x00" * left
+                continue
+            piece, payload = payload[:left - 7], payload[left - 7:]
+            last = not payload
+            kind = (1 if last else 2) if first else (4 if last else 3)
+            out += struct.pack("<IHB", _mask(crc32c(bytes([kind]) + piece)), len(piece), kind)
+            out += piece
+            first = False
+            if last:
+                break
+    return bytes(out)
+
+
+def _batch(sequence: int, writes: list[tuple[bytes, bytes | None]]) -> bytes:
+    out = bytearray(struct.pack("<QI", sequence, len(writes)))
+    for key, value in writes:
+        out += bytes([0 if value is None else 1]) + encode_varint(len(key)) + key
+        if value is not None:
+            out += encode_varint(len(value)) + value
+    return bytes(out)
+
+
+def _snappy_literals(data: bytes) -> bytes:
+    """``data`` as a Snappy block made of literals only."""
+    out = bytearray(encode_varint(len(data)))
+    for start in range(0, len(data), 256):
+        piece = data[start:start + 256]
+        out += bytes([60 << 2, len(piece) - 1]) + piece
+    return bytes(out)
+
+
+def _block(pairs: list[tuple[bytes, bytes]]) -> bytes:
+    """A table block with one restart point; later keys share a prefix
+    with the key before them, as LevelDB writes them."""
+    out = bytearray()
+    previous = b""
+    for index, (key, value) in enumerate(pairs):
+        shared = 0
+        if index:
+            while shared < min(len(key), len(previous)) and key[shared] == previous[shared]:
+                shared += 1
+        out += encode_varint(shared) + encode_varint(len(key) - shared)
+        out += encode_varint(len(value)) + key[shared:] + value
+        previous = key
+    out += struct.pack("<II", 0, 1)
+    return bytes(out)
+
+
+def _table(entries: list[Entry], *, snappy: bool = False) -> bytes:
+    """A table file with one data block holding ``entries``."""
+    pairs = [
+        (key + struct.pack("<Q", (sequence << 8) | (0 if value is None else 1)), value or b"")
+        for sequence, key, value in entries
+    ]
+    out = bytearray()
+
+    def add(block: bytes, compress: bool) -> bytes:
+        body = _snappy_literals(block) if compress else block
+        kind = bytes([1 if compress else 0])
+        handle = encode_varint(len(out)) + encode_varint(len(body))
+        out.extend(body + kind + struct.pack("<I", _mask(crc32c(body + kind))))
+        return handle
+
+    data_handle = add(_block(pairs), snappy)
+    meta_handle = add(_block([]), False)
+    index_handle = add(_block([(pairs[-1][0], data_handle)]), False)
+    footer = meta_handle + index_handle
+    out += footer + b"\x00" * (40 - len(footer)) + struct.pack("<Q", 0xDB4775248B80FB57)
+    return bytes(out)
+
+
+def _new_file(number: int) -> bytes:
+    return (
+        encode_varint(7) + encode_varint(0) + encode_varint(number) + encode_varint(1)
+        + encode_varint(1) + b"a" + encode_varint(1) + b"z"
+    )
+
+
+def build_db(
+    directory: Path,
+    *,
+    tables: dict[int, bytes] | None = None,
+    batches: list[bytes] | None = None,
+    log_number: int = 3,
+    last_sequence: int = 0,
+    extra_edits: list[bytes] | None = None,
+) -> Path:
+    """Write a database into ``directory``: ``tables`` by file number,
+    ``batches`` in a live log (None for no log file at all)."""
+    directory.mkdir(parents=True, exist_ok=True)
+    comparator = b"leveldb.BytewiseComparator"
+    edit = (
+        encode_varint(1) + encode_varint(len(comparator)) + comparator
+        + encode_varint(2) + encode_varint(log_number)
+        + encode_varint(3) + encode_varint(log_number + 1)
+        + encode_varint(4) + encode_varint(last_sequence)
+    )
+    for number in tables or {}:
+        edit += _new_file(number)
+    (directory / "MANIFEST-000001").write_bytes(_log([edit, *(extra_edits or [])]))
+    (directory / "CURRENT").write_text("MANIFEST-000001\n")
+    (directory / "LOCK").write_bytes(b"")
+    for number, data in (tables or {}).items():
+        (directory / f"{number:06d}.ldb").write_bytes(data)
+    if batches is not None:
+        (directory / f"{log_number:06d}.log").write_bytes(_log(batches))
+    return directory
+
+
+class TestPrimitives:
+    def test_crc32c_matches_the_standard_check_value(self):
+        assert crc32c(b"123456789") == 0xE3069283
+
+    def test_snappy_literals_and_copies(self):
+        literal = bytes([2 << 2]) + b"abc"
+        short_copy = bytes([((9 - 4) << 2) | 1, 3])  # 9 bytes from 3 back: a run
+        far_copy = bytes([((3 - 1) << 2) | 2]) + struct.pack("<H", 12)
+        data = encode_varint(15) + literal + short_copy + far_copy
+        assert snappy_decompress(data) == b"abcabcabcabcabc"
+
+    def test_snappy_long_literal(self):
+        payload = bytes(range(256)) * 3
+        assert snappy_decompress(_snappy_literals(payload)) == payload
+
+    @pytest.mark.parametrize("data", [
+        encode_varint(3) + bytes([((4 - 4) << 2) | 1, 9]),  # copy before the start
+        encode_varint(9) + bytes([2 << 2]) + b"abc",        # shorter than declared
+        encode_varint(3) + bytes([9 << 2]) + b"abc",        # literal past the input
+    ])
+    def test_snappy_rejects_a_malformed_block(self, data):
+        with pytest.raises(ValueError):
+            snappy_decompress(data)
+
+    def test_log_records_survive_a_block_boundary(self):
+        records = [b"a" * 40000, b"b" * 5, b"c" * 70000]
+        assert leveldb.log_records(_log(records)) == records
+
+    def test_a_torn_record_costs_its_block_and_nothing_after_it(self):
+        intact = _log([b"first"])
+        torn = intact + b"\xff" * 20
+        torn += b"\x00" * (32768 - len(torn)) + _log([b"second"])
+        assert leveldb.log_records(torn) == [b"first", b"second"]
+
+    def test_encoded_records_continue_an_existing_log(self):
+        head = _log([b"x" * 32700])
+        tail = leveldb.encode_log_records(b"y" * 50000, len(head))
+        assert leveldb.log_records(head + tail) == [b"x" * 32700, b"y" * 50000]
+
+
+class TestRead:
+    def test_newest_sequence_wins_across_tables_and_the_log(self, tmp_path):
+        db = build_db(
+            tmp_path / "db",
+            tables={
+                5: _table([(1, b"k1", b"old"), (2, b"k2", b"table")]),
+                7: _table([(4, b"k1", b"newer"), (5, b"k3", b"gone soon")], snappy=True),
+            },
+            batches=[
+                _batch(8, [(b"k3", None), (b"k4", b"log")]),
+                _batch(10, [(b"k4", b"log again")]),
+            ],
+            last_sequence=5,
+        )
+        snapshot = leveldb.read_db(db)
+        assert snapshot.entries == {
+            b"k1": b"newer", b"k2": b"table", b"k3": None, b"k4": b"log again",
+        }
+        assert snapshot.get(b"k3") is None and snapshot.get(b"missing") is None
+        assert snapshot.last_sequence == 10
+        assert snapshot.live_log == db / "000003.log"
+
+    def test_keys_sharing_a_prefix_are_rebuilt(self, tmp_path):
