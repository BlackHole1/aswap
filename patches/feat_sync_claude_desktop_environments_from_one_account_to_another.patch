+        (db / "000002.log").write_bytes(_log([_batch(9, [(b"k", b"already in a table")])]))
+        assert leveldb.read_db(db).entries == {b"k": b"live"}
+
+    def test_not_a_database(self, tmp_path):
+        with pytest.raises(LevelDBError, match="could not read"):
