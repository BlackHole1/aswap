+        db = build_db(tmp_path / "db", tables={5: _table(entries)}, batches=[])
+        assert leveldb.read_db(db).entries == {key: value for _, key, value in entries}
+
+    def test_a_table_the_manifest_dropped_is_not_read(self, tmp_path):
+        dropped = encode_varint(6) + encode_varint(0) + encode_varint(5)
