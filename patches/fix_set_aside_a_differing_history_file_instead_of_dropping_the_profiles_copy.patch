+# Where a history merge parks a profile file whose shared counterpart already
+# exists with different content: <backup>/history-conflicts/<profile>/<run>/.
+# Same-named files are not duplicates by construction — a transcript UUID
+# can straddle an un-share, and memory/MEMORY.md is one fixed name per
+# project — so the losing copy is set aside, never deleted.
+HISTORY_CONFLICTS_DIRNAME = "history-conflicts"
+
+
+def conflict_run_name() -> str:
+    """A fresh ``<run>`` directory name: the time, for reading, plus a random
+    suffix, so two set-asides in the same second never share a directory
+    and the second one never overwrites a file the first one parked."""
+    return f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
+
