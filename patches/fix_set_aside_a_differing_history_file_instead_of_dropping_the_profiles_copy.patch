+
+    def test_merge_differing_collision_sets_profile_copy_aside(
+        self, history_setup, capsys
+    ):
+        # Same name, different content: a transcript continued after an
+        # un-share, or a per-project memory/MEMORY.md. Neither copy may be
+        # lost, and the shared copy must not be overwritten.
+        source, session_dir, mgr = history_setup
+        proj = session_dir / "projects" / "-home-user-app"
+        (proj / "memory").mkdir(parents=True)
+        (proj / "aaa.jsonl").write_text("main-a\nprofile-continued\n")
+        (proj / "memory" / "MEMORY.md").write_text("- profile index\n")
+        (source / "projects" / "-home-user-app" / "memory").mkdir()
+        (source / "projects" / "-home-user-app" / "memory" / "MEMORY.md").write_text(
+            "- main index\n"
+        )
+
+        mgr._sync_sharing(session_dir, share=True, share_history=True)
+
+        shared = source / "projects" / "-home-user-app"
+        assert (shared / "aaa.jsonl").read_text() == "main-a\n"
+        assert (shared / "memory" / "MEMORY.md").read_text() == "- main index\n"
+        conflicts = mgr.switcher.backup_dir / HISTORY_CONFLICTS_DIRNAME / session_dir.name
+        runs = list(conflicts.iterdir())
+        assert len(runs) == 1
+        parked = runs[0] / "projects" / "-home-user-app"
+        assert (parked / "aaa.jsonl").read_text() == "main-a\nprofile-continued\n"
+        assert (parked / "memory" / "MEMORY.md").read_text() == "- profile index\n"
+        assert (session_dir / "projects").readlink() == source / "projects"
+        out = capsys.readouterr().out
+        assert "2 file(s)" in out
+        assert str(runs[0]) in out
+
+    def test_set_aside_runs_in_the_same_second_get_their_own_directory(self):
+        with patch("claude_swap.session.time.strftime", return_value="20260101T000000"):
+            first, second = conflict_run_name(), conflict_run_name()
+        assert first != second
+        assert first.startswith("20260101T000000-")
+
+    def test_merge_without_collisions_reports_nothing_set_aside(
+        self, history_setup, capsys
+    ):
+        source, session_dir, mgr = history_setup
+        proj = session_dir / "projects" / "-home-user-app"
+        proj.mkdir(parents=True)
+        (proj / "bbb.jsonl").write_text("profile-b\n")
+
+        mgr._sync_sharing(session_dir, share=True, share_history=True)
+
+        assert "file(s)" not in capsys.readouterr().out
+        assert not (mgr.switcher.backup_dir / HISTORY_CONFLICTS_DIRNAME).exists()
 
