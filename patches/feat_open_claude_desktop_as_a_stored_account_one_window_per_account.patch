+                [python, "-c", sleeper, f"--user-data-dir={dir_}", *rest],
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+            )
+            for dir_, rest in (
+                (data_dir, []),
+                (data_dir, ["--type=renderer"]),
+                (str(data_dir) + "b", []),
+            )
+        ]
+        try:
+            found = desktop.running_pids(data_dir, Platform.WINDOWS)
+        finally:
+            for proc in procs:
+                proc.kill()
+                proc.wait()
+        assert sorted(found) == sorted(p.pid for p in procs[:2])
