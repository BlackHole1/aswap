+    @pytest.mark.skipif(sys.platform != "win32", reason="CIM is Windows-only")
+    def test_matches_the_whole_token_through_the_real_cim(self, tmp_path):
+        """Run the query through the real PowerShell: it must not report
+        itself, whose command line carries the needle, nor ``2-ab``."""
+        data_dir = tmp_path / "2-a"
+        sleeper = "import time; time.sleep(30)"
+        # A venv's python.exe is a launcher that starts the base interpreter
+        # as a child with the same command line: start that one directly so
+        # each sleeper is one process.
+        python = getattr(sys, "_base_executable", None) or sys.executable
+        procs = [
