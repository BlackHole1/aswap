+class TestSharedState:
+    """The Code tab lists local sessions from ``claude-code-sessions/`` in
+    the profile; a fresh profile shows none. The stock profile's copies are
+    keyed by account UUID, so every account's profile links to them."""
+
+    @pytest.fixture
+    def stock(self, tmp_path):
+        stock = tmp_path / "Application Support" / "Claude"
+        with patch.object(desktop, "default_user_data_dir", return_value=stock):
+            yield stock
+
+    def test_fresh_profile_links_every_shared_item(self, manager, stock):
+        data_dir = manager.data_dir("2", "account2@example.com")
+        data_dir.mkdir(parents=True)
+        manager.sync_shared_state(data_dir)
+        for name in desktop.SHARED_STATE_ITEMS:
+            link = data_dir / name
+            assert link.is_symlink() and link.resolve() == (stock / name).resolve()
+            assert (stock / name).is_dir()
+
+    def test_profiles_own_copy_is_merged_then_linked(self, manager, stock, capsys):
+        data_dir = manager.data_dir("1", "account1@example.com")
+        own = data_dir / "claude-code-sessions" / "acct-uuid" / "org-uuid"
+        own.mkdir(parents=True)
+        (own / "local_new.json").write_text("new")
+        (own / "local_same.json").write_text("same")
+        (own / "local_diff.json").write_text("profile version")
+        shared = stock / "claude-code-sessions" / "acct-uuid" / "org-uuid"
+        shared.mkdir(parents=True)
+        (shared / "local_same.json").write_text("same")
+        (shared / "local_diff.json").write_text("stock version")
+        manager.sync_shared_state(data_dir)
+        assert (data_dir / "claude-code-sessions").is_symlink()
+        assert (shared / "local_new.json").read_text() == "new"
+        assert (shared / "local_diff.json").read_text() == "stock version"
+        conflicts = manager.switcher.backup_dir / "history-conflicts"
+        kept = list(conflicts.rglob("local_diff.json"))
+        assert len(kept) == 1 and kept[0].read_text() == "profile version"
+        assert "desktop-1-account1_example.com" in str(kept[0])
+        out = _plain(capsys.readouterr().out)
+        assert "merged the profile's claude-code-sessions" in out
+        assert "1 file(s) in claude-code-sessions differed" in out
+
