+    def test_all_and_quit_route_to_the_manager(self, temp_home):
+        with patch("claude_swap.cli.ClaudeAccountSwitcher"), \
+             patch("claude_swap.cli._guard_root"), \
+             patch("claude_swap.desktop.DesktopManager") as cls:
+            cls.return_value.open.return_value = 0
+            cls.return_value.quit.return_value = 0
+            cli._desktop_command(["--all"])
+            cli._desktop_command(["--quit", "2"])
+        cls.return_value.open.assert_called_once_with([], True)
+        cls.return_value.quit.assert_called_once_with(["2"], False)
+
+    def test_bare_desktop_lists(self, temp_home):
+        with patch("claude_swap.cli.ClaudeAccountSwitcher"), \
