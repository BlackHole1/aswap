+class TestRunningPids:
+    def test_matches_the_whole_token_and_drops_itself(self, tmp_path):
+        data_dir = tmp_path / "2-a"
+        with patch.object(desktop.subprocess, "run") as run, \
+             patch.object(desktop.os, "getpid", return_value=77):
+            run.return_value = MagicMock(stdout="77\n101\n102\nnoise\n")
+            pids = desktop.running_pids(data_dir, Platform.MACOS)
+        assert pids == [101, 102]
+        pattern = run.call_args.args[0][2]
+        assert re.search(pattern, f"/x/Claude --user-data-dir={data_dir}")
+        assert re.search(pattern, f"Claude --user-data-dir={data_dir} --type=renderer")
+        assert not re.search(pattern, f"Claude --user-data-dir={data_dir}b")
+
+    def test_unknowable_reads_as_not_running(self, tmp_path):
+        with patch.object(desktop.subprocess, "run", side_effect=OSError("no pgrep")):
+            assert desktop.running_pids(tmp_path, Platform.LINUX) == []
+
+    def test_windows_asks_cim_for_the_command_line(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(stdout="4242\r\n")
+            assert desktop.running_pids(tmp_path / "1-a", Platform.WINDOWS) == [4242]
+        argv = run.call_args.args[0]
+        assert argv[0] == "powershell"
+        assert f"--user-data-dir={tmp_path / '1-a'}" in argv[-1]
