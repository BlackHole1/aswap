+        d = desktop_dir_for(tmp_path, "2", "user@x.com")
+        assert d == tmp_path / "desktop" / "2-user_x.com"
+
+    def test_windows_forbidden_chars_are_replaced(self, tmp_path):
+        d = desktop_dir_for(tmp_path, "1", 'a<b>:"|?*@x.com')
+        assert not set('<>:"|?*') & set(d.name)
+
