+class TestManager:
+    def test_first_open_creates_a_private_profile_and_says_to_sign_in(
+        self, manager, app, capsys
+    ):
+        with patch.object(desktop, "running_pids", return_value=[]), \
+             patch.object(desktop, "launch") as launch:
+            assert manager.open(["2"]) == 0
+        data_dir = manager.data_dir("2", "account2@example.com")
+        launch.assert_called_once_with(app, data_dir, Platform.MACOS)
+        assert data_dir.is_dir()
+        if sys.platform != "win32":
+            assert data_dir.stat().st_mode & 0o777 == 0o700
+        out = _plain(capsys.readouterr().out)
+        assert "2. account2@example.com" in out and "sign in" in out
+
+    def test_second_open_of_a_profile_does_not_repeat_the_sign_in_hint(
