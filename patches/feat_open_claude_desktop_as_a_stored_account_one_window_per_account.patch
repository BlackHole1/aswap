+class TestLaunch:
+    def test_macos_hands_the_profile_to_open(self, tmp_path):
+        """``open -n`` so LaunchServices, not this terminal, owns the app;
+        ``--args`` carries the profile dir through to Electron."""
+        data_dir = tmp_path / "2-x"
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(returncode=0)
+            desktop.launch(Path("/Applications/Claude.app"), data_dir, Platform.MACOS)
+        assert run.call_args.args[0] == [
+            "open", "-n", "-a", "/Applications/Claude.app",
+            "--args", f"--user-data-dir={data_dir}",
+        ]
+
+    def test_macos_open_failure_is_an_error(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(returncode=1, stderr="Unable to find", stdout="")
+            with pytest.raises(SessionError, match="could not open .*Unable to find"):
+                desktop.launch(Path("/x/Claude.app"), tmp_path, Platform.MACOS)
+
+    def test_other_platforms_start_the_binary_detached(self, tmp_path):
+        exe = tmp_path / "claude"
+        with patch.object(desktop.subprocess, "Popen") as popen:
+            desktop.launch(exe, tmp_path / "p", Platform.LINUX)
+        args, kwargs = popen.call_args
+        assert args[0] == [str(exe), f"--user-data-dir={tmp_path / 'p'}"]
+        assert kwargs["stdin"] is subprocess.DEVNULL
+        assert kwargs["stdout"] is subprocess.DEVNULL
+        if sys.platform != "win32":
+            assert kwargs["start_new_session"] is True
+
+    def test_activate_reuses_the_running_app(self):
+        with patch.object(desktop.subprocess, "run") as run:
+            desktop.activate(Path("/Applications/Claude.app"), Platform.MACOS)
+        assert run.call_args.args[0] == ["open", "-a", "/Applications/Claude.app"]
+
+    def test_activate_is_a_noop_elsewhere(self):
+        with patch.object(desktop.subprocess, "run") as run:
+            desktop.activate(Path("/x"), Platform.LINUX)
+        run.assert_not_called()
+
