+class TestQuit:
+    def test_nothing_running_is_a_noop(self, tmp_path):
+        with patch.object(desktop, "running_pids", return_value=[]), \
+             patch.object(desktop, "_signal") as sig:
+            assert desktop.quit_instance(tmp_path, platform=Platform.MACOS) is False
+        sig.assert_not_called()
+
+    def test_term_then_kill_after_the_timeout(self, tmp_path):
+        clock = iter([0.0, 0.1, 10.0, 10.0])
+        with patch.object(desktop, "running_pids", return_value=[5]), \
+             patch.object(desktop, "_signal") as sig, \
+             patch.object(desktop.time, "monotonic", side_effect=clock), \
+             patch.object(desktop.time, "sleep"):
+            assert desktop.quit_instance(tmp_path, timeout=5, platform=Platform.MACOS)
+        forces = [c.kwargs["force"] for c in sig.call_args_list]
+        assert forces == [False, True]
+
+    def test_term_alone_when_the_window_leaves(self, tmp_path):
+        with patch.object(desktop, "running_pids", side_effect=[[5], []]), \
+             patch.object(desktop, "_signal") as sig:
+            assert desktop.quit_instance(tmp_path, platform=Platform.MACOS)
+        assert [c.kwargs["force"] for c in sig.call_args_list] == [False]
