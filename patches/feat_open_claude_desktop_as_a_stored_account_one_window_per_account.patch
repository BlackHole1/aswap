+++ b/tests/test_desktop.py
@@ -0,0 +1,642 @@
+"""``cswap desktop``: Claude Desktop, one window per stored account.
+
+Claude Desktop keeps one login per profile, and Electron honors
+``--user-data-dir``, so each account gets a permanent profile under
+``<backup>/desktop/`` and the app is opened against it. The window is
+found again by the exact ``--user-data-dir=<dir>`` token on its command
+line. Nothing copies a login: the user signs in once per profile.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from claude_swap import cli, desktop
+from claude_swap.desktop import DesktopManager, desktop_dir_for, find_app
+from claude_swap.exceptions import ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.settings import (
+    load_desktop_settings,
+    set_setting,
+    settings_path,
+    unset_setting,
+)
+from claude_swap.switcher import ClaudeAccountSwitcher
+
+
+def _plain(text: str) -> str:
+    return re.sub(r"\x1b\[[0-9;]*m", "", text)
+
+
+@pytest.fixture
+def switcher(temp_home, sample_sequence_data):
+    sw = ClaudeAccountSwitcher()
+    sw._setup_directories()
+    sw._write_json(sw.sequence_file, sample_sequence_data)
+    return sw
+
+
+@pytest.fixture
+def app(tmp_path):
+    bundle = tmp_path / "Claude.app"
+    bundle.mkdir()
+    return bundle
+
+
+@pytest.fixture
+def manager(switcher, app):
+    """A manager on macOS with the app found and no window open unless a
+    test says so."""
+    m = DesktopManager(switcher)
+    m.platform = Platform.MACOS
+    m._app = app
+    return m
+
+
+class TestLayout:
+    def test_profile_sits_beside_session_profiles(self, tmp_path):
+        d = desktop_dir_for(tmp_path, "2", "user@x.com")
+        assert d == tmp_path / "desktop" / "2-user_x.com"
+
+    def test_windows_forbidden_chars_are_replaced(self, tmp_path):
+        d = desktop_dir_for(tmp_path, "1", 'a<b>:"|?*@x.com')
+        assert not set('<>:"|?*') & set(d.name)
+
+
+class TestFindApp:
+    def test_setting_wins_over_the_stock_location(self, tmp_path):
+        custom = tmp_path / "Elsewhere" / "Claude.app"
+        custom.mkdir(parents=True)
+        assert find_app(str(custom), Platform.MACOS) == custom
+
+    def test_setting_that_points_nowhere_names_the_fix(self, tmp_path):
+        with pytest.raises(ConfigError, match="desktop.appPath points at .*unset"):
+            find_app(str(tmp_path / "missing.app"), Platform.MACOS)
+
+    def test_stock_location_is_found(self, tmp_path):
+        stock = tmp_path / "Applications" / "Claude.app"
+        stock.mkdir(parents=True)
+        with patch.object(desktop, "default_app_candidates", return_value=[stock]):
+            assert find_app(None, Platform.MACOS) == stock
+
+    def test_missing_install_says_where_it_looked(self, tmp_path):
+        with patch.object(
+            desktop, "default_app_candidates", return_value=[tmp_path / "nope.app"]
+        ):
+            with pytest.raises(ConfigError, match="not found .*nope.app"):
+                find_app(None, Platform.MACOS)
+
+    def test_linux_has_no_stock_app(self):
+        with pytest.raises(ConfigError, match="no official Linux build"):
+            find_app(None, Platform.LINUX)
+
+    def test_windows_candidate_follows_localappdata(self, tmp_path, monkeypatch):
+        monkeypatch.setenv("LOCALAPPDATA", str(tmp_path))
+        assert desktop.default_app_candidates(Platform.WINDOWS) == [
+            tmp_path / "AnthropicClaude" / "claude.exe"
+        ]
+
+
+class TestLaunch:
+    def test_macos_hands_the_profile_to_open(self, tmp_path):
+        """``open -n`` so LaunchServices, not this terminal, owns the app;
+        ``--args`` carries the profile dir through to Electron."""
+        data_dir = tmp_path / "2-x"
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(returncode=0)
+            desktop.launch(Path("/Applications/Claude.app"), data_dir, Platform.MACOS)
+        assert run.call_args.args[0] == [
+            "open", "-n", "-a", "/Applications/Claude.app",
+            "--args", f"--user-data-dir={data_dir}",
+        ]
+
+    def test_macos_open_failure_is_an_error(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(returncode=1, stderr="Unable to find", stdout="")
+            with pytest.raises(SessionError, match="could not open .*Unable to find"):
+                desktop.launch(Path("/x/Claude.app"), tmp_path, Platform.MACOS)
+
+    def test_other_platforms_start_the_binary_detached(self, tmp_path):
+        exe = tmp_path / "claude"
+        with patch.object(desktop.subprocess, "Popen") as popen:
+            desktop.launch(exe, tmp_path / "p", Platform.LINUX)
+        args, kwargs = popen.call_args
+        assert args[0] == [str(exe), f"--user-data-dir={tmp_path / 'p'}"]
+        assert kwargs["stdin"] is subprocess.DEVNULL
+        assert kwargs["stdout"] is subprocess.DEVNULL
+        if sys.platform != "win32":
+            assert kwargs["start_new_session"] is True
+
+    def test_activate_reuses_the_running_app(self):
+        with patch.object(desktop.subprocess, "run") as run:
+            desktop.activate(Path("/Applications/Claude.app"), Platform.MACOS)
+        assert run.call_args.args[0] == ["open", "-a", "/Applications/Claude.app"]
+
+    def test_activate_is_a_noop_elsewhere(self):
+        with patch.object(desktop.subprocess, "run") as run:
+            desktop.activate(Path("/x"), Platform.LINUX)
+        run.assert_not_called()
+
+
+class TestRunningPids:
+    def test_drops_itself_and_noise(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run, \
+             patch.object(desktop.os, "getpid", return_value=77):
+            run.return_value = MagicMock(stdout="77\n101\n102\nnoise\n")
+            pids = desktop.running_pids(tmp_path / "2-a", Platform.MACOS)
+        assert pids == [101, 102]
+
+    @pytest.mark.skipif(sys.platform == "win32", reason="pgrep is POSIX")
+    def test_matches_the_whole_token_through_the_real_pgrep(self, tmp_path):
+        """Run the pattern through the system ``pgrep``, not Python's ``re``:
+        the two dialects differ, and BSD ``pgrep`` (macOS) has no ``\\s``,
+        so a pattern that only ever met ``re`` matched nothing there."""
+        data_dir = tmp_path / "2-a"
+        sleeper = "import time; time.sleep(30)"
+        procs = [
+            subprocess.Popen(
+                [sys.executable, "-c", sleeper, f"--user-data-dir={dir_}", *rest],
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+            )
+            for dir_, rest in (
+                (data_dir, []),
+                (data_dir, ["--type=renderer"]),
+                (str(data_dir) + "b", []),
+            )
+        ]
+        try:
+            platform = Platform.MACOS if sys.platform == "darwin" else Platform.LINUX
+            found = desktop.running_pids(data_dir, platform)
+        finally:
+            for proc in procs:
+                proc.kill()
+                proc.wait()
+        assert sorted(found) == sorted(p.pid for p in procs[:2])
+
+    def test_unknowable_reads_as_not_running(self, tmp_path):
+        with patch.object(desktop.subprocess, "run", side_effect=OSError("no pgrep")):
+            assert desktop.running_pids(tmp_path, Platform.LINUX) == []
+
+    def test_windows_asks_cim_for_the_command_line(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(stdout="4242\r\n")
+            assert desktop.running_pids(tmp_path / "1-a", Platform.WINDOWS) == [4242]
+        argv = run.call_args.args[0]
+        assert argv[0] == "powershell"
