+def _desktop_command(argv: list[str]) -> None:
+    """Handle `cswap desktop [num|email ...] [--all] [--quit]`.
+
+    Claude Desktop keeps one login per profile, so a second account means
+    signing the first one out. Each stored account gets its own permanent
+    profile directory here, and the app is opened against it with
+    ``--user-data-dir``; the accounts stay signed in side by side, each in
+    its own window. Nothing copies a login: sign in once per account.
+    """
+    parser = argparse.ArgumentParser(
+        prog=f"{_prog_name()} desktop",
+        description=(
+            "Open Claude Desktop as a stored account, in its own window with "
+            "its own login. Every account has a permanent desktop profile, "
+            "picked by its slot in the account table; the credential cswap "
+            "stores for Claude Code is not used or copied. The first open "
+            "shows a sign-in: sign in to that account once, and it stays "
+            "signed in. Several accounts can be open at once. The Code tab's "
+            "local sessions are shared with the stock profile (setting "
+            "desktop.shareSessions; not on Windows). With no account: list "
+            "each account's window. Exits 1 if any account could not be "
+            "opened."
+        ),
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  cswap desktop                 # which accounts have a window open
+  cswap desktop 2               # open account 2 (or bring its window forward)
+  cswap desktop work personal   # by alias or email; several at once
+  cswap desktop --all           # every account, one window each
+  cswap desktop --quit 2        # close account 2's window
+  cswap config set desktop.appPath /path/to/Claude.app   # non-standard install
+        """,
+    )
+    parser.add_argument(
+        "accounts",
+        nargs="*",
+        metavar="num|email",
+        help="Accounts to open (number, alias or email)",
+    )
+    parser.add_argument(
+        "--all", action="store_true", help="Every stored account",
+    )
+    parser.add_argument(
+        "--quit", action="store_true",
+        help="Close the given accounts' windows instead of opening them",
+    )
+    parser.add_argument("--debug", action="store_true", help="Enable debug logging")
+    args = parser.parse_args(argv)
+    if args.all and args.accounts:
+        parser.error("--all takes no accounts")
+    if args.quit and not (args.all or args.accounts):
+        parser.error("--quit needs an account or --all")
+
+    try:
+        switcher = ClaudeAccountSwitcher(debug=args.debug)
+        _guard_root(switcher)
+
+        from claude_swap.desktop import DesktopManager
+
+        manager = DesktopManager(switcher)
+        if args.quit:
+            code = manager.quit(args.accounts, args.all)
+        elif args.all or args.accounts:
+            code = manager.open(args.accounts, args.all)
+        else:
+            manager.show()
+            code = 0
+    except ClaudeSwitchError as e:
+        error(f"Error: {e}")
+        sys.exit(1)
+    except KeyboardInterrupt:
+        print(f"\n{dimmed('Operation cancelled')}")
+        sys.exit(130)
+    if code:
+        sys.exit(code)
+
+
