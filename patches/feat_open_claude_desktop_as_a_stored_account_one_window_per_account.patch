+"""``cswap desktop``: Claude Desktop, one window per stored account.
+
+Claude Desktop keeps one login per profile, and Electron honors
+``--user-data-dir``, so each account gets a permanent profile under
+``<backup>/desktop/`` and the app is opened against it. The window is
+found again by the exact ``--user-data-dir=<dir>`` token on its command
+line. Nothing copies a login: the user signs in once per profile.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from claude_swap import cli, desktop
+from claude_swap.desktop import DesktopManager, desktop_dir_for, find_app
+from claude_swap.exceptions import ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.settings import (
+    load_desktop_settings,
+    set_setting,
+    settings_path,
+    unset_setting,
+)
+from claude_swap.switcher import ClaudeAccountSwitcher
+
+
+def _plain(text: str) -> str:
+    return re.sub(r"\x1b\[[0-9;]*m", "", text)
+
+
+@pytest.fixture
+def switcher(temp_home, sample_sequence_data):
+    sw = ClaudeAccountSwitcher()
+    sw._setup_directories()
+    sw._write_json(sw.sequence_file, sample_sequence_data)
+    return sw
+
+
+@pytest.fixture
+def app(tmp_path):
+    bundle = tmp_path / "Claude.app"
+    bundle.mkdir()
+    return bundle
+
+
+@pytest.fixture
+def manager(switcher, app):
+    """A manager on macOS with the app found and no window open unless a
+    test says so."""
+    m = DesktopManager(switcher)
+    m.platform = Platform.MACOS
+    m._app = app
+    return m
+
