diff --git a/src/claude_swap/desktop.py b/src/claude_swap/desktop.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c992a51c630620900e1a36cb2f987fee2b22a17
--- /dev/null
+++ b/src/claude_swap/desktop.py
@@ -0,0 +1,620 @@
+"""Claude Desktop, one window per stored account.
+
+Claude Desktop holds one login per profile: to use a second account the
+user signs out, signs in again, and the first account is gone. The app is
+Electron, and Electron honors ``--user-data-dir``, so a separate profile
+directory is a separate, independently logged-in copy of the app. This
+module gives every stored account its own permanent profile under
+``<backup>/desktop/<num>-<email slug>/`` and opens the app against it.
+Nothing here reads, copies or migrates a login: Claude owns everything
+inside the profile, and the user signs in once per account.
+
+Detection follows the profile, not the app: a Claude process whose command
+line carries exactly our ``--user-data-dir=<dir>`` is that account's window.
+The same approach as https://github.com/siddhjagani/guise, ported to the
+account table cswap already keeps.
+
+A separate profile also means a separate copy of the app's own state. The
+Code tab lists its local sessions from ``claude-code-sessions/`` inside the
+profile (the transcripts themselves live in ``~/.claude/projects``), so a
+fresh profile shows none of the sessions the stock install already has.
+Those directories are keyed by account UUID one level down, so every
+profile can share the stock install's copies: ``desktop.shareSessions``
+(default on) links them into the profile, merging anything the profile
+accumulated on its own first.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from claude_swap.exceptions import AccountNotFoundError, ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.printer import accent, bold_accent, dimmed, error, muted, warning
+from claude_swap.session import slugify_email
+
+if TYPE_CHECKING:
+    from claude_swap.switcher import ClaudeAccountSwitcher
+
+DESKTOP_DIRNAME = "desktop"
+USER_DATA_FLAG = "--user-data-dir"
+QUIT_TIMEOUT_S = 5.0
+
+
+def desktop_dir_for(backup_dir: Path, account_num: str, email: str) -> Path:
+    """Profile directory Claude Desktop is opened against for an account.
+
+    Same ``<num>-<slug>`` naming as session profiles, under ``desktop/``
+    instead of ``sessions/``, so the two never collide and ``purge`` sweeps
+    both with the backup root.
+    """
+    return backup_dir / DESKTOP_DIRNAME / f"{account_num}-{slugify_email(email)}"
+
+
+def default_app_candidates(platform: Platform | None = None) -> list[Path]:
+    """Where a stock Claude Desktop install lives, most likely first."""
+    platform = platform or Platform.detect()
+    home = Path.home()
+    if platform == Platform.MACOS:
+        return [Path("/Applications/Claude.app"), home / "Applications" / "Claude.app"]
+    if platform == Platform.WINDOWS:
+        local = os.environ.get("LOCALAPPDATA")
+        base = Path(local) if local else home / "AppData" / "Local"
+        return [base / "AnthropicClaude" / "claude.exe"]
+    return []
+
+
+def find_app(configured: str | None, platform: Platform | None = None) -> Path:
+    """Resolve the Claude Desktop app: the ``desktop.appPath`` setting, else
+    the stock install location for this platform.
+
+    Raises:
+        ConfigError: nothing usable was found, with the setting to fix it.
+    """
+    platform = platform or Platform.detect()
+    if configured:
+        app = Path(os.path.expanduser(configured))
+        if app.exists():
+            return app
+        raise ConfigError(
+            f"desktop.appPath points at {app}, which does not exist; run "
+            "'cswap config set desktop.appPath <path>' with the app's location, "
+            "or 'cswap config unset desktop.appPath' to look in the default place"
+        )
+    for candidate in default_app_candidates(platform):
+        if candidate.exists():
+            return candidate
+    if platform in (Platform.LINUX, Platform.WSL):
+        raise ConfigError(
+            "Claude Desktop has no official Linux build; point "
+            "'cswap config set desktop.appPath <path>' at an Electron build "
+            "of the app to open it per account"
+        )
+    looked = ", ".join(str(c) for c in default_app_candidates(platform)) or "nowhere"
+    raise ConfigError(
+        f"Claude Desktop not found (looked in {looked}); install it, or run "
+        "'cswap config set desktop.appPath <path>' with its location"
+    )
+
+
+def default_user_data_dir(platform: Platform | None = None) -> Path:
+    """The profile the stock app uses when no ``--user-data-dir`` is given
+    (Electron's ``app.getPath("userData")`` for ``Claude``)."""
+    platform = platform or Platform.detect()
+    home = Path.home()
+    if platform == Platform.MACOS:
+        return home / "Library" / "Application Support" / "Claude"
+    if platform == Platform.WINDOWS:
+        appdata = os.environ.get("APPDATA")
+        base = Path(appdata) if appdata else home / "AppData" / "Roaming"
+        return base / "Claude"
+    xdg = Path(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "")))
+    base = xdg if str(xdg) != "." and xdg.is_absolute() else home / ".config"
+    return base / "Claude"
+
+
+# State the app keeps per account UUID one level down, so one shared copy
+# serves every profile and each window still only sees its own account:
+# the Code tab's local session index, local agent-mode state (scheduled
+# tasks, rpm) and the Spaces link keys.
+SHARED_STATE_ITEMS: tuple[str, ...] = (
+    "claude-code-sessions",
+    "local-agent-mode-sessions",
+    "spaces-present",
+)
+
+
+def stock_account_uuid(stock_dir: Path) -> str | None:
+    """The account the stock profile last signed in as, from its
+    ``config.json`` (``lastKnownAccountUuid``, the same UUID cswap stores
+    for an account); None when unknown."""
+    try:
+        data = json.loads((stock_dir / "config.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    value = data.get("lastKnownAccountUuid") if isinstance(data, dict) else None
+    return value if isinstance(value, str) and value else None
+
+
+def stock_instance_running(app: Path, platform: Platform | None = None) -> bool:
+    """Is Claude Desktop open on the stock profile: the app's own binary
+    started with no ``--user-data-dir``? Best effort, POSIX only."""
+    platform = platform or Platform.detect()
+    if platform == Platform.WINDOWS:
+        return False
+    try:
+        proc = subprocess.run(
+            ["ps", "-axo", "command="], capture_output=True, text=True, timeout=10,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return False
+    prefix = str(app)
+    for line in proc.stdout.splitlines():
+        if line.startswith(prefix) and USER_DATA_FLAG not in line:
+            return True
+    return False
+
+
+def _user_data_arg(data_dir: Path) -> str:
+    return f"{USER_DATA_FLAG}={data_dir}"
+
+
+def launch(app: Path, data_dir: Path, platform: Platform | None = None) -> None:
+    """Start a new Claude Desktop instance bound to ``data_dir``, detached.
+
+    macOS goes through ``open -n`` so LaunchServices owns the process: a
+    direct binary launch stays a child of this terminal, steals focus, and
+    dies with the shell. Elsewhere the executable is started in its own
+    session with every standard stream closed.
+
+    Raises:
+        SessionError: the launcher reported failure.
+    """
+    platform = platform or Platform.detect()
+    arg = _user_data_arg(data_dir)
+    if platform == Platform.MACOS:
+        proc = subprocess.run(
+            ["open", "-n", "-a", str(app), "--args", arg],
+            capture_output=True, text=True,
+        )
+        if proc.returncode != 0:
+            detail = (proc.stderr or proc.stdout).strip()
+            raise SessionError(
+                f"could not open {app}" + (f": {detail}" if detail else "")
+            )
+        return
+    kwargs: dict = {
+        "stdin": subprocess.DEVNULL,
+        "stdout": subprocess.DEVNULL,
+        "stderr": subprocess.DEVNULL,
+        "close_fds": True,
+    }
+    if sys.platform == "win32":
+        kwargs["creationflags"] = (
+            subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
+        )
+    else:
+        kwargs["start_new_session"] = True
+    try:
+        subprocess.Popen([str(app), arg], **kwargs)
+    except OSError as exc:
+        raise SessionError(f"could not start {app}: {exc}") from exc
+
+
+def activate(app: Path, platform: Platform | None = None) -> None:
+    """Bring Claude Desktop to the front without starting another copy.
+
+    Best effort, macOS only: ``open`` without ``-n`` activates the running
+    app. With several instances open, LaunchServices picks one; the user
+    reaches the others through Mission Control or Cmd-backtick.
+    """
+    platform = platform or Platform.detect()
+    if platform != Platform.MACOS:
+        return
+    try:
+        subprocess.run(["open", "-a", str(app)], capture_output=True, timeout=10)
+    except (OSError, subprocess.TimeoutExpired):
+        pass
+
+
+def running_pids(data_dir: Path, platform: Platform | None = None) -> list[int]:
+    """PIDs of the Claude processes bound to exactly ``data_dir``.
+
+    Matches the whole ``--user-data-dir=<dir>`` token, terminated by
+    whitespace or the end of the command line, so ``2-a`` never matches
+    ``2-ab``; helpers inherit the flag, so one window is several PIDs.
+    The pattern is POSIX ERE for ``pgrep``: ``[[:space:]]``, not ``\\s``,
+    which BSD ``pgrep`` (macOS) does not understand and never matches.
+    Empty on every failure: not knowing reads as "not running", which only
+    ever costs a second window, never a lost one.
+    """
+    platform = platform or Platform.detect()
+    needle = _user_data_arg(data_dir)
+    me = os.getpid()
+    try:
+        if platform == Platform.WINDOWS:
+            out = _windows_matching_pids(needle)
+        else:
+            pattern = re.escape(needle) + r"([[:space:]]|$)"
+            proc = subprocess.run(
+                ["pgrep", "-f", pattern],
+                capture_output=True, text=True, timeout=10,
+            )
+            out = proc.stdout
+    except (OSError, subprocess.TimeoutExpired):
+        return []
+    pids = []
+    for token in out.split():
+        try:
+            pid = int(token)
+        except ValueError:
+            continue
+        if pid != me:
+            pids.append(pid)
+    return pids
+
+
+def _windows_matching_pids(needle: str) -> str:
+    """PIDs whose command line contains ``needle``, one per line, via CIM."""
+    literal = needle.replace("'", "''")
+    script = (
+        "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -ne $null "
+        f"-and $_.CommandLine.Contains('{literal}') }} "
+        "| ForEach-Object { $_.ProcessId }"
+    )
+    proc = subprocess.run(
+        ["powershell", "-NoProfile", "-NonInteractive", "-Command", script],
+        capture_output=True, text=True, timeout=20,
+    )
+    return proc.stdout
+
+
+def quit_instance(
+    data_dir: Path, timeout: float = QUIT_TIMEOUT_S, platform: Platform | None = None
+) -> bool:
+    """Ask the account's window to quit, then force it once ``timeout`` passes.
+
+    Returns True when something was running.
+    """
+    platform = platform or Platform.detect()
+    pids = running_pids(data_dir, platform)
+    if not pids:
+        return False
+    _signal(pids, force=False, platform=platform)
+    deadline = time.monotonic() + timeout
+    while running_pids(data_dir, platform):
+        if time.monotonic() >= deadline:
+            _signal(running_pids(data_dir, platform), force=True, platform=platform)
+            break
+        time.sleep(0.2)
+    return True
+
+
+def _signal(pids: list[int], *, force: bool, platform: Platform) -> None:
+    for pid in pids:
+        try:
+            if platform == Platform.WINDOWS:
+                cmd = ["taskkill", "/PID", str(pid), "/T"] + (["/F"] if force else [])
+                subprocess.run(cmd, capture_output=True, timeout=10)
+            else:
+                import signal
+
+                os.kill(pid, signal.SIGKILL if force else signal.SIGTERM)
+        except (OSError, subprocess.TimeoutExpired):
+            pass
+
+
+@dataclass(frozen=True)
+class DesktopProfile:
+    """One account's Claude Desktop profile as ``cswap desktop`` lists it."""
+
+    number: str
+    email: str
+    alias: str
+    data_dir: Path
+    exists: bool  # opened at least once
+    pids: tuple[int, ...]
+
+    @property
+    def running(self) -> bool:
+        return bool(self.pids)
+
+
+class DesktopManager:
+    """Opens, lists and quits per-account Claude Desktop windows."""
+
+    def __init__(self, switcher: ClaudeAccountSwitcher):
+        self.switcher = switcher
+        self.platform = switcher.platform
+        self._app: Path | None = None
+
+    # -- resolution --------------------------------------------------------
+
+    def data_dir(self, account_num: str, email: str) -> Path:
+        return desktop_dir_for(self.switcher.backup_dir, account_num, email)
+
+    def app(self) -> Path:
+        if self._app is None:
+            from claude_swap.settings import load_desktop_settings
+
+            configured = load_desktop_settings(self.switcher.backup_dir).app_path
+            self._app = find_app(configured, self.platform)
+        return self._app
+
+    def profiles(self) -> list[DesktopProfile]:
+        """Every stored account with its profile state, in slot order."""
+        data = self.switcher._get_sequence_data() or {}
+        accounts = data.get("accounts", {})
+        rows = []
+        for number in sorted(accounts, key=lambda n: int(n) if n.isdigit() else 0):
+            record = accounts[number]
+            email = record.get("email", "")
+            data_dir = self.data_dir(number, email)
+            rows.append(DesktopProfile(
+                number=number,
+                email=email,
+                alias=record.get("alias", "") or "",
+                data_dir=data_dir,
+                exists=data_dir.is_dir(),
+                pids=tuple(running_pids(data_dir, self.platform)),
+            ))
+        return rows
+
+    def _targets(self, identifiers: list[str], all_accounts: bool) -> list[tuple[str, str] | None]:
+        """(number, email) per requested account; unknown ones are reported
+        and skipped so the rest still open."""
+        if all_accounts:
+            return [(p.number, p.email) for p in self.profiles()]
+        targets: list[tuple[str, str] | None] = []
+        for ident in identifiers:
+            try:
+                number, email, _ = self.switcher.resolve_account(ident)
+            except AccountNotFoundError:
+                error(f"  {ident}: account not found")
+                targets.append(None)
+                continue
+            targets.append((number, email))
+        return targets
+
+    def _account_uuid(self, number: str) -> str:
+        data = self.switcher._get_sequence_data() or {}
+        return str(data.get("accounts", {}).get(number, {}).get("uuid", "") or "")
+
+    def warn_if_stock_login(self, number: str) -> bool:
+        """Say so when the account is also signed in in a stock Claude window
+        that is open right now.
+
+        Both windows then share the same session files, but each keeps its
+        own copy in memory: nothing syncs live, their writes overwrite each
+        other, and only a reload (Cmd+R) rereads a window from disk. Returns
+        True when it warned.
+        """
+        uuid = self._account_uuid(number)
+        if not uuid:
+            return False
+        stock = default_user_data_dir(self.platform)
+        if stock_account_uuid(stock) != uuid:
+            return False
+        if not stock_instance_running(self.app(), self.platform):
+            return False
+        warning(
+            "     also signed in in the stock Claude window: sessions do not "
+            "sync live between the two windows and their writes overwrite each "
+            "other. To sync, reload a window (Cmd+R) to reread from disk."
+        )
+        return True
+
+    # -- commands ----------------------------------------------------------
+
+    def open(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Open (or bring forward) the windows of the given accounts.
+
+        Returns 1 when any requested account could not be opened.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        if not targets:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return 0
+        app = self.app()
+        failed = any(t is None for t in targets)
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            label = f"{number}. {email}"
+            if running_pids(data_dir, self.platform):
+                activate(app, self.platform)
+                print(f"  {label} {dimmed('already open, brought to the front')}")
+                continue
+            first_time = not data_dir.is_dir()
+            self._mkdir_private(data_dir)
+            self.sync_shared_state(data_dir)
+            try:
+                launch(app, data_dir, self.platform)
+            except SessionError as exc:
+                error(f"  {label}: {exc}")
+                failed = True
+                continue
+            if first_time:
+                print(
+                    f"  {label} {accent('opening a fresh window')}; sign in to "
+                    "this account there, once. It stays signed in."
+                )
+            else:
+                print(f"  {label} {accent('opening')}")
+            self.warn_if_stock_login(number)
+        return 1 if failed else 0
+
+    def quit(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Close the given accounts' windows. Returns 1 for an unknown account.
+
+        ``--all`` also sweeps ``desktop/`` itself, so a profile whose account
+        slot is gone (the one ``purge`` reports) is closed too.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        failed = any(t is None for t in targets)
+        seen: set[str] = set()
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            seen.add(data_dir.name)
+            if quit_instance(data_dir, platform=self.platform):
+                print(f"  {number}. {email} {accent('closed')}")
+            else:
+                print(f"  {number}. {email} {dimmed('not open')}")
+        if all_accounts:
+            root = self.switcher.backup_dir / DESKTOP_DIRNAME
+            for name in sorted(self.open_profile_dirs()):
+                if name in seen:
+                    continue
+                if quit_instance(root / name, platform=self.platform):
+                    print(f"  {name} {accent('closed')} {dimmed('(no account slot)')}")
+        return 1 if failed else 0
+
+    def show(self) -> None:
+        """List every account's profile: open, signed in once, or never opened."""
+        rows = self.profiles()
+        if not rows:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return
+        print(bold_accent("Claude Desktop profiles:"))
+        for p in rows:
+            marker = bold_accent("●") if p.running else dimmed("○")
+            name = f"{p.number}. {p.email}" + (f" ({p.alias})" if p.alias else "")
+            if p.running:
+                state = accent("open") + dimmed(f"  PID {', '.join(map(str, p.pids))}")
+            elif p.exists:
+                state = muted("closed")
+            else:
+                state = dimmed("never opened")
+            print(f"  {marker} {name}  {state}")
+        print()
+        print(dimmed(
+            "cswap desktop <num|email> opens an account's window; "
+            "--all opens every account; --quit closes them."
+        ))
+
+    # -- shared state ------------------------------------------------------
+
+    def sync_shared_state(self, data_dir: Path) -> None:
+        """Link (or unlink) the stock profile's per-account state into
+        ``data_dir`` according to ``desktop.shareSessions``.
+
+        Only called while no window uses ``data_dir``: merging moves files
+        out from under a running app. With sharing on, a real directory the
+        profile accumulated is merged into the stock copy first (identical
+        files dropped, differing ones set aside under ``history-conflicts/``,
+        nothing lost), then replaced by a symlink; a symlink elsewhere is
+        repointed. With sharing off, a symlink is removed and the app grows
+        a private directory again. Not on Windows, where a symlink needs a
+        privilege the user may not have; the profile stays private there.
+        """
+        from claude_swap.settings import load_desktop_settings
+
+        share = load_desktop_settings(self.switcher.backup_dir).share_sessions
+        if self.platform == Platform.WINDOWS:
+            return
+        stock = default_user_data_dir(self.platform)
+        for name in SHARED_STATE_ITEMS:
+            dest = data_dir / name
+            src = stock / name
+            if not share:
+                if dest.is_symlink():
+                    dest.unlink()
+                continue
+            if dest.is_symlink():
+                if self._points_at(dest, src):
+                    continue
+                dest.unlink()
+            elif dest.is_dir():
+                conflicts = (
+                    self.switcher.backup_dir / "history-conflicts"
+                    / f"desktop-{data_dir.name}" / time.strftime("%Y%m%dT%H%M%S")
+                )
+                try:
+                    set_aside = self._merge_into(src, dest, conflicts)
+                except OSError as exc:
+                    print(dimmed(
+                        f"  not sharing {name}: merging the profile's copy "
+                        f"failed ({exc})"
+                    ))
+                    continue
+                print(dimmed(f"  merged the profile's {name} into {src}"))
+                if set_aside:
+                    print(dimmed(
+                        f"  {set_aside} file(s) in {name} differed from the "
+                        f"shared copy; kept under {conflicts}"
+                    ))
+            elif dest.exists():
+                dest.unlink()
+            try:
+                self._mkdir_private(src)
+                dest.symlink_to(src, target_is_directory=True)
+            except OSError as exc:
+                print(dimmed(f"  not sharing {name}: {exc}"))
+
+    @staticmethod
+    def _points_at(link: Path, target: Path) -> bool:
+        try:
+            return Path(os.readlink(link)) == target
+        except OSError:
+            return False
+
+    @staticmethod
+    def _merge_into(src: Path, dest: Path, conflicts: Path) -> int:
+        from claude_swap.session import SessionManager
+
+        return SessionManager._merge_history_into_source(src, dest, conflicts)
+
+    # -- lifecycle hooks used by the switcher ------------------------------
+
+    def ensure_closed(self, account_num: str, email: str, action: str) -> None:
+        """Refuse ``action`` while the account's window is open."""
+        pids = running_pids(self.data_dir(account_num, email), self.platform)
+        if pids:
+            raise SessionError(
+                f"Claude Desktop is open for account {account_num} ({email}), "
+                f"PID {', '.join(map(str, pids))}. Close it first "
+                f"('cswap desktop --quit {account_num}'), then retry {action}."
+            )
+
+    def delete_profile(self, account_num: str, email: str) -> None:
+        """Remove the account's profile directory; the login goes with it."""
+        data_dir = self.data_dir(account_num, email)
+        if data_dir.exists():
+            shutil.rmtree(data_dir, ignore_errors=True)
+
+    def open_profile_dirs(self) -> dict[str, list[int]]:
+        """``{dir name: pids}`` for every profile with a window open, by
+        scanning ``desktop/`` itself so a profile whose account is gone
+        still counts."""
+        root = self.switcher.backup_dir / DESKTOP_DIRNAME
+        if not root.is_dir():
+            return {}
+        live = {}
+        for d in sorted(root.iterdir()):
+            if not d.is_dir():
+                continue
+            pids = running_pids(d, self.platform)
+            if pids:
+                live[d.name] = pids
+        return live
+
+    @staticmethod
+    def _mkdir_private(path: Path) -> None:
+        path.mkdir(parents=True, exist_ok=True)
+        if sys.platform != "win32":
+            os.chmod(path, 0o700)
+
