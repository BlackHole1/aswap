+    @pytest.mark.skipif(sys.platform == "win32", reason="pgrep is POSIX")
+    def test_matches_the_whole_token_through_the_real_pgrep(self, tmp_path):
+        """Run the pattern through the system ``pgrep``, not Python's ``re``:
+        the two dialects differ, and BSD ``pgrep`` (macOS) has no ``\\s``,
+        so a pattern that only ever met ``re`` matched nothing there."""
+        data_dir = tmp_path / "2-a"
+        sleeper = "import time; time.sleep(30)"
+        procs = [
+            subprocess.Popen(
+                [sys.executable, "-c", sleeper, f"--user-data-dir={dir_}", *rest],
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+            )
+            for dir_, rest in (
+                (data_dir, []),
+                (data_dir, ["--type=renderer"]),
+                (str(data_dir) + "b", []),
+            )
+        ]
+        try:
+            platform = Platform.MACOS if sys.platform == "darwin" else Platform.LINUX
+            found = desktop.running_pids(data_dir, platform)
+        finally:
+            for proc in procs:
+                proc.kill()
+                proc.wait()
+        assert sorted(found) == sorted(p.pid for p in procs[:2])
+
+    def test_unknowable_reads_as_not_running(self, tmp_path):
+        with patch.object(desktop.subprocess, "run", side_effect=OSError("no pgrep")):
+            assert desktop.running_pids(tmp_path, Platform.LINUX) == []
+
+    def test_strict_refuses_to_read_a_failed_check_as_closed(self, tmp_path):
+        with patch.object(desktop.subprocess, "run", side_effect=OSError("no pgrep")):
+            with pytest.raises(SessionError, match="Could not tell"):
+                desktop.running_pids(tmp_path, Platform.LINUX, strict=True)
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(stdout="", stderr="bad regex", returncode=2)
+            with pytest.raises(SessionError, match="bad regex"):
+                desktop.running_pids(tmp_path, Platform.LINUX, strict=True)
+            assert desktop.running_pids(tmp_path, Platform.LINUX) == []
+
+    def test_strict_accepts_pgrep_matching_nothing(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(stdout="", stderr="", returncode=1)
+            assert desktop.running_pids(tmp_path, Platform.LINUX, strict=True) == []
+
+    def test_windows_asks_cim_for_the_command_line(self, tmp_path):
+        with patch.object(desktop.subprocess, "run") as run:
+            run.return_value = MagicMock(stdout="4242\r\n")
+            assert desktop.running_pids(tmp_path / "1-a", Platform.WINDOWS) == [4242]
+        argv = run.call_args.args[0]
+        assert argv[0] == "powershell"
+        script = argv[-1]
+        assert f"--user-data-dir={tmp_path / '1-a'}" in script
+        # The query's own PowerShell carries the needle: it must skip itself,
+        # and match the whole token, not a substring.
+        assert "$_.ProcessId -ne $PID" in script
+        assert "-cmatch $p" in script and "'(\\s|\\x22|$)'" in script
+        assert '"' not in script
