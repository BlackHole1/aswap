+@dataclass(frozen=True)
+class DesktopProfile:
+    """One account's Claude Desktop profile as ``cswap desktop`` lists it."""
+
+    number: str
+    email: str
+    alias: str
+    data_dir: Path
+    exists: bool  # opened at least once
+    pids: tuple[int, ...]
+
+    @property
+    def running(self) -> bool:
+        return bool(self.pids)
+
+
+class DesktopManager:
+    """Opens, lists and quits per-account Claude Desktop windows."""
+
+    def __init__(self, switcher: ClaudeAccountSwitcher):
+        self.switcher = switcher
+        self.platform = switcher.platform
+        self._app: Path | None = None
+
+    # -- resolution --------------------------------------------------------
+
+    def data_dir(self, account_num: str, email: str) -> Path:
+        return desktop_dir_for(self.switcher.backup_dir, account_num, email)
+
+    def app(self) -> Path:
+        if self._app is None:
+            from claude_swap.settings import load_desktop_settings
+
+            configured = load_desktop_settings(self.switcher.backup_dir).app_path
+            self._app = find_app(configured, self.platform)
+        return self._app
+
+    def profiles(self) -> list[DesktopProfile]:
+        """Every stored account with its profile state, in slot order."""
+        data = self.switcher._get_sequence_data() or {}
+        accounts = data.get("accounts", {})
+        rows = []
+        for number in sorted(accounts, key=lambda n: int(n) if n.isdigit() else 0):
+            record = accounts[number]
+            email = record.get("email", "")
+            data_dir = self.data_dir(number, email)
+            rows.append(DesktopProfile(
+                number=number,
+                email=email,
+                alias=record.get("alias", "") or "",
+                data_dir=data_dir,
+                exists=data_dir.is_dir(),
+                pids=tuple(running_pids(data_dir, self.platform)),
+            ))
+        return rows
+
+    def _targets(self, identifiers: list[str], all_accounts: bool) -> list[tuple[str, str] | None]:
+        """(number, email) per requested account; unknown ones are reported
+        and skipped so the rest still open."""
+        if all_accounts:
+            return [(p.number, p.email) for p in self.profiles()]
+        targets: list[tuple[str, str] | None] = []
+        for ident in identifiers:
+            try:
+                number, email, _ = self.switcher.resolve_account(ident)
+            except AccountNotFoundError:
+                error(f"  {ident}: account not found")
+                targets.append(None)
+                continue
+            targets.append((number, email))
+        return targets
+
+    def _account_uuid(self, number: str) -> str:
+        data = self.switcher._get_sequence_data() or {}
+        return str(data.get("accounts", {}).get(number, {}).get("uuid", "") or "")
+
+    def warn_if_stock_login(self, number: str) -> bool:
+        """Say so when the account is also signed in in a stock Claude window
+        that is open right now.
+
+        Both windows then share the same session files, but each keeps its
+        own copy in memory: nothing syncs live, their writes overwrite each
+        other, and only a reload (Cmd+R) rereads a window from disk. Returns
+        True when it warned.
+        """
+        uuid = self._account_uuid(number)
+        if not uuid:
+            return False
+        stock = default_user_data_dir(self.platform)
+        if stock_account_uuid(stock) != uuid:
+            return False
+        if not stock_instance_running(self.app(), self.platform):
+            return False
+        warning(
+            "     also signed in in the stock Claude window: sessions do not "
+            "sync live between the two windows and their writes overwrite each "
+            "other. To sync, reload a window (Cmd+R) to reread from disk."
+        )
+        return True
+
+    # -- commands ----------------------------------------------------------
+
+    def open(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Open (or bring forward) the windows of the given accounts.
+
+        Returns 1 when any requested account could not be opened.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        if not targets:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return 0
+        app = self.app()
+        failed = any(t is None for t in targets)
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            label = f"{number}. {email}"
+            if running_pids(data_dir, self.platform):
+                activate(app, self.platform)
+                print(f"  {label} {dimmed('already open, brought to the front')}")
+                continue
+            first_time = not data_dir.is_dir()
+            self._mkdir_private(data_dir)
+            self.sync_shared_state(data_dir)
+            try:
+                launch(app, data_dir, self.platform)
+            except SessionError as exc:
+                error(f"  {label}: {exc}")
+                failed = True
+                continue
+            if first_time:
+                print(
+                    f"  {label} {accent('opening a fresh window')}; sign in to "
+                    "this account there, once. It stays signed in."
+                )
+            else:
+                print(f"  {label} {accent('opening')}")
+            self.warn_if_stock_login(number)
+        return 1 if failed else 0
+
+    def quit(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Close the given accounts' windows. Returns 1 for an unknown account.
+
+        ``--all`` also sweeps ``desktop/`` itself, so a profile whose account
+        slot is gone (the one ``purge`` reports) is closed too.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        failed = any(t is None for t in targets)
+        seen: set[str] = set()
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            seen.add(data_dir.name)
+            if quit_instance(data_dir, platform=self.platform):
+                print(f"  {number}. {email} {accent('closed')}")
+            else:
+                print(f"  {number}. {email} {dimmed('not open')}")
+        if all_accounts:
+            root = self.switcher.backup_dir / DESKTOP_DIRNAME
+            for name in sorted(self.open_profile_dirs()):
+                if name in seen:
+                    continue
+                if quit_instance(root / name, platform=self.platform):
+                    print(f"  {name} {accent('closed')} {dimmed('(no account slot)')}")
+        return 1 if failed else 0
+
+    def show(self) -> None:
+        """List every account's profile: open, signed in once, or never opened."""
+        rows = self.profiles()
+        if not rows:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return
+        print(bold_accent("Claude Desktop profiles:"))
+        for p in rows:
+            marker = bold_accent("●") if p.running else dimmed("○")
+            name = f"{p.number}. {p.email}" + (f" ({p.alias})" if p.alias else "")
+            if p.running:
+                state = accent("open") + dimmed(f"  PID {', '.join(map(str, p.pids))}")
+            elif p.exists:
+                state = muted("closed")
+            else:
+                state = dimmed("never opened")
+            print(f"  {marker} {name}  {state}")
+        print()
+        print(dimmed(
+            "cswap desktop <num|email> opens an account's window; "
+            "--all opens every account; --quit closes them."
+        ))
+
+    # -- shared state ------------------------------------------------------
+
+    def sync_shared_state(self, data_dir: Path) -> None:
+        """Link (or unlink) the stock profile's per-account state into
+        ``data_dir`` according to ``desktop.shareSessions``.
+
+        Only called while no window uses ``data_dir``: merging moves files
+        out from under a running app. With sharing on, a real directory the
+        profile accumulated is merged into the stock copy first (identical
+        files dropped, differing ones set aside under ``history-conflicts/``,
+        nothing lost), then replaced by a symlink; a symlink elsewhere is
+        repointed. With sharing off, a symlink is removed and the app grows
+        a private directory again. Not on Windows, where a symlink needs a
+        privilege the user may not have; the profile stays private there.
+        """
+        from claude_swap.settings import load_desktop_settings
+
+        share = load_desktop_settings(self.switcher.backup_dir).share_sessions
+        if self.platform == Platform.WINDOWS:
+            return
+        stock = default_user_data_dir(self.platform)
+        for name in SHARED_STATE_ITEMS:
+            dest = data_dir / name
+            src = stock / name
+            if not share:
+                if dest.is_symlink():
+                    dest.unlink()
+                continue
+            if dest.is_symlink():
+                if self._points_at(dest, src):
+                    continue
+                dest.unlink()
+            elif dest.is_dir():
+                # The time, for reading, plus a random suffix, so two merges
+                # in the same second never share a directory.
+                run = f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
+                conflicts = (
+                    self.switcher.backup_dir / QUARANTINE_DIRNAME
+                    / f"desktop-{data_dir.name}" / run
+                )
+                try:
+                    set_aside = self._merge_into(src, dest, conflicts)
+                except OSError as exc:
+                    print(dimmed(
+                        f"  not sharing {name}: merging the profile's copy "
+                        f"failed ({exc})"
+                    ))
+                    continue
+                print(dimmed(f"  merged the profile's {name} into {src}"))
+                if set_aside:
+                    print(dimmed(
+                        f"  {set_aside} file(s) in {name} differed from the "
+                        f"shared copy; kept under {conflicts}"
+                    ))
+            elif dest.exists():
+                dest.unlink()
+            try:
+                self._mkdir_private(src)
+                dest.symlink_to(src, target_is_directory=True)
+            except OSError as exc:
+                print(dimmed(f"  not sharing {name}: {exc}"))
+
+    @staticmethod
+    def _points_at(link: Path, target: Path) -> bool:
+        try:
+            return Path(os.readlink(link)) == target
+        except OSError:
+            return False
+
+    @classmethod
+    def _merge_into(cls, src: Path, dest: Path, conflicts: Path) -> int:
+        """Move the profile's own directory at ``dest`` into ``src``.
+
+        File by file. A file that already exists under ``src`` is dropped
+        only when both copies are byte-identical; a differing copy is moved
+        to ``conflicts/<dest.name>/<relative path>``, so the stock copy is
+        never overwritten and the profile's copy is never lost. ``dest`` is
+        removed once empty; an OSError propagates and leaves the remaining
+        files in place for the next try. Returns how many files were set
+        aside.
+
+        Not ``SessionManager``'s history merge: that one decides between two
+        Claude Code transcripts by their timestamps and by which sessions are
+        live in ``~/.claude``, neither of which means anything for the
+        desktop app's state files.
+        """
+        set_aside = 0
+        cls._mkdir_private(src)
+        for path in sorted(dest.rglob("*"), reverse=True):
+            rel = path.relative_to(dest)
+            target = src / rel
+            if path.is_dir() and not path.is_symlink():
+                path.rmdir()  # children already moved (reverse walk)
+                continue
+            if target.exists():
+                if filecmp.cmp(str(path), str(target), shallow=False):
+                    path.unlink()
+                    continue
+                target = conflicts / dest.name / rel
+                set_aside += 1
+            cls._mkdir_private(target.parent)
+            shutil.move(str(path), str(target))
+        dest.rmdir()
+        return set_aside
+
+    # -- lifecycle hooks used by the switcher ------------------------------
+
+    def ensure_closed(self, account_num: str, email: str, action: str) -> None:
+        """Refuse ``action`` while the account's window is open, or while
+        a failed process check leaves that unknown."""
+        data_dir = self.data_dir(account_num, email)
+        if not data_dir.exists():
+            return  # no profile, nothing to pull out from under a process
+        pids = running_pids(data_dir, self.platform, strict=True)
+        if pids:
+            raise SessionError(
+                f"Claude Desktop is open for account {account_num} ({email}), "
+                f"PID {', '.join(map(str, pids))}. Close it first "
+                f"('cswap desktop --quit {account_num}'), then retry {action}."
+            )
+
+    def relocate_profiles(self, moves: list[tuple[str, str, str]]) -> None:
+        """Take profiles along to new slot numbers, one ``(old number, new
+        number, email)`` per account that moves. Only called once
+        :meth:`ensure_closed` passed for each of them."""
+        relocate_profile_dirs(
+            [
+                (self.data_dir(old, email), self.data_dir(new, email))
+                for old, new, email in moves
+            ],
+            "Claude Desktop",
+        )
+
+    def delete_profile(self, account_num: str, email: str) -> None:
+        """Remove the account's profile directory; the login goes with it."""
+        data_dir = self.data_dir(account_num, email)
+        if data_dir.exists():
+            try:
+                shutil.rmtree(data_dir)
+            except OSError as exc:
+                raise SessionError(
+                    f"Could not remove the Claude Desktop profile {data_dir}: {exc}"
+                ) from exc
+
+    def open_profile_dirs(self, *, strict: bool = False) -> dict[str, list[int]]:
+        """``{dir name: pids}`` for every profile with a window open, by
+        scanning ``desktop/`` itself so a profile whose account is gone
+        still counts. ``strict`` raises on a failed check, as in
+        ``running_pids``."""
+        root = self.switcher.backup_dir / DESKTOP_DIRNAME
+        if not root.is_dir():
+            return {}
+        live = {}
+        for d in sorted(root.iterdir()):
+            if not d.is_dir():
+                continue
+            pids = running_pids(d, self.platform, strict=strict)
+            if pids:
+                live[d.name] = pids
+        return live
+
+    @staticmethod
+    def _mkdir_private(path: Path) -> None:
+        path.mkdir(parents=True, exist_ok=True)
+        if sys.platform != "win32":
+            os.chmod(path, 0o700)
+
