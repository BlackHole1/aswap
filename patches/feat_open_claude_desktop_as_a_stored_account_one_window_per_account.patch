+        assert "--quit needs an account or --all" in capsys.readouterr().err
+
+    def test_config_error_exits_one(self, temp_home, capsys):
+        with patch("claude_swap.cli.ClaudeAccountSwitcher"), \
+             patch("claude_swap.cli._guard_root"), \
+             patch("claude_swap.desktop.DesktopManager") as cls:
+            cls.return_value.open.side_effect = ConfigError("Claude Desktop not found")
+            with pytest.raises(SystemExit) as exc:
+                cli._desktop_command(["1"])
+        assert exc.value.code == 1
+        assert "Claude Desktop not found" in _plain(capsys.readouterr().err)
+
+    def test_listed_in_help(self, temp_home, capsys):
+        with patch.object(sys, "argv", ["claude-swap", "--help"]), \
+             pytest.raises(SystemExit):
+            cli.main()
+        out = capsys.readouterr().out
+        assert "desktop <num|email ...>" in out
+        assert "desktop --quit <num|email>" in out
