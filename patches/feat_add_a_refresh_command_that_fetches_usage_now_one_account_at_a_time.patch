diff --git a/tests/test_refresh_command.py b/tests/test_refresh_command.py
new file mode 100644
index 0000000000000000000000000000000000000000..518e55182c63c0ec6a354f14271a8e3e6a4febd1
--- /dev/null
+++ b/tests/test_refresh_command.py
@@ -0,0 +1,157 @@
+"""``cswap refresh``: fetch usage on demand, one account at a time.
+
+``list`` serves a cached measurement while an account is fresh, not poll-due,
+or backing off after a failure. After a usage-endpoint 429 that backoff is an
+hour or more, and nothing lets the user ask again. ``refresh`` bypasses those
+gates, keeps every account's fetch independent, and reports a rate-limited
+account's server-side ``Retry-After`` deadline.
+"""
+
+import json
+import re
+import sys
+import time
+from unittest.mock import patch
+
+import pytest
+
+from claude_swap import cli
+from claude_swap.json_output import USAGE_RELOGIN_REQUIRED
+from claude_swap.switcher import ClaudeAccountSwitcher
+from claude_swap.usage_store import FetchRecord
+
+USAGE_1 = {"five_hour": {"pct": 40.0}, "seven_day": {"pct": 10.0}}
+USAGE_2 = {"five_hour": {"pct": 90.0}, "seven_day": {"pct": 60.0}}
+
+
+def _creds(tag: str) -> str:
+    return json.dumps({"claudeAiOauth": {
+        "accessToken": f"at-{tag}", "refreshToken": f"rt-{tag}",
+        "expiresAt": int((time.time() + 3600) * 1000),
+    }})
+
+
+INFOS = [
+    (1, "account1@example.com", "", "", True, _creds("1"), ""),
+    (2, "account2@example.com", "", "", False, _creds("2"), ""),
+]
+
+
+@pytest.fixture
+def switcher(temp_home, sample_sequence_data):
+    sw = ClaudeAccountSwitcher()
+    sw._setup_directories()
+    sw._write_json(sw.sequence_file, sample_sequence_data)
+    return sw
+
+
+def _run(sw, outcomes: dict[str, FetchRecord], identifiers=None, capsys=None):
+    """Run ``refresh_usage`` with canned per-account fetch outcomes; returns
+    ``(exit_code, output, fetched slot numbers)``."""
+    fetched: list[str] = []
+
+    def fetch(info, rejected_fp=None):
+        fetched.append(str(info[0]))
+        return outcomes[str(info[0])]
+
+    with patch.object(sw, "_build_accounts_info", return_value=list(INFOS)), \
+         patch.object(sw, "_fetch_account_usage", side_effect=fetch):
+        code = sw.refresh_usage(identifiers)
+    captured = capsys.readouterr() if capsys else None
+    text = (captured.out + captured.err) if captured else ""
+    return code, re.sub(r"\x1b\[[0-9;]*m", "", text), fetched
+
+
+class TestRefresh:
+    def test_fetches_past_the_serve_ttl_and_a_429_backoff(self, switcher, capsys):
+        """A fresh measurement and an hour-long 429 backoff both gate ``list``;
+        neither gates ``refresh``."""
+        code, _, fetched = _run(switcher, {
+            "1": FetchRecord(usage=USAGE_1),
+            "2": FetchRecord(error="http-429", retry_after_s=3600.0),
+        }, capsys=capsys)
+        assert code == 1 and fetched == ["1", "2"]
+        entries = switcher._usage_store.entries(
+            {"1": ("account1@example.com", ""), "2": ("account2@example.com", "")}
+        )
+        assert entries["1"].fresh(time.time())
+        assert entries["2"].in_backoff(time.time())
+        # Right away again: slot 1 is fresh, slot 2 is backing off.
+        code, _, fetched = _run(switcher, {
+            "1": FetchRecord(usage=USAGE_1),
+            "2": FetchRecord(usage=USAGE_2),
+        }, capsys=capsys)
+        assert code == 0 and fetched == ["1", "2"]
+
+    def test_one_accounts_429_does_not_block_the_other(self, switcher, capsys):
+        code, out, _ = _run(switcher, {
+            "1": FetchRecord(error="http-429", retry_after_s=1800.0),
+            "2": FetchRecord(usage=USAGE_2),
+        }, capsys=capsys)
+        assert code == 1
+        one, two = out.split("  2: ")
+        assert "rate limited (HTTP 429)" in one
+        assert "the server allows a retry after" in one
+        assert re.search(r"\(in (29|30)m\)", one)
+        assert "90%" in two and "429" not in two
+
+    def test_429_without_retry_after_reports_the_local_backoff(self, switcher, capsys):
+        _, out, _ = _run(switcher, {
+            "1": FetchRecord(error="http-429"),
+            "2": FetchRecord(usage=USAGE_2),
+        }, capsys=capsys)
+        assert "no Retry-After from the server; backing off until" in out
+
+    def test_failure_keeps_serving_the_last_measurement(self, switcher, capsys):
+        _run(switcher, {"1": FetchRecord(usage=USAGE_1),
+                        "2": FetchRecord(usage=USAGE_2)}, capsys=capsys)
+        _, out, _ = _run(switcher, {
+            "1": FetchRecord(error="timeout"),
+            "2": FetchRecord(usage=USAGE_2),
+        }, capsys=capsys)
+        assert "refresh failed (timeout)" in out
+        assert "last seen 40% used" in out
+
+    def test_selects_by_number_alias_or_email(self, switcher, capsys):
+        outcomes = {"1": FetchRecord(usage=USAGE_1), "2": FetchRecord(usage=USAGE_2)}
+        _, out, fetched = _run(switcher, outcomes, ["2"], capsys=capsys)
+        assert fetched == ["2"] and "  1: " not in out
+        _, _, fetched = _run(switcher, outcomes, ["account1@example.com", "2"], capsys=capsys)
+        assert fetched == ["1", "2"]
+
+    def test_unknown_account_is_an_error(self, switcher, capsys):
+        code, out, fetched = _run(switcher, {}, ["nobody@example.com"], capsys=capsys)
+        assert code == 1 and fetched == []
+        assert "account not found: nobody@example.com" in out
+
+    def test_dead_token_is_reported_not_fetched(self, switcher, capsys):
+        store = switcher._usage_store
+        ident = {"1": ("account1@example.com", ""), "2": ("account2@example.com", "")}
+        claims = store.reserve(["1"], ident, respect_plans=False)
+        store.record({"1": FetchRecord(error="invalid_grant", struck_fp=None)}, ident, claims)
+        code, out, fetched = _run(switcher, {"2": FetchRecord(usage=USAGE_2)}, capsys=capsys)
+        assert code == 1 and fetched == ["2"]
+        assert "re-login needed" in out
+
+
+class TestRefreshCli:
+    def test_dispatched_from_main(self, temp_home):
+        with patch("claude_swap.cli._refresh_command") as fn, \
+             patch.object(sys, "argv", ["claude-swap", "refresh", "2"]):
+            cli.main()
+        fn.assert_called_once_with(["2"])
+
+    def test_exit_code_follows_the_switcher(self, temp_home):
+        with patch("claude_swap.cli.ClaudeAccountSwitcher") as cls, \
+             patch("claude_swap.cli._guard_root"):
+            cls.return_value.refresh_usage.return_value = 1
+            with pytest.raises(SystemExit) as exc:
+                cli._refresh_command(["1", "--debug"])
+        assert exc.value.code == 1
+        cls.return_value.refresh_usage.assert_called_once_with(["1"])
+
+    def test_listed_in_help(self, temp_home, capsys):
+        with patch.object(sys, "argv", ["claude-swap", "--help"]), \
+             pytest.raises(SystemExit):
+            cli.main()
+        assert "refresh [num|email ...]" in capsys.readouterr().out
