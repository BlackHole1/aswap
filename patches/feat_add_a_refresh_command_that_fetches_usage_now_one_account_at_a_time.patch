+    def test_force_ignores_freshness_plan_and_backoff(self, store, clock):
+        """``cswap refresh``: fresh, not-yet-due, and backing-off rows are all
+        fetchable on demand; the row still gets a fencing claim."""
+        store.record({"1": FetchRecord(usage=USAGE)}, IDENT)
+        store.set_poll_plan({"1": (clock.now + 86_400.0, 300.0)}, IDENT)
+        clock.advance(CLAIM_TTL_S + 1)  # claim expired; fresh and not due
+        assert store.reserve(["1"], IDENT, respect_plans=True) == {}
+        claims = store.reserve(["1"], IDENT, respect_plans=False, force=True)
+        assert set(claims) == {"1"}
+        store.record({"1": FetchRecord(error="http-429", retry_after_s=3600.0)},
+                     IDENT, claims)
+        clock.advance(CLAIM_TTL_S + 1)  # inside the hour-long 429 backoff
+        assert store.reserve(["1"], IDENT, respect_plans=False) == {}
+        assert set(store.reserve(["1"], IDENT, respect_plans=False, force=True)) == {"1"}
+
+    def test_force_still_respects_dead_token_and_live_claim(self, store, clock):
+        store.record({"1": FetchRecord(error="invalid_grant")}, IDENT)
+        clock.advance(TRUST_MAX_AGE_S)
+        assert store.reserve(["1"], IDENT, respect_plans=False, force=True) == {}
+        # Another collector's live lease on slot 2 is never stolen.
+        assert set(store.reserve(["2"], IDENT, respect_plans=True)) == {"2"}
+        assert store.reserve(["2"], IDENT, respect_plans=False, force=True) == {}
+
     def test_unknown_row_and_identity_mismatch_win(self, store, clock):
         assert set(store.reserve(["1"], IDENT, respect_plans=True)) == {"1"}
         # Slot reused by a different account: the old row is invisible and
