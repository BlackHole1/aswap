+def _deadline_note(ts: float) -> str:
+    """"02:07 (in 52m)" for an absolute epoch deadline, in local time."""
+    from datetime import datetime, timezone
+
+    countdown, clock = oauth.format_reset(
+        datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()
+    )
+    return f"{clock} (in {countdown})"
+
+
+def _refresh_outcome_lines(
+    entry: UsageEntry, record: FetchRecord | None
+) -> tuple[list[str], bool]:
+    """Styled lines for one account after a forced refresh, and whether the
+    refresh succeeded.
+
+    A fresh measurement renders exactly like ``list``. A failure names its
+    cause and, for a 429, the server's ``Retry-After`` deadline (the local
+    backoff when the server sent none), then the last measurement it keeps
+    serving. No record means the store did not hand us the slot: a dead
+    token or a static state shows as its sentinel, otherwise another cswap
+    process holds the fetch lease this instant.
+    """
+    if record is not None and record.error is None and record.sentinel is None:
+        return _usage_entry_lines(entry), True
+    if record is None and entry.sentinel is None:
+        headline = "not refreshed — another cswap process is fetching this account; run again in a moment"
+    elif record is None or record.sentinel is not None:
+        sentinel = entry.sentinel or record.sentinel or ""
+        headline = SENTINEL_NOTES.get(sentinel, sentinel)
+    elif record.error == "http-429":
+        if record.retry_after_s is not None:
+            deadline = _deadline_note(time.time() + record.retry_after_s)
+            headline = f"rate limited (HTTP 429) — the server allows a retry after {deadline}"
+        elif entry.backoff_until is not None:
+            headline = (
+                "rate limited (HTTP 429) — no Retry-After from the server; "
+                f"backing off until {_deadline_note(entry.backoff_until)}"
+            )
+        else:
+            headline = "rate limited (HTTP 429)"
+    else:
+        headline = f"refresh failed ({ERROR_NOTES.get(record.error, record.error)})"
+    out = [yellowed(headline)]
+    last_seen = last_seen_note(entry)
+    if last_seen is not None:
+        out.append(f"{dimmed('└')} {muted(last_seen)}")
+    return out, False
+
