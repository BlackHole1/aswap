+def _refresh_command(argv: list[str]) -> None:
+    """Handle `cswap refresh [num|email ...]` — fetch usage now.
+
+    `list` serves the cached measurement while an account is fresh, not yet
+    poll-due, or in a failure backoff; after a 429 that is an hour of stale
+    numbers with nothing to do about it. This fetches the given accounts
+    (default all) unconditionally, each on its own, and reports a
+    rate-limited account's server-side Retry-After deadline.
+    """
+    parser = argparse.ArgumentParser(
+        prog=f"{_prog_name()} refresh",
+        description=(
+            "Fetch usage for the given accounts (default: all) right now, "
+            "ignoring the poll schedule and any failure backoff. Accounts "
+            "are refreshed independently; a rate-limited one reports when "
+            "the server allows a retry. Exits 1 if any account could not "
+            "be refreshed."
+        ),
+    )
+    parser.add_argument(
+        "accounts",
+        nargs="*",
+        metavar="num|email",
+        help="Accounts to refresh (number, alias or email); default: all",
+    )
+    parser.add_argument("--debug", action="store_true", help="Enable debug logging")
+    args = parser.parse_args(argv)
+
+    try:
+        switcher = ClaudeAccountSwitcher(debug=args.debug)
+        _guard_root(switcher)
+        code = switcher.refresh_usage(args.accounts)
+    except ClaudeSwitchError as e:
+        error(f"Error: {e}")
+        sys.exit(1)
+    if code:
+        sys.exit(code)
+
+
