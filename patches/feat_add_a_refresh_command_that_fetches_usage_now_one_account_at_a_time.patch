+        """
+        if not self.sequence_file.exists():
+            print(dimmed("No accounts are managed yet."))
+            return 1
+        accounts_info = self._build_accounts_info()
+        by_num = {str(info[0]): info for info in accounts_info}
+        if identifiers:
+            selected: list[str] = []
+            for ident in identifiers:
+                num = self._resolve_account_identifier(ident)
+                if num is None or num not in by_num:
+                    error(f"Error: account not found: {ident}")
+                    return 1
+                if num not in selected:
+                    selected.append(num)
+        else:
+            selected = list(by_num)
+        infos = [by_num[num] for num in selected]
+
+        records: dict[str, FetchRecord] = {}
+        entries = self._collect_usage_entries(
+            infos, fetch=set(selected), force=True, records_out=records
+        )
+        failed = 0
+        print(bolded("Accounts:"))
+        for i, num in enumerate(selected):
+            _n, email, org_name, org_uuid, is_active, _c, alias = by_num[num]
+            tag = self._get_display_tag(email, org_name, org_uuid)
+            label = f"{accent(alias)} ({email})" if alias else email
+            marker = f" {bold_accent('(active)')}" if is_active else ""
+            print(f"  {num}: {label} {muted(f'[{tag}]')}{marker}")
+            lines, ok = _refresh_outcome_lines(entries[num], records.get(num))
+            failed += 0 if ok else 1
+            for line in lines:
+                print(f"     {line}")
+            if i < len(selected) - 1:
+                print()
+        return 1 if failed else 0
