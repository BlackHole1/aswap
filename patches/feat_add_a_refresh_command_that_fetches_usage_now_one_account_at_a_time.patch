+    def refresh_usage(self, identifiers: list[str] | None = None) -> int:
+        """``cswap refresh [num|email ...]``: fetch usage for the given accounts
+        (default: all) right now, and say per account what came back.
+
+        ``list`` serves the cached measurement while an account is inside
+        the serve TTL, its poll plan, or a failure backoff — after a 429 that
+        is an hour or more of "· 1h ago" with no way to ask again. This
+        bypasses all three gates (``UsageStore.reserve(force=True)``) but
