+"""Chrome with Claude in Chrome, one browser profile per stored account.
+
+``cswap switch`` moves Claude Code to another account, but the Claude in
+Chrome extension keeps working as whoever is signed in to claude.ai in
+the browser. The two never share a credential: Claude Code holds an OAuth
+pair in the credential store, the extension rides the claude.ai session
+cookie in Chrome's cookie jar, per Chrome profile. Neither can be derived
+from the other, and the cookie jar is encrypted per user and per browser,
+so swapping cookies inside one profile would mean decrypting Chrome's
+storage and rewriting another extension's account state from outside.
+
+What Chrome does honor is ``--user-data-dir``: a separate profile
+directory is a separate, independently signed-in browser with its own
+extensions. This module gives every stored account a permanent Chrome
+profile under ``<backup>/chrome/<num>-<email slug>/`` and opens the
+browser against it. The first open shows the Web Store page for the
+extension and claude.ai; the user installs the extension and signs in to
+that account there, once, and both stay put. Nothing here reads, copies or
+migrates a login: Chrome owns everything inside the profile.
+
+Chrome keeps one process singleton per profile directory, so a second
+launch with the same ``--user-data-dir`` hands its URLs to the running
+browser and exits: that is how an open account is brought forward. The
+profile is found again by the exact ``--user-data-dir=<dir>`` token on the
+command line, the same way ``cswap desktop`` finds Claude Desktop windows;
+the process helpers are shared with that module. The extension runs in
+any Chromium browser, so ``chrome.appPath`` may point at Edge, Brave or
+Chromium instead of Chrome.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from claude_swap.desktop import (
+    USER_DATA_FLAG,
+    quit_instance,
+    running_pids,
+    stock_instance_running,
+)
+from claude_swap.exceptions import AccountNotFoundError, ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.printer import accent, bold_accent, dimmed, error, muted
+from claude_swap.session import slugify_email
+
+if TYPE_CHECKING:
+    from claude_swap.switcher import ClaudeAccountSwitcher
+
+CHROME_DIRNAME = "chrome"
+
+# The official extension, "Claude" by Anthropic, on the Chrome Web Store.
+CLAUDE_EXTENSION_ID = "fcoeoabgfenejglbffodgkkbkcdhcgfn"
+EXTENSION_URL = f"https://chromewebstore.google.com/detail/claude/{CLAUDE_EXTENSION_ID}"
+CLAUDE_URL = "https://claude.ai/"
+
+# A fresh profile otherwise greets the user with Chrome's first-run flow
+# and a default-browser prompt on every account.
+LAUNCH_FLAGS: tuple[str, ...] = ("--no-first-run", "--no-default-browser-check")
+
+_LINUX_NAMES: tuple[str, ...] = (
+    "google-chrome",
+    "google-chrome-stable",
+    "chromium",
+    "chromium-browser",
+)
+
+# Profile state that is either a cache Chrome rebuilds, a lock of the
+# running browser, or the open-tabs snapshot: none of it belongs in a copy.
+CLONE_SKIP_DIRS: frozenset[str] = frozenset({
+    "Cache", "Code Cache", "GPUCache", "DawnCache", "DawnGraphiteCache",
+    "DawnWebGPUCache", "GrShaderCache", "ShaderCache", "Service Worker",
+    "Sessions", "Session Storage", "blob_storage", "Crashpad",
+    "optimization_guide_prediction_model_downloads", "Download Service",
+    "Safe Browsing Network", "Segmentation Platform",
+    "Site Characteristics Database",
+})
+CLONE_SKIP_FILES: frozenset[str] = frozenset({
+    "SingletonLock", "SingletonSocket", "SingletonCookie", "lockfile",
+    "LOCK", "LOG", "LOG.old", "Current Session", "Current Tabs",
+    "Last Session", "Last Tabs", ".DS_Store",
+})
+# A database's rollback journal or write-ahead log carries the part of
+# its state not yet in the main file; they travel with it.
+_SQLITE_SIDECARS = ("-journal", "-wal", "-shm")
+
+# Where Chrome keeps its cookie jar: under ``Network/`` since Chrome 96,
+# at the profile root before that. Both are stripped of claude.ai rows.
+COOKIE_FILES: tuple[str, ...] = ("Network/Cookies", "Cookies")
+
+# One distinct window colour per slot, so two accounts' browsers are told
+# apart at a glance. Google's material palette; repeats after eight.
+PROFILE_COLORS: tuple[tuple[int, int, int], ...] = (
+    (66, 133, 244),   # blue
+    (52, 168, 83),    # green
+    (234, 67, 53),    # red
+    (251, 140, 0),    # orange
+    (156, 39, 176),   # purple
+    (0, 150, 136),    # teal
+    (233, 30, 99),    # pink
+    (121, 85, 72),    # brown
+)
+
+
+def chrome_dir_for(backup_dir: Path, account_num: str, email: str) -> Path:
+    """Profile directory Chrome is opened against for an account.
+
+    Same ``<num>-<slug>`` naming as session and desktop profiles, under
+    ``chrome/``, so the three never collide and ``purge`` sweeps them all
+    with the backup root.
+    """
+    return backup_dir / CHROME_DIRNAME / f"{account_num}-{slugify_email(email)}"
+
+
+def default_app_candidates(platform: Platform | None = None) -> list[Path]:
+    """Where a stock Google Chrome install lives, most likely first."""
+    platform = platform or Platform.detect()
+    home = Path.home()
+    if platform == Platform.MACOS:
+        return [
+            Path("/Applications/Google Chrome.app"),
+            home / "Applications" / "Google Chrome.app",
+        ]
+    if platform == Platform.WINDOWS:
+        tail = Path("Google") / "Chrome" / "Application" / "chrome.exe"
+        roots = []
+        for var in ("PROGRAMFILES", "PROGRAMFILES(X86)", "LOCALAPPDATA"):
+            value = os.environ.get(var)
+            if value:
+                roots.append(Path(value))
+        if not roots:
+            roots = [Path(r"C:\Program Files"), home / "AppData" / "Local"]
+        return [root / tail for root in roots]
+    found = []
+    for name in _LINUX_NAMES:
+        path = shutil.which(name)
+        if path:
+            found.append(Path(path))
+    return found
+
+
+def find_app(configured: str | None, platform: Platform | None = None) -> Path:
+    """Resolve the browser: the ``chrome.appPath`` setting, else a stock
+    Google Chrome install for this platform.
+
+    Raises:
+        ConfigError: nothing usable was found, with the setting to fix it.
+    """
+    platform = platform or Platform.detect()
+    if configured:
+        app = Path(os.path.expanduser(configured))
+        if app.exists():
+            return app
+        raise ConfigError(
+            f"chrome.appPath points at {app}, which does not exist; run "
+            "'cswap config set chrome.appPath <path>' with the browser's "
+            "location, or 'cswap config unset chrome.appPath' to look in the "
+            "default place"
+        )
+    candidates = default_app_candidates(platform)
+    for candidate in candidates:
+        if candidate.exists():
+            return candidate
+    if platform in (Platform.LINUX, Platform.WSL):
+        looked = ", ".join(_LINUX_NAMES) + " on PATH"
+    else:
+        looked = ", ".join(str(c) for c in candidates) or "nowhere"
+    raise ConfigError(
+        f"Google Chrome not found (looked for {looked}); install it, or run "
+        "'cswap config set chrome.appPath <path>' with the location of Chrome "
+        "or another Chromium browser (Edge, Brave, Chromium)"
+    )
+
+
+def stock_user_data_dir(platform: Platform | None = None) -> Path:
+    """The user-data-dir a stock Google Chrome uses when none is given."""
+    platform = platform or Platform.detect()
+    home = Path.home()
+    if platform == Platform.MACOS:
+        return home / "Library" / "Application Support" / "Google" / "Chrome"
+    if platform == Platform.WINDOWS:
+        local = os.environ.get("LOCALAPPDATA")
+        base = Path(local) if local else home / "AppData" / "Local"
+        return base / "Google" / "Chrome" / "User Data"
+    xdg = Path(os.path.expanduser(os.environ.get("XDG_CONFIG_HOME", "")))
+    base = xdg if str(xdg) != "." and xdg.is_absolute() else home / ".config"
+    return base / "google-chrome"
+
+
+def last_used_profile(user_data_dir: Path) -> str:
+    """The profile directory Chrome opened last (``profile.last_used`` in
+    ``Local State``), ``Default`` when unknown."""
+    try:
+        data = json.loads((user_data_dir / "Local State").read_text(encoding="utf-8"))
+        name = data.get("profile", {}).get("last_used")
+    except (OSError, ValueError, AttributeError):
+        return "Default"
+    return name if isinstance(name, str) and name and "/" not in name else "Default"
+
+
+@dataclass(frozen=True)
+class CloneReport:
+    files: int
+    skipped_unreadable: int
+
+
+def clone_profile(src: Path, dest: Path) -> CloneReport:
+    """Copy one Chrome profile directory into ``dest`` (which must not exist
+    or be empty): cookies, logins, extensions and their settings, bookmarks,
+    history. Caches, locks and the open-tabs snapshot are left out.
+
+    Databases are copied as plain files, journal and WAL alongside, the way
+    every tool that reads a running Chrome's data does. SQLite's backup API
+    would be the consistent way, but Chrome holds most of its databases in
+    exclusive locking mode, and Python's ``Connection.backup`` retries a
+    locked source forever, so it hangs on the first such file. A copy taken
+    while Chrome writes can at worst lose the last few seconds of a site's
+    cookies; the ``stock Chrome is open`` note covers that.
+
+    Raises:
+        PermissionError: the profile cannot be read at all (macOS keeps
+            Chrome's data behind Full Disk Access for terminals).
+        OSError: anything else that stops the copy.
+    """
+    # Probe the cookie jar first: on macOS that is the file TCC refuses, and
+    # finding out before copying anything keeps a refused clone all-or-nothing.
+    for rel in COOKIE_FILES:
+        probe = src / rel
+        if probe.exists():
+            with open(probe, "rb"):
+                pass
+            break
+    files = 0
+    unreadable = 0
+    dest.mkdir(parents=True, exist_ok=True)
+    for root, dirs, names in os.walk(src):
+        rel_root = Path(root).relative_to(src)
+        dirs[:] = sorted(d for d in dirs if d not in CLONE_SKIP_DIRS)
+        out_dir = dest / rel_root
+        out_dir.mkdir(parents=True, exist_ok=True)
+        for name in sorted(names):
+            if name in CLONE_SKIP_FILES:
+                continue
+            path = Path(root) / name
+            if path.is_symlink():
+                continue
+            try:
+                shutil.copy2(path, out_dir / name)
+            except PermissionError:
+                unreadable += 1
+                continue
+            files += 1
+    return CloneReport(files=files, skipped_unreadable=unreadable)
+
+
+def strip_claude_cookies(profile_dir: Path) -> int:
+    """Delete every claude.ai cookie from the profile's cookie jar(s), so a
+    cloned profile starts signed out of Claude and signed in everywhere
+    else. Returns the number of rows removed.
+
+    Raises:
+        sqlite3.Error: the jar could not be read or written; a jar that
+            may still hold the previous login is never handed to Chrome.
+    """
+    removed = 0
+    for rel in COOKIE_FILES:
+        db = profile_dir / rel
+        if not db.is_file():
+            continue
+        conn = sqlite3.connect(db)
+        try:
+            cur = conn.execute(
+                "DELETE FROM cookies WHERE host_key = 'claude.ai' "
+                "OR host_key LIKE '%.claude.ai'"
+            )
+            removed += cur.rowcount
+            conn.commit()
+        finally:
+            conn.close()
+    return removed
+
+
+def check_cookie_jars(profile_dir: Path) -> None:
+    """Run SQLite's ``quick_check`` on the profile's cookie jar(s): a copy
+    taken while the stock Chrome was mid-write can be inconsistent, and
+    the jar is the file the whole copy exists for.
+
+    Raises:
+        sqlite3.Error: the check reported a problem, with its first line.
+    """
+    for rel in COOKIE_FILES:
+        db = profile_dir / rel
+        if not db.is_file():
+            continue
+        conn = sqlite3.connect(db)
+        try:
+            verdict = conn.execute("PRAGMA quick_check").fetchone()[0]
+        except sqlite3.Error as exc:
+            raise sqlite3.DatabaseError(f"{rel}: {exc}") from exc
+        finally:
+            conn.close()
+        if verdict != "ok":
+            raise sqlite3.DatabaseError(f"{rel}: {verdict}")
+
+
+def transplant_claude_cookies(from_profile: Path, to_profile: Path) -> int:
+    """Carry the claude.ai cookies of ``from_profile`` (an account's own
+    jar) into ``to_profile`` (a fresh, stripped copy of the stock one), so a
+    resync keeps the account's Claude login. Same machine, same Chrome, so
+    the encrypted values decrypt in either jar. Returns rows copied.
+
+    Raises:
+        ConfigError: the two jars' schemas differ (a Chrome update between
+            the two), so the login could not be carried over.
+        sqlite3.Error: a jar could not be read or written.
+    """
+    copied = 0
+    for rel in COOKIE_FILES:
+        src, dest = from_profile / rel, to_profile / rel
+        if not (src.is_file() and dest.is_file()):
+            continue
+        conn = sqlite3.connect(dest)
+        try:
+            conn.execute("ATTACH DATABASE ? AS old", (str(src),))
+            main_cols = [r[1] for r in conn.execute("PRAGMA main.table_info(cookies)")]
+            old_cols = [r[1] for r in conn.execute("PRAGMA old.table_info(cookies)")]
+            if main_cols != old_cols:
+                raise ConfigError(
+                    f"the cookie jar {rel} has a different layout in the stock "
+                    "profile and in this account's profile (a Chrome update in "
+                    "between); open the account's browser once so Chrome "
+                    "upgrades its jar, then retry --sync"
+                )
+            cur = conn.execute(
+                "INSERT OR REPLACE INTO main.cookies SELECT * FROM old.cookies "
+                "WHERE host_key = 'claude.ai' OR host_key LIKE '%.claude.ai'"
+            )
+            copied += cur.rowcount
+            conn.commit()
+        finally:
+            conn.close()
+    return copied
+
+
+# The extension's own storage (``chrome.storage.local``): its account uuid,
+# consent and sign-in state live here, so a resync carries it over.
+CLAUDE_EXTENSION_STATE = Path("Local Extension Settings") / CLAUDE_EXTENSION_ID
+
+
+def _skcolor(rgb: tuple[int, int, int]) -> int:
+    """Chrome stores colours as SkColor: 0xAARRGGBB read as a signed int32."""
+    r, g, b = rgb
+    value = 0xFF000000 | (r << 16) | (g << 8) | b
+    return value - (1 << 32) if value >= (1 << 31) else value
+
+
+def profile_color(account_num: str) -> tuple[int, int, int]:
+    index = int(account_num) - 1 if account_num.isdigit() and int(account_num) > 0 else 0
+    return PROFILE_COLORS[index % len(PROFILE_COLORS)]
+
+
+def brand_profile(profile_dir: Path, name: str, rgb: tuple[int, int, int]) -> None:
+    """Name the profile and give its window a colour of its own, through
+    the untracked ``Preferences`` keys Chrome reads on the next start: the
+    avatar button shows ``name``, the frame takes the colour. Also marks the
+    last exit clean so a cloned profile does not open with a restore bar."""
+    prefs_path = profile_dir / "Preferences"
+    try:
+        prefs = json.loads(prefs_path.read_text(encoding="utf-8"))
+        if not isinstance(prefs, dict):
+            prefs = {}
+    except (OSError, ValueError):
+        prefs = {}
+    profile = prefs.setdefault("profile", {})
+    profile["name"] = name
+    profile["using_default_name"] = False
+    profile["exit_type"] = "Normal"
+    profile["exited_cleanly"] = True
+    theme = prefs.setdefault("browser", {}).setdefault("theme", {})
+    theme["user_color"] = _skcolor(rgb)
+    # 3 is Chrome's "vibrant" variant; the default tonal one washes a light
+    # window to a grey the eye does not read as a colour.
+    theme["color_variant"] = 3
+    theme["is_grayscale"] = False
+    theme["follows_system_colors"] = False
+    prefs["autogenerated_theme_color"] = _skcolor(rgb)
+    profile_dir.mkdir(parents=True, exist_ok=True)
+    prefs_path.write_text(json.dumps(prefs, ensure_ascii=False), encoding="utf-8")
+
+
+def _user_data_arg(data_dir: Path) -> str:
+    return f"{USER_DATA_FLAG}={data_dir}"
+
+
+def launch(
+    app: Path,
+    data_dir: Path,
+    urls: list[str],
+    platform: Platform | None = None,
+) -> None:
+    """Start Chrome bound to ``data_dir`` with ``urls`` open, detached.
+
+    When a browser on ``data_dir`` is already running, Chrome's process
+    singleton hands the URLs to it and this new process exits, so the same
+    call also brings an open account forward.
+
+    A ``.app`` bundle on macOS goes through ``open -n`` so LaunchServices
+    owns the process: a direct binary launch stays a child of this
+    terminal, steals focus, and dies with the shell. Anything else is
+    started in its own session with every standard stream closed.
+
+    Raises:
+        SessionError: the launcher reported failure.
+    """
+    platform = platform or Platform.detect()
+    args = [_user_data_arg(data_dir), *LAUNCH_FLAGS, *urls]
+    if platform == Platform.MACOS and app.suffix == ".app":
+        proc = subprocess.run(
+            ["open", "-n", "-a", str(app), "--args", *args],
+            capture_output=True, text=True,
+        )
+        if proc.returncode != 0:
+            detail = (proc.stderr or proc.stdout).strip()
+            raise SessionError(
+                f"could not open {app}" + (f": {detail}" if detail else "")
+            )
+        return
+    kwargs: dict = {
+        "stdin": subprocess.DEVNULL,
+        "stdout": subprocess.DEVNULL,
+        "stderr": subprocess.DEVNULL,
+        "close_fds": True,
+    }
+    if sys.platform == "win32":
+        kwargs["creationflags"] = (
+            subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
+        )
+    else:
+        kwargs["start_new_session"] = True
+    try:
+        subprocess.Popen([str(app), *args], **kwargs)
+    except OSError as exc:
+        raise SessionError(f"could not start {app}: {exc}") from exc
+
+
+@dataclass(frozen=True)
+class ChromeProfile:
+    """One account's Chrome profile as ``cswap chrome`` lists it."""
+
+    number: str
+    email: str
+    alias: str
+    data_dir: Path
+    exists: bool  # opened at least once
+    pids: tuple[int, ...]
+
+    @property
+    def running(self) -> bool:
+        return bool(self.pids)
+
+
+class ChromeManager:
+    """Opens, lists and quits per-account Chrome profiles."""
+
+    def __init__(self, switcher: ClaudeAccountSwitcher):
+        self.switcher = switcher
+        self.platform = switcher.platform
+        self._app: Path | None = None
+
+    # -- resolution --------------------------------------------------------
+
+    def data_dir(self, account_num: str, email: str) -> Path:
+        return chrome_dir_for(self.switcher.backup_dir, account_num, email)
+
+    def settings(self):
+        from claude_swap.settings import load_chrome_settings
+
+        return load_chrome_settings(self.switcher.backup_dir)
+
+    def app(self) -> Path:
+        if self._app is None:
+            self._app = find_app(self.settings().app_path, self.platform)
+        return self._app
+
+    def profiles(self) -> list[ChromeProfile]:
+        """Every stored account with its profile state, in slot order."""
+        data = self.switcher._get_sequence_data() or {}
+        accounts = data.get("accounts", {})
+        rows = []
+        for number in sorted(accounts, key=lambda n: int(n) if n.isdigit() else 0):
+            record = accounts[number]
+            email = record.get("email", "")
+            data_dir = self.data_dir(number, email)
+            rows.append(ChromeProfile(
+                number=number,
+                email=email,
+                alias=record.get("alias", "") or "",
+                data_dir=data_dir,
+                exists=data_dir.is_dir(),
+                pids=tuple(running_pids(data_dir, self.platform)),
+            ))
+        return rows
+
+    def _targets(self, identifiers: list[str], all_accounts: bool) -> list[tuple[str, str] | None]:
+        """(number, email) per requested account; unknown ones are reported
+        and skipped so the rest still open."""
+        if all_accounts:
+            return [(p.number, p.email) for p in self.profiles()]
+        targets: list[tuple[str, str] | None] = []
+        for ident in identifiers:
+            try:
+                number, email, _ = self.switcher.resolve_account(ident)
+            except AccountNotFoundError:
+                error(f"  {ident}: account not found")
+                targets.append(None)
+                continue
+            targets.append((number, email))
+        return targets
+
+    # -- commands ----------------------------------------------------------
+
+    def open(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Open (or bring forward) the browsers of the given accounts.
+
+        A first open also shows the extension's Web Store page, so the
+        profile can be set up in one go. Returns 1 when any requested
+        account could not be opened.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        if not targets:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return 0
+        app = self.app()
+        failed = any(t is None for t in targets)
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            label = f"{number}. {email}"
+            already_open = bool(running_pids(data_dir, self.platform))
+            first_time = not data_dir.is_dir()
+            urls = [CLAUDE_URL]
+            if first_time:
+                try:
+                    cloned = self.prepare_profile(number, email, data_dir)
+                except (OSError, ConfigError) as exc:
+                    error(f"  {label}: {exc}")
+                    failed = True
+                    continue
+                if not (data_dir / "Default" / "Extensions" / CLAUDE_EXTENSION_ID).is_dir():
+                    urls.insert(0, EXTENSION_URL)
+            try:
+                launch(app, data_dir, urls, self.platform)
+            except SessionError as exc:
+                error(f"  {label}: {exc}")
+                failed = True
+                continue
+            if already_open:
+                print(f"  {label} {dimmed('already open, brought to the front')}")
+            elif first_time and cloned:
+                print(
+                    f"  {label} {accent('opening a copy of your Chrome profile')}; "
+                    "other sites stay signed in and your extensions are there. "
+                    "Sign in to this account on claude.ai, then click Sign in "
+                    "once in the Claude side panel. Both stay put."
+                )
+            elif first_time:
+                print(
+                    f"  {label} {accent('opening a fresh browser profile')}; "
+                    "install Claude in Chrome from the Web Store tab and sign "
+                    "in to this account on claude.ai there, once. Both stay put."
+                )
+            else:
+                print(f"  {label} {accent('opening')}")
+        return 1 if failed else 0
+
+    def _stock_profile(self) -> Path:
+        stock = stock_user_data_dir(self.platform)
+        return stock / last_used_profile(stock)
+
+    def _copy_stock(self, src: Path, dest: Path, data_dir: Path) -> None:
+        """Copy the stock profile ``src`` into ``dest`` minus its claude.ai
+        cookies, printing what was done.
+
+        Raises:
+            ConfigError: the stock profile cannot be read (macOS Full Disk
+                Access), with the two ways out.
+            OSError: the copy failed midway.
+        """
+        if stock_instance_running(self.app(), self.platform):
+            print(dimmed(
+                "  the stock Chrome is open; the copy may miss what it "
+                "has not written to disk yet"
+            ))
+        try:
+            report = clone_profile(src, dest)
+        except PermissionError as exc:
+            raise ConfigError(
+                f"cannot read the Chrome profile at {src} ({exc}). "
+                "On macOS, give this terminal Full Disk Access (System "
+                "Settings > Privacy & Security > Full Disk Access) and "
+                "retry, or run 'cswap config set chrome.cloneStockProfile "
+                "false' to start this account from an empty profile"
+            ) from exc
+        stock = src.parent
+        if self.platform == Platform.WINDOWS and (stock / "Local State").is_file():
+            # Holds the key the cookie jar is encrypted with there.
+            shutil.copy2(stock / "Local State", data_dir / "Local State")
+        try:
+            check_cookie_jars(dest)
+            removed = strip_claude_cookies(dest)
+        except sqlite3.Error as exc:
+            raise ConfigError(
+                f"the copied cookie jar is not usable ({exc}); the stock Chrome "
+                "was probably writing it. Retry in a moment, or with the stock "
+                "Chrome closed; or run 'cswap config set chrome.cloneStockProfile "
+                "false' to start this account from an empty profile"
+            ) from exc
+        note = f"  copied {report.files} file(s) from {src.name}"
+        if removed:
+            note += f", dropped {removed} claude.ai cookie(s)"
+        if report.skipped_unreadable:
+            note += f", {report.skipped_unreadable} unreadable file(s) left out"
+        print(dimmed(note))
+
+    def prepare_profile(self, number: str, email: str, data_dir: Path) -> bool:
+        """Create the account's profile directory for its first open.
+
+        With ``chrome.cloneStockProfile`` (default on) the profile Chrome
+        last used in the stock install is copied in first, minus its
+        claude.ai cookies, so the new browser is signed in everywhere except
+        Claude and carries the same extensions; the profile is then named
+        after the account and given its own window colour. Returns whether a
+        copy was made.
+
+        Raises:
+            ConfigError: the stock profile is there but cannot be read (macOS
+                Full Disk Access), with the two ways out.
+            OSError: the copy failed midway; the partial profile is removed.
+        """
+        dest = data_dir / "Default"
+        cloned = False
+        if self.settings().clone_stock_profile:
+            src = self._stock_profile()
+            if src.is_dir():
+                self._mkdir_private(data_dir)
+                try:
+                    self._copy_stock(src, dest, data_dir)
+                except (ConfigError, OSError):
+                    shutil.rmtree(data_dir, ignore_errors=True)
+                    raise
+                cloned = True
+            else:
+                print(dimmed(
+                    f"  no stock Chrome profile at {src}; starting from an empty one"
+                ))
+        self._mkdir_private(data_dir)
+        brand_profile(dest, self._alias(number) or email, profile_color(number))
+        return cloned
+
+    def sync(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Resync the given accounts' profiles from the stock Chrome profile.
+
+        The stock profile is the master copy: its cookies, extensions,
+        bookmarks, logins and history replace the account profile's, the
+        same way the first open copied them. Two things are carried over
+        from the account profile so it stays itself: its claude.ai cookies
+        (the account's Claude login) and the Claude in Chrome extension's
+        own storage (the account it is signed in as). Anything else the
+        account profile changed on its own since the last copy is gone.
+
+        The copy is built beside the profile and swapped in whole, so a
+        failure leaves the old profile untouched. Refuses while the
+        account's browser is open. Returns 1 when any requested account
+        could not be synced; an account that was never opened is skipped
+        with a note.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        failed = any(t is None for t in targets)
+        src = self._stock_profile()
+        if not src.is_dir():
+            error(f"  no stock Chrome profile at {src}")
+            return 1
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            label = f"{number}. {email}"
+            current = data_dir / "Default"
+            if not current.is_dir():
+                print(f"  {label} {dimmed('never opened, nothing to sync')}")
+                continue
+            pids = running_pids(data_dir, self.platform)
+            if pids:
+                error(
+                    f"  {label}: browser open (PID {', '.join(map(str, pids))}); "
+                    f"close it first ('cswap chrome --quit {number}')"
+                )
+                failed = True
+                continue
+            staging = data_dir / f"Default.sync-{os.getpid()}"
+            retired = data_dir / f"Default.old-{os.getpid()}"
+            shutil.rmtree(staging, ignore_errors=True)
+            try:
+                self._copy_stock(src, staging, data_dir)
+                try:
+                    kept = transplant_claude_cookies(current, staging)
+                except sqlite3.Error as exc:
+                    raise ConfigError(
+                        f"could not carry this account's claude.ai cookies over ({exc})"
+                    ) from exc
+                state = current / CLAUDE_EXTENSION_STATE
+                if state.is_dir():
+                    shutil.rmtree(staging / CLAUDE_EXTENSION_STATE, ignore_errors=True)
+                    shutil.copytree(state, staging / CLAUDE_EXTENSION_STATE)
+                brand_profile(staging, self._alias(number) or email, profile_color(number))
+                current.rename(retired)
+                staging.rename(current)
+            except (ConfigError, OSError) as exc:
+                shutil.rmtree(staging, ignore_errors=True)
+                if retired.is_dir() and not current.exists():
+                    retired.rename(current)
+                error(f"  {label}: {exc}")
+                failed = True
+                continue
+            shutil.rmtree(retired, ignore_errors=True)
+            print(
+                f"  {label} {accent('synced')} {dimmed(f'({kept} claude.ai cookie(s) and the extension state kept)')}"
+            )
+        return 1 if failed else 0
+
+    def _alias(self, number: str) -> str:
+        data = self.switcher._get_sequence_data() or {}
+        return str(data.get("accounts", {}).get(number, {}).get("alias", "") or "")
+
+    def follow_switch(self, number: str, email: str) -> None:
+        """After ``cswap switch``: bring the new account's browser forward
+        when ``chrome.followSwitch`` is on and the account has a profile.
+        Never creates one, never fails the switch."""
+        if not self.settings().follow_switch:
+            return
+        data_dir = self.data_dir(number, email)
+        if not data_dir.is_dir():
+            return
+        try:
+            launch(self.app(), data_dir, [CLAUDE_URL], self.platform)
+        except (ConfigError, SessionError) as exc:
+            print(dimmed(f"  chrome.followSwitch: {exc}"))
+            return
+        print(dimmed(f"  Chrome: account {number}'s browser brought forward"))
+
+    def quit(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Close the given accounts' browsers. Returns 1 for an unknown account.
+
+        ``--all`` also sweeps ``chrome/`` itself, so a profile whose account
+        slot is gone (the one ``purge`` reports) is closed too.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        failed = any(t is None for t in targets)
+        seen: set[str] = set()
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            seen.add(data_dir.name)
+            if quit_instance(data_dir, platform=self.platform):
+                print(f"  {number}. {email} {accent('closed')}")
+            else:
+                print(f"  {number}. {email} {dimmed('not open')}")
+        if all_accounts:
+            root = self.switcher.backup_dir / CHROME_DIRNAME
+            for name in sorted(self.open_profile_dirs()):
+                if name in seen:
+                    continue
+                if quit_instance(root / name, platform=self.platform):
+                    print(f"  {name} {accent('closed')} {dimmed('(no account slot)')}")
+        return 1 if failed else 0
+
+    def show(self) -> None:
+        """List every account's profile: open, set up once, or never opened."""
+        rows = self.profiles()
+        if not rows:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return
+        print(bold_accent("Chrome profiles:"))
+        for p in rows:
+            marker = bold_accent("●") if p.running else dimmed("○")
+            name = f"{p.number}. {p.email}" + (f" ({p.alias})" if p.alias else "")
+            if p.running:
+                state = accent("open") + dimmed(f"  PID {', '.join(map(str, p.pids))}")
+            elif p.exists:
+                state = muted("closed")
+            else:
+                state = dimmed("never opened")
+            print(f"  {marker} {name}  {state}")
+        print()
+        print(dimmed(
+            "cswap chrome <num|email> opens an account's browser; "
+            "--all opens every account; --quit closes them."
+        ))
+
+    # -- lifecycle hooks used by the switcher ------------------------------
+
+    def ensure_closed(self, account_num: str, email: str, action: str) -> None:
+        """Refuse ``action`` while the account's browser is open."""
+        pids = running_pids(self.data_dir(account_num, email), self.platform)
+        if pids:
+            raise SessionError(
+                f"Chrome is open for account {account_num} ({email}), "
+                f"PID {', '.join(map(str, pids))}. Close it first "
+                f"('cswap chrome --quit {account_num}'), then retry {action}."
+            )
+
+    def delete_profile(self, account_num: str, email: str) -> None:
+        """Remove the account's profile directory; the login and the
+        extension go with it."""
+        data_dir = self.data_dir(account_num, email)
+        if data_dir.exists():
+            shutil.rmtree(data_dir, ignore_errors=True)
+
+    def open_profile_dirs(self) -> dict[str, list[int]]:
+        """``{dir name: pids}`` for every profile with a browser open, by
+        scanning ``chrome/`` itself so a profile whose account is gone
+        still counts."""
+        root = self.switcher.backup_dir / CHROME_DIRNAME
+        if not root.is_dir():
+            return {}
+        live = {}
+        for d in sorted(root.iterdir()):
+            if not d.is_dir():
+                continue
+            pids = running_pids(d, self.platform)
+            if pids:
+                live[d.name] = pids
+        return live
+
+    @staticmethod
+    def _mkdir_private(path: Path) -> None:
+        path.mkdir(parents=True, exist_ok=True)
+        if sys.platform != "win32":
+            os.chmod(path, 0o700)
