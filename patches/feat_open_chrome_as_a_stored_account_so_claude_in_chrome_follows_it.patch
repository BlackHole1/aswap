+class TestLaunch:
+    def test_macos_hands_the_profile_and_urls_to_open(self, tmp_path):
+        """``open -n`` so LaunchServices, not this terminal, owns the browser;
+        ``--args`` carries the profile dir, the first-run flags and the URLs
+        through to Chrome."""
+        data_dir = tmp_path / "2-x"
+        with patch.object(chrome.subprocess, "run") as run:
