From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kevin Cui <bh@bugs.cc>
Date: Mon, 21 Sep 2026 10:48:34 -0400
Subject: feat: open Chrome as a stored account so Claude in Chrome follows it

`cswap switch` moves Claude Code to another account, but the Claude in
Chrome extension keeps acting as whoever is signed in to claude.ai in
the browser: inference runs on the new account, the extension and
whatever it does on claude.ai on the old one (upstream #256). The two
never share a credential. Claude Code holds an OAuth pair in the
credential store; the extension rides the claude.ai session cookie in
Chrome's cookie jar, per Chrome profile. Neither derives from the other,
and the jar is encrypted per user and per browser, so switching the
extension inside one profile would mean decrypting Chrome's storage and
rewriting another extension's account state from outside.

What Chrome does honor is `--user-data-dir`: a separate profile
directory is a separate, independently signed-in browser with its own
extensions. `cswap chrome <num|email ...>` gives every stored account a
permanent profile under `<backup>/chrome/<num>-<email slug>/` and opens
the browser against it, the same shape as `cswap desktop` for Claude
Desktop. The first open also shows the extension's Web Store page and
claude.ai, so the user installs the extension and signs in to that
account there, once; both stay put. Later opens go to claude.ai.
`--no-first-run --no-default-browser-check` keep Chrome's welcome flow
and default-browser prompt out of every fresh profile. Nothing reads,
copies or migrates a login: Chrome owns everything in the profile.

Chrome keeps one process singleton per profile directory, so a second
launch with the same `--user-data-dir` hands its URLs to the running
browser and exits; opening an account that is already open therefore
brings its browser forward through the same launch, on every platform,
instead of a best-effort `open -a` that could pick another instance. The
profile is found again by the exact `--user-data-dir=<dir>` token on the
command line, with the process helpers shared with desktop.py; `--quit`
sends TERM, then KILL after a timeout; a bare `cswap chrome` lists which
accounts have a browser open.

The browser is looked up in the stock Google Chrome install location
(`/Applications` or `~/Applications` on macOS, the Program Files and
LOCALAPPDATA roots on Windows, `google-chrome`, `google-chrome-stable`,
`chromium` or `chromium-browser` on PATH elsewhere) or the new
`chrome.appPath` setting. The extension runs in any Chromium browser, so
the setting may point at Edge, Brave or Chromium; on macOS a `.app`
bundle goes through `open -n`, anything else is started directly.

Removing an account refuses while its browser is open and otherwise
deletes the profile with the slot, and `purge` refuses while any browser
is open and lists the profiles it removes, the same way both treat
session and desktop profiles.

diff --git a/src/claude_swap/chrome.py b/src/claude_swap/chrome.py
new file mode 100644
index 0000000000000000000000000000000000000000..097babbbcd2693a5b0fdb9ad7635646414198378
--- /dev/null
+++ b/src/claude_swap/chrome.py
@@ -0,0 +1,399 @@
+"""Chrome with Claude in Chrome, one browser profile per stored account.
+
+``cswap switch`` moves Claude Code to another account, but the Claude in
+Chrome extension keeps working as whoever is signed in to claude.ai in
+the browser. The two never share a credential: Claude Code holds an OAuth
+pair in the credential store, the extension rides the claude.ai session
+cookie in Chrome's cookie jar, per Chrome profile. Neither can be derived
+from the other, and the cookie jar is encrypted per user and per browser,
+so swapping cookies inside one profile would mean decrypting Chrome's
+storage and rewriting another extension's account state from outside.
+
+What Chrome does honor is ``--user-data-dir``: a separate profile
+directory is a separate, independently signed-in browser with its own
+extensions. This module gives every stored account a permanent Chrome
+profile under ``<backup>/chrome/<num>-<email slug>/`` and opens the
+browser against it. The first open shows the Web Store page for the
+extension and claude.ai; the user installs the extension and signs in to
+that account there, once, and both stay put. Nothing here reads, copies or
+migrates a login: Chrome owns everything inside the profile.
+
+Chrome keeps one process singleton per profile directory, so a second
+launch with the same ``--user-data-dir`` hands its URLs to the running
+browser and exits: that is how an open account is brought forward. The
+profile is found again by the exact ``--user-data-dir=<dir>`` token on the
+command line, the same way ``cswap desktop`` finds Claude Desktop windows;
+the process helpers are shared with that module. The extension runs in
+any Chromium browser, so ``chrome.appPath`` may point at Edge, Brave or
+Chromium instead of Chrome.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from claude_swap.desktop import USER_DATA_FLAG, quit_instance, running_pids
+from claude_swap.exceptions import AccountNotFoundError, ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.printer import accent, bold_accent, dimmed, error, muted
+from claude_swap.session import slugify_email
+
+if TYPE_CHECKING:
+    from claude_swap.switcher import ClaudeAccountSwitcher
+
+CHROME_DIRNAME = "chrome"
+
+# The official extension, "Claude" by Anthropic, on the Chrome Web Store.
+EXTENSION_ID = "fcoeoabgfenejglbffodgkkbkcdhcgfn"
+EXTENSION_URL = f"https://chromewebstore.google.com/detail/claude/{EXTENSION_ID}"
+CLAUDE_URL = "https://claude.ai/"
+
+# A fresh profile otherwise greets the user with Chrome's first-run flow
+# and a default-browser prompt on every account.
+LAUNCH_FLAGS: tuple[str, ...] = ("--no-first-run", "--no-default-browser-check")
+
+_LINUX_NAMES: tuple[str, ...] = (
+    "google-chrome",
+    "google-chrome-stable",
+    "chromium",
+    "chromium-browser",
+)
+
+
+def chrome_dir_for(backup_dir: Path, account_num: str, email: str) -> Path:
+    """Profile directory Chrome is opened against for an account.
+
+    Same ``<num>-<slug>`` naming as session and desktop profiles, under
+    ``chrome/``, so the three never collide and ``purge`` sweeps them all
+    with the backup root.
+    """
+    return backup_dir / CHROME_DIRNAME / f"{account_num}-{slugify_email(email)}"
+
+
+def default_app_candidates(platform: Platform | None = None) -> list[Path]:
+    """Where a stock Google Chrome install lives, most likely first."""
+    platform = platform or Platform.detect()
+    home = Path.home()
+    if platform == Platform.MACOS:
+        return [
+            Path("/Applications/Google Chrome.app"),
+            home / "Applications" / "Google Chrome.app",
+        ]
+    if platform == Platform.WINDOWS:
+        tail = Path("Google") / "Chrome" / "Application" / "chrome.exe"
+        roots = []
+        for var in ("PROGRAMFILES", "PROGRAMFILES(X86)", "LOCALAPPDATA"):
+            value = os.environ.get(var)
+            if value:
+                roots.append(Path(value))
+        if not roots:
+            roots = [Path(r"C:\Program Files"), home / "AppData" / "Local"]
+        return [root / tail for root in roots]
+    found = []
+    for name in _LINUX_NAMES:
+        path = shutil.which(name)
+        if path:
+            found.append(Path(path))
+    return found
+
+
+def find_app(configured: str | None, platform: Platform | None = None) -> Path:
+    """Resolve the browser: the ``chrome.appPath`` setting, else a stock
+    Google Chrome install for this platform.
+
+    Raises:
+        ConfigError: nothing usable was found, with the setting to fix it.
+    """
+    platform = platform or Platform.detect()
+    if configured:
+        app = Path(os.path.expanduser(configured))
+        if app.exists():
+            return app
+        raise ConfigError(
+            f"chrome.appPath points at {app}, which does not exist; run "
+            "'cswap config set chrome.appPath <path>' with the browser's "
+            "location, or 'cswap config unset chrome.appPath' to look in the "
+            "default place"
+        )
+    candidates = default_app_candidates(platform)
+    for candidate in candidates:
+        if candidate.exists():
+            return candidate
+    if platform in (Platform.LINUX, Platform.WSL):
+        looked = ", ".join(_LINUX_NAMES) + " on PATH"
+    else:
+        looked = ", ".join(str(c) for c in candidates) or "nowhere"
+    raise ConfigError(
+        f"Google Chrome not found (looked for {looked}); install it, or run "
+        "'cswap config set chrome.appPath <path>' with the location of Chrome "
+        "or another Chromium browser (Edge, Brave, Chromium)"
+    )
+
+
+def _user_data_arg(data_dir: Path) -> str:
+    return f"{USER_DATA_FLAG}={data_dir}"
+
+
+def launch(
+    app: Path,
+    data_dir: Path,
+    urls: list[str],
+    platform: Platform | None = None,
+) -> None:
+    """Start Chrome bound to ``data_dir`` with ``urls`` open, detached.
+
+    When a browser on ``data_dir`` is already running, Chrome's process
+    singleton hands the URLs to it and this new process exits, so the same
+    call also brings an open account forward.
+
+    A ``.app`` bundle on macOS goes through ``open -n`` so LaunchServices
+    owns the process: a direct binary launch stays a child of this
+    terminal, steals focus, and dies with the shell. Anything else is
+    started in its own session with every standard stream closed.
+
+    Raises:
+        SessionError: the launcher reported failure.
+    """
+    platform = platform or Platform.detect()
+    args = [_user_data_arg(data_dir), *LAUNCH_FLAGS, *urls]
+    if platform == Platform.MACOS and app.suffix == ".app":
+        proc = subprocess.run(
+            ["open", "-n", "-a", str(app), "--args", *args],
+            capture_output=True, text=True,
+        )
+        if proc.returncode != 0:
+            detail = (proc.stderr or proc.stdout).strip()
+            raise SessionError(
+                f"could not open {app}" + (f": {detail}" if detail else "")
+            )
+        return
+    kwargs: dict = {
+        "stdin": subprocess.DEVNULL,
+        "stdout": subprocess.DEVNULL,
+        "stderr": subprocess.DEVNULL,
+        "close_fds": True,
+    }
+    if sys.platform == "win32":
+        kwargs["creationflags"] = (
+            subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
+        )
+    else:
+        kwargs["start_new_session"] = True
+    try:
+        subprocess.Popen([str(app), *args], **kwargs)
+    except OSError as exc:
+        raise SessionError(f"could not start {app}: {exc}") from exc
+
+
+@dataclass(frozen=True)
+class ChromeProfile:
+    """One account's Chrome profile as ``cswap chrome`` lists it."""
+
+    number: str
+    email: str
+    alias: str
+    data_dir: Path
+    exists: bool  # opened at least once
+    pids: tuple[int, ...]
+
+    @property
+    def running(self) -> bool:
+        return bool(self.pids)
+
+
+class ChromeManager:
+    """Opens, lists and quits per-account Chrome profiles."""
+
+    def __init__(self, switcher: ClaudeAccountSwitcher):
+        self.switcher = switcher
+        self.platform = switcher.platform
+        self._app: Path | None = None
+
+    # -- resolution --------------------------------------------------------
+
+    def data_dir(self, account_num: str, email: str) -> Path:
+        return chrome_dir_for(self.switcher.backup_dir, account_num, email)
+
+    def app(self) -> Path:
+        if self._app is None:
+            from claude_swap.settings import load_chrome_settings
+
+            configured = load_chrome_settings(self.switcher.backup_dir).app_path
+            self._app = find_app(configured, self.platform)
+        return self._app
+
+    def profiles(self) -> list[ChromeProfile]:
+        """Every stored account with its profile state, in slot order."""
+        data = self.switcher._get_sequence_data() or {}
+        accounts = data.get("accounts", {})
+        rows = []
+        for number in sorted(accounts, key=lambda n: int(n) if n.isdigit() else 0):
+            record = accounts[number]
+            email = record.get("email", "")
+            data_dir = self.data_dir(number, email)
+            rows.append(ChromeProfile(
+                number=number,
+                email=email,
+                alias=record.get("alias", "") or "",
+                data_dir=data_dir,
+                exists=data_dir.is_dir(),
+                pids=tuple(running_pids(data_dir, self.platform)),
+            ))
+        return rows
+
+    def _targets(self, identifiers: list[str], all_accounts: bool) -> list[tuple[str, str] | None]:
+        """(number, email) per requested account; unknown ones are reported
+        and skipped so the rest still open."""
+        if all_accounts:
+            return [(p.number, p.email) for p in self.profiles()]
+        targets: list[tuple[str, str] | None] = []
+        for ident in identifiers:
+            try:
+                number, email, _ = self.switcher.resolve_account(ident)
+            except AccountNotFoundError:
+                error(f"  {ident}: account not found")
+                targets.append(None)
+                continue
+            targets.append((number, email))
+        return targets
+
+    # -- commands ----------------------------------------------------------
+
+    def open(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Open (or bring forward) the browsers of the given accounts.
+
+        A first open also shows the extension's Web Store page, so the
+        profile can be set up in one go. Returns 1 when any requested
+        account could not be opened.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        if not targets:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return 0
+        app = self.app()
+        failed = any(t is None for t in targets)
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            label = f"{number}. {email}"
+            already_open = bool(running_pids(data_dir, self.platform))
+            first_time = not data_dir.is_dir()
+            self._mkdir_private(data_dir)
+            urls = [EXTENSION_URL, CLAUDE_URL] if first_time else [CLAUDE_URL]
+            try:
+                launch(app, data_dir, urls, self.platform)
+            except SessionError as exc:
+                error(f"  {label}: {exc}")
+                failed = True
+                continue
+            if already_open:
+                print(f"  {label} {dimmed('already open, brought to the front')}")
+            elif first_time:
+                print(
+                    f"  {label} {accent('opening a fresh browser profile')}; "
+                    "install Claude in Chrome from the Web Store tab and sign "
+                    "in to this account on claude.ai there, once. Both stay put."
+                )
+            else:
+                print(f"  {label} {accent('opening')}")
+        return 1 if failed else 0
+
+    def quit(self, identifiers: list[str], all_accounts: bool = False) -> int:
+        """Close the given accounts' browsers. Returns 1 for an unknown account.
+
+        ``--all`` also sweeps ``chrome/`` itself, so a profile whose account
+        slot is gone (the one ``purge`` reports) is closed too.
+        """
+        targets = self._targets(identifiers, all_accounts)
+        failed = any(t is None for t in targets)
+        seen: set[str] = set()
+        for target in targets:
+            if target is None:
+                continue
+            number, email = target
+            data_dir = self.data_dir(number, email)
+            seen.add(data_dir.name)
+            if quit_instance(data_dir, platform=self.platform):
+                print(f"  {number}. {email} {accent('closed')}")
+            else:
+                print(f"  {number}. {email} {dimmed('not open')}")
+        if all_accounts:
+            root = self.switcher.backup_dir / CHROME_DIRNAME
+            for name in sorted(self.open_profile_dirs()):
+                if name in seen:
+                    continue
+                if quit_instance(root / name, platform=self.platform):
+                    print(f"  {name} {accent('closed')} {dimmed('(no account slot)')}")
+        return 1 if failed else 0
+
+    def show(self) -> None:
+        """List every account's profile: open, set up once, or never opened."""
+        rows = self.profiles()
+        if not rows:
+            print(muted("No accounts stored yet; add one with 'cswap add'."))
+            return
+        print(bold_accent("Chrome profiles:"))
+        for p in rows:
+            marker = bold_accent("●") if p.running else dimmed("○")
+            name = f"{p.number}. {p.email}" + (f" ({p.alias})" if p.alias else "")
+            if p.running:
+                state = accent("open") + dimmed(f"  PID {', '.join(map(str, p.pids))}")
+            elif p.exists:
+                state = muted("closed")
+            else:
+                state = dimmed("never opened")
+            print(f"  {marker} {name}  {state}")
+        print()
+        print(dimmed(
+            "cswap chrome <num|email> opens an account's browser; "
+            "--all opens every account; --quit closes them."
+        ))
+
+    # -- lifecycle hooks used by the switcher ------------------------------
+
+    def ensure_closed(self, account_num: str, email: str, action: str) -> None:
+        """Refuse ``action`` while the account's browser is open."""
+        pids = running_pids(self.data_dir(account_num, email), self.platform)
+        if pids:
+            raise SessionError(
+                f"Chrome is open for account {account_num} ({email}), "
+                f"PID {', '.join(map(str, pids))}. Close it first "
+                f"('cswap chrome --quit {account_num}'), then retry {action}."
+            )
+
+    def delete_profile(self, account_num: str, email: str) -> None:
+        """Remove the account's profile directory; the login and the
+        extension go with it."""
+        data_dir = self.data_dir(account_num, email)
+        if data_dir.exists():
+            shutil.rmtree(data_dir, ignore_errors=True)
+
+    def open_profile_dirs(self) -> dict[str, list[int]]:
+        """``{dir name: pids}`` for every profile with a browser open, by
+        scanning ``chrome/`` itself so a profile whose account is gone
+        still counts."""
+        root = self.switcher.backup_dir / CHROME_DIRNAME
+        if not root.is_dir():
+            return {}
+        live = {}
+        for d in sorted(root.iterdir()):
+            if not d.is_dir():
+                continue
+            pids = running_pids(d, self.platform)
+            if pids:
+                live[d.name] = pids
+        return live
+
+    @staticmethod
+    def _mkdir_private(path: Path) -> None:
+        path.mkdir(parents=True, exist_ok=True)
+        if sys.platform != "win32":
+            os.chmod(path, 0o700)
