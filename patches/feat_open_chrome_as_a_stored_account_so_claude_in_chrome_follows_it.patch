+from claude_swap import chrome, cli
+from claude_swap.chrome import (
+    CLAUDE_EXTENSION_STATE,
+    check_cookie_jars,
+    CLAUDE_URL,
+    EXTENSION_URL,
+    ChromeManager,
+    brand_profile,
+    clone_profile,
+    last_used_profile,
+    profile_color,
+    strip_claude_cookies,
+    transplant_claude_cookies,
