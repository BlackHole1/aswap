+def _chrome_command(argv: list[str]) -> None:
+    """Handle `cswap chrome [num|email ...] [--all] [--quit]`.
+
+    The Claude in Chrome extension works as whoever is signed in to
+    claude.ai in the browser, and that cookie is a different credential
+    from the one cswap stores for Claude Code. Each stored account gets its
+    own permanent Chrome profile here, opened with ``--user-data-dir``, so
+    the extension in that profile stays on that account. Nothing copies a
+    login: install the extension and sign in once per account.
+    """
+    parser = argparse.ArgumentParser(
+        prog=f"{_prog_name()} chrome",
+        description=(
+            "Open Chrome as a stored account, in its own browser profile with "
+            "its own claude.ai login and its own copy of the Claude in Chrome "
+            "extension. Every account has a permanent Chrome profile, picked "
+            "by its slot in the account table; the credential cswap stores for "
+            "Claude Code is not used or copied. The first open shows the "
+            "extension's Web Store page and claude.ai: install the extension "
+            "and sign in to that account there, once, and both stay put. "
+            "Opening an account that is already open brings its browser "
+            "forward. Several accounts can be open at once. With no account: "
+            "list each account's browser. Exits 1 if any account could not be "
+            "opened."
+        ),
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  cswap chrome                  # which accounts have a browser open
+  cswap chrome 2                # open account 2 (or bring its browser forward)
+  cswap chrome work personal    # by alias or email; several at once
+  cswap chrome --all            # every account, one browser each
+  cswap chrome --quit 2         # close account 2's browser
+  cswap config set chrome.appPath "/Applications/Brave Browser.app"   # another Chromium browser
+        """,
+    )
+    parser.add_argument(
+        "accounts",
+        nargs="*",
+        metavar="num|email",
+        help="Accounts to open (number, alias or email)",
+    )
+    parser.add_argument(
+        "--all", action="store_true", help="Every stored account",
+    )
+    parser.add_argument(
+        "--quit", action="store_true",
+        help="Close the given accounts' browsers instead of opening them",
+    )
+    parser.add_argument("--debug", action="store_true", help="Enable debug logging")
+    args = parser.parse_args(argv)
+    if args.all and args.accounts:
+        parser.error("--all takes no accounts")
+    if args.quit and not (args.all or args.accounts):
+        parser.error("--quit needs an account or --all")
+
+    try:
+        switcher = ClaudeAccountSwitcher(debug=args.debug)
+        _guard_root(switcher)
+
+        from claude_swap.chrome import ChromeManager
+
+        manager = ChromeManager(switcher)
+        if args.quit:
+            code = manager.quit(args.accounts, args.all)
+        elif args.all or args.accounts:
+            code = manager.open(args.accounts, args.all)
+        else:
+            manager.show()
+            code = 0
+    except ClaudeSwitchError as e:
+        error(f"Error: {e}")
+        sys.exit(1)
+    except KeyboardInterrupt:
+        print(f"\n{dimmed('Operation cancelled')}")
+        sys.exit(130)
+    if code:
+        sys.exit(code)
+
+
