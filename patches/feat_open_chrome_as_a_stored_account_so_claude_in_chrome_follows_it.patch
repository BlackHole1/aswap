+            "settings.json: chrome.appPath must be a string, got %r; ignoring",
+            app_path,
+        )
+        app_path = default.app_path
+    flags = {}
+    for key, field in (("cloneStockProfile", "clone_stock_profile"), ("followSwitch", "follow_switch")):
+        value = section.get(key, getattr(default, field))
+        if not isinstance(value, bool):
+            _logger.warning(
+                "settings.json: chrome.%s must be true or false, got %r; using %r",
+                key, value, getattr(default, field),
+            )
+            value = getattr(default, field)
+        flags[field] = value
+    return ChromeSettings(app_path=app_path or None, **flags)
