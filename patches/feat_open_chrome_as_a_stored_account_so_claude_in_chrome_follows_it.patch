+"""``cswap chrome``: Chrome with Claude in Chrome, one profile per stored account.
+
+The extension works as whoever is signed in to claude.ai in the browser,
+a cookie that is a different credential from the one cswap stores for
+Claude Code. Chrome honors ``--user-data-dir``, so each account gets a
+permanent browser profile under ``<backup>/chrome/`` with its own login
+and its own copy of the extension. Chrome's process singleton hands a
+second launch on the same profile to the running browser, which is how an
+open account is brought forward. Nothing copies a login: the user installs
+the extension and signs in once per profile.
+"""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from claude_swap import chrome, cli
+from claude_swap.chrome import (
+    CLAUDE_URL,
+    EXTENSION_URL,
+    ChromeManager,
+    chrome_dir_for,
+    find_app,
+)
+from claude_swap.exceptions import ConfigError, SessionError
+from claude_swap.models import Platform
+from claude_swap.settings import (
+    load_chrome_settings,
+    set_setting,
+    settings_path,
+    unset_setting,
+)
+from claude_swap.switcher import ClaudeAccountSwitcher
+
+
+def _plain(text: str) -> str:
+    return re.sub(r"\x1b\[[0-9;]*m", "", text)
+
