+def load_session_settings(backup_root: Path) -> SessionSettings:
+    """Load the session section; missing/corrupt file or bad type → default."""
+    raw = _read_raw(settings_path(backup_root))
+    section = raw.get("session")
+    default = SessionSettings()
+    if not isinstance(section, dict):
+        return default
+    share_history = section.get("shareHistory", default.share_history)
