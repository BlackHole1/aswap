index 5074d56822038ec44eb607451dc53104b9b9153c..863c8adf83407f89ca22644a1a5d8894e7a3d509 100644
--- a/tests/test_session.py
+++ b/tests/test_session.py
@@ -2128,6 +2128,73 @@ class TestShareHistoryPosix:
