+@pytest.mark.skipif(sys.platform == "win32", reason="history sharing is POSIX-only")
+class TestShareHistoryDefault:
+    """run() with neither flag follows session.shareHistory (default: on)."""
+
+    def _linked(self, session_dir: Path, source: Path) -> bool:
+        return (
+            (session_dir / "projects").is_symlink()
+            and (session_dir / "projects").readlink() == source / "projects"
+        )
+
+    def test_shared_without_flag(
+        self, history_setup, capture_exec, auth_status_tracks_seed, refresh_rotates
+    ):
+        source, session_dir, mgr = history_setup
+        with pytest.raises(_ExecCalled) as exc:
+            mgr.run(ACCOUNT_NUM, [])
+
+        assert exc.value.env["CLAUDE_CONFIG_DIR"] == str(session_dir)
+        assert self._linked(session_dir, source)
+
+    def test_setting_off_keeps_history_per_account(
+        self, history_setup, capture_exec, auth_status_tracks_seed, refresh_rotates
+    ):
+        source, session_dir, mgr = history_setup
+        set_setting(mgr.switcher.backup_dir, "session.shareHistory", "false")
+        with pytest.raises(_ExecCalled):
+            mgr.run(ACCOUNT_NUM, [])
+
+        assert not (session_dir / "projects").exists()
+
+    def test_flag_overrides_setting_for_one_launch(
+        self, history_setup, capture_exec, auth_status_tracks_seed, refresh_rotates
+    ):
+        source, session_dir, mgr = history_setup
+        set_setting(mgr.switcher.backup_dir, "session.shareHistory", "false")
+        with pytest.raises(_ExecCalled):
+            mgr.run(ACCOUNT_NUM, [], share_history=True)
+        assert self._linked(session_dir, source)
+
+        with pytest.raises(_ExecCalled):
+            mgr.run(ACCOUNT_NUM, [], share_history=False)
+        assert not (session_dir / "projects").exists()
+
+    def test_fast_path_folds_orphaned_profile_history_in(
+        self, history_setup, capture_exec, monkeypatch
+    ):
+        # The account is the default login, so plain claude runs on ~/.claude.
+        # Sessions it ran while it was NOT the default live in its profile;
+        # they must join the shared history now, not on some later launch.
+        source, session_dir, mgr = history_setup
+        proj = session_dir / "projects" / "-home-user-app"
+        proj.mkdir(parents=True)
+        (proj / "bbb.jsonl").write_text("profile-b\n")
+        monkeypatch.setattr(
+            mgr.switcher, "_get_current_account", lambda: (ACCOUNT_EMAIL, ORG_UUID)
+        )
+
+        with pytest.raises(_ExecCalled) as exc:
+            mgr.run(ACCOUNT_NUM, [])
+
+        assert "CLAUDE_CONFIG_DIR" not in exc.value.env
+        assert (
+            source / "projects" / "-home-user-app" / "bbb.jsonl"
+        ).read_text() == "profile-b\n"
+        assert self._linked(session_dir, source)
+
+    def test_fast_path_without_profile_is_a_plain_launch(
+        self, manager, capture_exec, monkeypatch, temp_home
+    ):
+        monkeypatch.setattr(
+            manager.switcher,
+            "_get_current_account",
+            lambda: (ACCOUNT_EMAIL, ORG_UUID),
+        )
+        with pytest.raises(_ExecCalled):
+            manager.run(ACCOUNT_NUM, [])
+
+        assert not session_dir_for(
+            manager.switcher.backup_dir, ACCOUNT_NUM, ACCOUNT_EMAIL
+        ).exists()
+
