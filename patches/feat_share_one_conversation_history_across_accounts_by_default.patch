+def _stored_share_history(backup_root: Path) -> bool | None:
+    """The share-history choice settings.json makes, or None for none.
+
+    Earlier aswap releases kept it as ``session.shareHistory`` before
+    upstream added ``run.shareHistory``; that key is still honored while the
+    new one is absent, so nobody's choice flips on upgrade.
+    """
+    raw = _read_raw(settings_path(backup_root))
+    for name in ("run", "session"):
+        section = raw.get(name)
+        value = section.get("shareHistory") if isinstance(section, dict) else None
+        if isinstance(value, bool):
+            return value
+    return None
+
+
 def load_run_settings(backup_root: Path) -> RunSettings:
     """Load the run section; missing/corrupt file or non-bool value → default."""
-    section = _read_raw(settings_path(backup_root)).get("run")
-    value = section.get("shareHistory") if isinstance(section, dict) else None
-    if not isinstance(value, bool):
+    value = _stored_share_history(backup_root)
+    if value is None:
         return RunSettings()
     return RunSettings(share_history=value)
 
 
+def share_history_is_set(backup_root: Path) -> bool:
+    """Whether the share-history value is the user's choice, not the default:
+    a platform that cannot share (Windows) warns about the former only."""
+    return _stored_share_history(backup_root) is not None
+
+
 def load_update_settings(backup_root: Path) -> UpdateSettings:
     """Load the updates section; missing/corrupt file or non-boolean → default."""
     raw = _read_raw(settings_path(backup_root))
